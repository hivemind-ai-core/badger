+// ---- TEMPORARY ORACLE INSTRUMENTATION (not for commit) ----
+fn oracle(prog: &Program, round: usize) {
+    use crate::opt::simplify::{oracle_dead, oracle_has, oracle_live_after, oracle_live_out};
+    let ok: Vec<bool> = prog.funcs.indices().map(|id| inlinable(prog, id)).collect();
+    let (mut sites, mut accepted, mut rej, mut rej_rdead, mut flip, mut acc_rdead, mut acc_adead, mut rej_adead) =
+        (0, 0, 0, 0, 0, 0, 0, 0);
+    let (mut all_direct, mut all_rdead, mut all_adead) = (0, 0, 0);
+    let kinds: Vec<FuncKind> = prog.funcs.iter().map(|f| f.kind).collect();
+    for (id, f) in prog.funcs.iter_enumerated() {
+        let out = oracle_live_out(f);
+        let known = known_closures(&kinds, f);
+        for b in 0..f.blocks.len() {
+            let after = oracle_live_after(f, &out[b], b);
+            for (i, s) in f.blocks[b].stmts.iter().enumerate() {
+                let Stmt::Assign(dst, Rvalue::Call { callee: Callee::Direct(t), args, ret }) = s else { continue };
+                if *ret != f.locals[*dst].repr || *t == id {
+                    continue;
+                }
+                all_direct += 1;
+                let rdead = !oracle_has(&after[i], *dst);
+                let adead = args.iter().all(|a| match a {
+                    Operand::Local(l) => !oracle_has(&after[i], *l),
+                    _ => true,
+                });
+                all_rdead += rdead as usize;
+                all_adead += adead as usize;
+                if !ok[t.index()] {
+                    continue;
+                }
+                let c = &prog.funcs[*t];
+                if !fits(f, args, *dst, c) {
+                    continue;
+                }
+                sites += 1;
+                let higher = args.iter().any(|a| matches!(a, Operand::Local(l) if known.contains_key(l)));
+                let limit = if higher { MAX_HIGHER_ORDER } else { MAX_CALLEE };
+                if size(c) <= limit {
+                    accepted += 1;
+                    acc_rdead += rdead as usize;
+                    acc_adead += adead as usize;
+                } else {
+                    rej += 1;
+                    rej_adead += adead as usize;
+                    if rdead {
+                        rej_rdead += 1;
+                        let mut g = clone_func(c);
+                        for blk in g.blocks.iter_mut() {
+                            if let Some(Term::Return(o)) = &mut blk.term {
+                                *o = Operand::Const(Const::Int(0, Repr::I64));
+                            }
+                        }
+                        oracle_dead(&mut g);
+                        if size(&g) <= limit {
+                            flip += 1;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    eprintln!(
+        "[oracle] inline round {round}: direct={all_direct} (result dead {all_rdead}, args dead {all_adead}) candidates={sites} accepted={accepted} (result dead {acc_rdead}, args dead {acc_adead}) rejected={rej} (result dead {rej_rdead}, args dead {rej_adead}) would-flip-if-result-dead-discount={flip}"
+    );
+}
