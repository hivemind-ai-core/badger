+// ---- TEMPORARY ORACLE INSTRUMENTATION (not for commit) ----
+pub(crate) fn oracle_live_out(f: &Func) -> Vec<Vec<u64>> {
+    let n = f.blocks.len();
+    let w = words(f.locals.len());
+    let mut live_in: Vec<Vec<u64>> = vec![vec![0u64; w]; n];
+    let mut live_out: Vec<Vec<u64>> = vec![vec![0u64; w]; n];
+    let mut changed = true;
+    while changed {
+        changed = false;
+        for b in (0..n).rev() {
+            let mut out = vec![0u64; w];
+            if let Some(t) = &f.blocks[b].term {
+                for s in t.successors() {
+                    if s.index() < n {
+                        union_into(&mut out, &live_in[s.index()]);
+                    }
+                }
+            }
+            let mut cur = out.clone();
+            if let Some(l) = term_local(&f.blocks[b].term) {
+                set_bit(&mut cur, l);
+            }
+            for s in f.blocks[b].stmts.iter().rev() {
+                if let Stmt::Assign(l, _) = s {
+                    clear_bit(&mut cur, *l);
+                }
+                for_each_use(s, &mut |l| set_bit(&mut cur, l));
+            }
+            if out != live_out[b] || cur != live_in[b] {
+                live_out[b] = out;
+                live_in[b] = cur;
+                changed = true;
+            }
+        }
+    }
+    live_out
+}
+
+/// For each statement of block `b`, whether each local is live after it.
+pub(crate) fn oracle_live_after(f: &Func, out: &[u64], b: usize) -> Vec<Vec<u64>> {
+    let mut cur = out.to_vec();
+    if let Some(l) = term_local(&f.blocks[b].term) {
+        set_bit(&mut cur, l);
+    }
+    let len = f.blocks[b].stmts.len();
+    let mut after = vec![vec![]; len];
+    for (i, s) in f.blocks[b].stmts.iter().enumerate().rev() {
+        after[i] = cur.clone();
+        if let Stmt::Assign(l, _) = s {
+            clear_bit(&mut cur, *l);
+        }
+        for_each_use(s, &mut |l| set_bit(&mut cur, l));
+    }
+    after
+}
+
+pub(crate) fn oracle_has(bits: &[u64], l: Local) -> bool {
+    has_bit(bits, l)
+}
+
+pub fn oracle_report(prog: &Program, tag: &str) {
+    let mut kinds: std::collections::BTreeMap<String, (usize, usize)> = Default::default();
+    let mut assigns = 0usize;
+    for f in prog.funcs.iter() {
+        let out = oracle_live_out(f);
+        for b in 0..f.blocks.len() {
+            let after = oracle_live_after(f, &out[b], b);
+            for (i, s) in f.blocks[b].stmts.iter().enumerate() {
+                let Stmt::Assign(l, rv) = s else { continue };
+                assigns += 1;
+                if has_bit(&after[i], *l) {
+                    continue;
+                }
+                let k = match rv {
+                    Rvalue::Call { callee: Callee::Runtime(_), .. } => "call-runtime".to_string(),
+                    Rvalue::Call { .. } => "call".to_string(),
+                    Rvalue::Alloc { .. } => "alloc".to_string(),
+                    Rvalue::Concat(_) => "concat".to_string(),
+                    Rvalue::Bin { .. } => "checked-bin".to_string(),
+                    Rvalue::Neg { .. } => "checked-neg".to_string(),
+                    Rvalue::Convert { .. } => "checked-convert".to_string(),
+                    other => format!("removable?{:?}", std::mem::discriminant(other)),
+                };
+                let e = kinds.entry(k).or_default();
+                e.0 += 1;
+                if f.locals[*l].name.is_some() {
+                    e.1 += 1;
+                }
+            }
+        }
+    }
+    eprintln!("[oracle] {tag} assigns={assigns}");
+    for (k, (n, named)) in kinds {
+        eprintln!("[oracle] {tag} dead-kept {k}: {n} (named binding: {named})");
+    }
+}
+
+pub(crate) fn oracle_dead(f: &mut Func) -> usize {
+    dead_assignments(f)
+}
