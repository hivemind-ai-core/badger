// The HTTP binding of the service: its routes. The route system reads the
// status from the error, so the service's own errors answer with the
// status the service means (`@http.status` in `service`).
import std.app
import std.route
import service

/// The service's errors, as the HTTP layer sees them: each answers with
/// the status of the error it wraps.
@derive(Error, From, HttpError)
pub enum Error {
    service(source: service.Error),
    route(source: route.RouteError),
}

/// The service's routes.
pub fn routes(notes: service.Operations) -> List<route.Route> {
    [
        route.json(#post, "/notes", #notes/create, fn(_request, _params, body: service.NewNote) -> Result<(Int, service.Note), Error> {
            match notes.create.call(app.call(), body) {
                .ok(note) => ok((201, note)),
                .err(e) => err(Error.service(e)),
            }
        }),
        route.json_get("/notes", #notes/list, fn(_request, _params) -> Result<(Int, List<service.Note>), Error> {
            match notes.list.call(app.call(), {}) {
                .ok(all) => ok((200, all)),
                .err(e) => err(Error.service(e)),
            }
        }),
        route.typed(#post, "/notes/:id/done", #notes/complete, fn(_request, params: { id: Int }, _body: {}) -> Result<(Int, service.Note), Error> {
            match notes.complete.call(app.call(), params.id) {
                .ok(note) => ok((200, note)),
                .err(e) => err(Error.service(e)),
            }
        }),
    ]
}
