// The store: what a record is, what can go wrong, and the interface the
// service needs from storage. Another adapter (SQLite, Postgres) would
// provide the same interface; the service does not know which it has.
import std.list

/// One record.
pub type Task = { id: Int, title: String, done: Bool }

/// What can go wrong.
pub enum Error {
    invalid(message: String),
    not_found(id: Int),
} derive(Error)

/// What the service needs from storage.
pub type Store = {
    insert: fn(String) -> Result<Task, Error> !{Io, Wait, State},
    all: fn() -> Result<List<Task>, Error> !{Io, Wait, State},
    complete: fn(Int) -> Result<Option<Task>, Error> !{Io, Wait, State},
}

/// An in-memory store (tests and development).
pub provider memory(config: {}) -> Result<Store, Error> {
    let rows: Atom<List<Task>> = Atom.new([])
    ok({
        insert: fn(title: String) -> Result<Task, Error> {
            let all = rows.update(fn(current) {
                current.append({ id: current.len() + 1, title, done: false })
            })
            ok(all[all.len() - 1])
        },
        all: fn() -> Result<List<Task>, Error> { ok(rows.get()) },
        complete: fn(id: Int) -> Result<Option<Task>, Error> {
            let all = rows.update(fn(current) {
                list.map(current, fn(t) { if t.id == id { { ..t, done: true } } else { t } })
            })
            ok(list.find(all, fn(t) { t.id == id }))
        },
    })
}
