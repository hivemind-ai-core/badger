// The HTTP binding of the service: each operation bound to a method and
// a path.
import stdx.app
import stdx.route
import service
import store

/// The service's errors, as the HTTP layer sees them: each answers with
/// the status of the error it wraps.
@derive(Error, From, HttpError)
pub enum Error {
    store(source: store.Error),
    route(source: route.RouteError),
}

/// The service's routes.
pub fn routes(tasks: service.Operations) -> List<route.Route> {
    [
        route.json(#post, "/tasks", #tasks/create, fn(_request, _params, body: { title: String }) -> Result<(Int, store.Task), Error> {
            match tasks.create.call(app.call(), body) {
                .ok(task) => ok((201, task)),
                .err(e) => err(Error.store(e)),
            }
        }),
        route.json_get("/tasks", #tasks/list, fn(_request, _params) -> Result<(Int, List<store.Task>), Error> {
            match tasks.list.call(app.call(), {}) {
                .ok(all) => ok((200, all)),
                .err(e) => err(Error.store(e)),
            }
        }),
        route.typed(#post, "/tasks/:id/done", #tasks/complete, fn(_request, params: { id: Int }, _body: {}) -> Result<(Int, store.Task), Error> {
            match tasks.complete.call(app.call(), params.id) {
                .ok(task) => ok((200, task)),
                .err(e) => err(Error.store(e)),
            }
        }),
    ]
}
