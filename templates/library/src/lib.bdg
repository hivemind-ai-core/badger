// @name@: a library package.
//
// A library has no `main`: it is used by other packages, which import it
// and call its functions. `badger test` runs the `test_*` functions here.
import std.text

/// A thing the library keeps track of.
pub type Item = { id: Int, name: String }

/// The greeting the library offers.
pub fn greeting(name: String) -> String {
    $"Hello, {name}!"
}

/// A new item, with the next free identifier.
pub fn item(name: String) -> Item {
    { id: 1, name: text.trim(name) }
}

/// The item's name, normalized (trimmed).
pub fn label(item: Item) -> String {
    text.trim(item.name)
}

/// The item's name, or a default when it is empty.
pub fn name_or(item: Item, fallback: String) -> String {
    let name = label(item)
    if name == "" { fallback } else { name }
}

fn test_the_greeting() -> Unit {
    assert(greeting("you") == "Hello, you!")
}

fn test_the_items() -> Unit {
    let i = item("  a name  ")
    assert(i.id == 1)
    assert(label(i) == "a name")
    assert(name_or(i, "none") == "a name")
    assert(name_or({ id: 2, name: "  " }, "none") == "none")
}
