// `badger contracts --tests`: tests exercise some clauses and not others,
// and observed values suggest clauses not yet stated.
import std.test

requires qty > 0, "add a positive quantity"
ensures result >= stock
fn restock(stock: Int, qty: Int) -> Int { stock + qty }

requires qty <= stock, "cannot take more than is in stock"
fn take(stock: Int, qty: Int) -> Int { stock - qty }

ensures result >= 0
fn shortfall(want: Int, have: Int) -> Int { if want > have { want - have } else { 0 } }

/// Never tested: its clause is a gap.
requires days > 0
fn reorder_after(days: Int) -> Int { days * 2 }

fn test_restock() {
    test.assert_eq(restock(5, 3), 8)
    test.assert_eq(restock(0, 10), 10)
    test.assert_eq(restock(7, 1), 8)
}

fn test_take() {
    test.assert_eq(take(10, 4), 6)
    test.assert_eq(take(3, 3), 0)
    test.assert_eq(take(9, 2), 7)
}

fn test_shortfall() {
    test.assert_eq(shortfall(5, 2), 3)
    test.assert_eq(shortfall(1, 4), 0)
    test.assert_eq(shortfall(8, 8), 0)
}

pub fn main() -> Unit {}
