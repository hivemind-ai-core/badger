// expect-error: E0405
// A borrow chosen by an if keeps both candidates borrowed.
import std.io
import std.buffer
fn flag() -> Bool { true }
pub fn main() -> Result<Unit, io.Error> {
    var b = buffer.new<Int>()
    var c = buffer.new<Int>()
    let m = if flag() { &mut c } else { &mut b }
    let a = buffer.freeze(c)
    io.println(a.len())?
    m.push(1)
    io.println(a.len())?
    ok(())
}
