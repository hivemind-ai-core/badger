// expect-error: E0402
// Cell-capturing closures in a list reach a task through the callee.
import std.io
import std.task
fn run_in_task(gs: List<fn() -> Int>) -> Int {
    let x: Result<Int, String> = task.scope(fn(s) {
        var total = 0
        for g in gs { let t = s.spawn(fn() { g() }); total = total + t.join() }
        ok(total)
    })
    x.unwrap_or(0)
}
pub fn main() -> Result<Unit, io.Error> {
    let c = Cell.new(0)
    let f = fn() -> Int { c.set(c.get() + 1); c.get() }
    let n = run_in_task([f, f])
    io.println($"RAN {n} {c.get()}")
}
