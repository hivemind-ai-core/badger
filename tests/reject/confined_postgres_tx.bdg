// A PostgreSQL transaction is confined to its task, like a SQLite one.
// expect-error: E0402
import std.io
import stdx.postgres
import std.task

fn work<S: Scope>(tx: postgres.Tx<S>) -> Result<Int, postgres.Error> {
    use scope <- task.scope()
    let t = scope.spawn(fn() { tx })
    let _ = t.join()
    ok(1)
}

pub fn main() -> Result<Unit, postgres.Error> {
    ok(())
}
