// S01: a missing system reference is rejected before initialization.
// expect-error: E0601
import std.sqlite
import std.system
import std.system.{component}

pub fn main() -> Unit {
    let _ = system {
        database: component(sqlite.pool, { path: ":memory:" }),
        api: component(sqlite.pool, { path: ref(#databse) }),
    }
}
