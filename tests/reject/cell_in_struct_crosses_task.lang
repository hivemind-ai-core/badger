// expect-error: E0402
// A cell inside a struct or enum payload confines its holder.
import std.task
import std.io
struct Holder { c: Cell<Int> }
enum Wrap { w(h: Holder) }
pub fn main() -> Result<Unit, String> {
    use scope <- task.scope()
    let h: Holder = { c: Cell.new(0) }
    let w = Wrap.w(h)
    let child = scope.spawn(fn() { match w { .w(x) => x.c.set(3) }; ok(()) })
    let r: Result<Unit, String> = child.join()
    let _ = io.println(h.c.get())
    r
}
