// expect-error: E0001
// A control-flow body is a block: a bare statement is not a body. Each of
// these is written with braces, as `if x { return }`.
pub fn main() -> Unit {
    let x = 1
    if x return
    if x { } else return
    while x do_it()
    for i in y do_it()
    loop do_it()
    unsafe do_it()
}
