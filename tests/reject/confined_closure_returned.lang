// expect-error: E0501
// A closure capturing a Cell cannot be returned as a declared fn type.
import std.io
import std.task
fn make_counter() -> fn() -> Int {
    let c = Cell.new(0)
    fn() -> Int { c.set(c.get() + 1); c.get() }
}
pub fn main() -> Result<Unit, io.Error> {
    let bump = make_counter()
    let r: Result<Int, io.Error> = task.scope(fn(s) {
        let t = s.spawn(fn() { bump() })
        let u = s.spawn(fn() { bump() })
        ok(t.join() + u.join())
    })
    io.println($"{r?} {bump()}")
}
