// expect-error: E0401
// A transaction stored through an alias escapes its callback.
import std.io
import std.sqlite
@derive(Error, From)
pub enum AppError { sql(source: sqlite.Error), io(source: io.Error) }
fn keep<S: Scope>(a: Cell<List<fn() -> Int>>, tx: sqlite.Tx<S>) -> Unit {
    let t = tx
    a.set([fn() { match sqlite.execute(t, "SELECT 1", []) { .ok(n) => 1, .err(e) => -1 } }])
}
pub fn main() -> Result<Unit, AppError> {
    let pool = sqlite.open(":memory:")?
    let e: List<fn() -> Int> = []
    let stash = Cell.new(e)
    let _ = sqlite.transaction(pool, fn(tx) -> Result<Unit, AppError> {
        keep(stash, tx)
        ok(())
    })
    for f in stash.get() { let _ = io.println($"after tx: {f()}") }
    ok(())
}
