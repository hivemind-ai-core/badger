// expect-error: E0404
// A consuming closure stays single-use through a generic identity.
import std.io
import std.list
fn id<T>(x: T) -> T { x }
pub fn main() -> Result<Unit, io.Error> {
    let b = list.builder<Int>()
    b.append(1)
    let f = id(fn() { let l = b.finish(); l.len() })
    io.println(f())?
    io.println(f())?
    ok(())
}
