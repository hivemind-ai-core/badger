// expect-error: E0404
// Generic duplication of an affine value through a local closure, a generic method, or a blanket impl.
import std.io
import std.buffer
import std.list
struct W<T> { v: T }
impl<T> W<T> { fn twice(self: Self) -> (T, T) { (self.v, self.v) } }
pub fn main() -> Result<Unit, io.Error> {
    let b: Buffer<Int> = buffer.new()
    let w: W<Buffer<Int>> = { v: b }
    let r = w.twice()
    let (p, q) = r
    p.push(1)
    let a = buffer.freeze(p)
    io.println(a.len())?
    q.push(2)
    io.println(a.len())?
    ok(())
}
