// expect-error: E0501
// Display through interpolation charges the implementation's effects.
import std.io
struct S { v: Int }
impl Display for S { fn display(self: &Self) -> String { let _ = io.println("EFFECT display"); "s" } }
fn pure_direct(s: &S) -> String !{} { $"{s}" }
pub fn main() -> Result<Unit, io.Error> { let s: S = { v: 1 }; io.println(pure_direct(&s))?; ok(()) }
