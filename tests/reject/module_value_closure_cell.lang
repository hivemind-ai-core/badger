// expect-error: E0138
// A module value cannot hide a Cell inside a closure.
// A module-level closure that captures a Cell: module-level mutable state reachable from several tasks
import std.io
import std.task
let bump = { let c = Cell.new(0); fn() -> Int { c.set(c.get() + 1); c.get() } }
pub fn main() -> Result<Unit, io.Error> {
    let r: Result<Int, io.Error> = task.scope(fn(s) {
        let t = s.spawn(fn() { bump() })
        let u = s.spawn(fn() { bump() })
        ok(t.join() + u.join())
    })
    io.println(r?)?
    io.println(bump())?
    ok(())
}
