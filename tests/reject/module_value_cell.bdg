// expect-error: E0138
// Module-level values may not hold a Cell (shared mutable state across tasks).
import std.io
import std.task

let counter = Cell.new(0)

fn bump() -> Int { counter.set(counter.get() + 1); counter.get() }

pub fn main() -> Result<Unit, io.Error> {
    let r: Result<Int, io.Error> = task.scope(fn(s) {
        let t = s.spawn(fn() { bump() })
        let u = s.spawn(fn() { bump() })
        ok(t.join() + u.join())
    })
    io.println($"{counter.get()}")?
    ok(())
}
