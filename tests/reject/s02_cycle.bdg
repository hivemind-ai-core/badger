// S02: a literal dependency cycle is rejected with its path.
// expect-error: E0604
import std.sqlite
import std.system
import std.system.{component}

pub fn main() -> Unit {
    let _ = system {
        a: component(sqlite.pool, { path: ref(:b) }),
        b: component(sqlite.pool, { path: ref(:a) }),
    }
}
