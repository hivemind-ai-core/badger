// expect-error: E0404
// A builder moved into a task cannot be used by its parent.
import std.io
import std.task
import std.list
pub fn main() -> Result<Unit, String> {
    use s <- task.scope()
    let lb = list.builder<Int>()
    let t = s.spawn(fn() { lb.append(1); 1 })
    lb.append(2)
    let _ = t.join()
    let l = lb.finish()
    let _ = io.println(l)
    ok(())
}
