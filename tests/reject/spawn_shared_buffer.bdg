// expect-error: E0404
// Spawned closures take affine captures by move: two tasks cannot share a buffer.
import std.io
import std.task
import std.buffer
pub fn main() -> Result<Unit, String> {
    use s <- task.scope()
    let b = buffer.new<Int>()
    let t = s.spawn(fn() { b.push(1); b.len() })
    let u = s.spawn(fn() { b.push(1); b.len() })
    let _ = io.println(t.join() + u.join())
    ok(())
}
