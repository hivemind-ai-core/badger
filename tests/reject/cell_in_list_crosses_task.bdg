// expect-error: E0402
// A list of cells cannot cross a task boundary.
import std.task
import std.io
pub fn main() -> Result<Unit, String> {
    use scope <- task.scope()
    let c = Cell.new(0)
    let l = [c]
    let child = scope.spawn(fn() { l[0].set(41); ok(()) })
    let r: Result<Unit, String> = child.join()
    let _ = io.println(c.get())
    r
}
