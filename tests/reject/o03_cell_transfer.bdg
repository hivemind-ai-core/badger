// O03: a record containing Cell<T> sent to another task is rejected.
// expect-error: E0402
import std.task

pub fn main() -> Result<Unit, String> {
    use scope <- task.scope()
    let state = { counter: Cell.new(0), name: "x" }
    let child = scope.spawn(fn() {
        state.counter.set(1)
        ok(())
    })
    let r: Result<Unit, String> = child.join()
    r
}
