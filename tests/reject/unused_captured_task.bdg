// expect-error: E0337
// A captured task whose Result is never inspected is diagnosed.
import std.io
import std.task
import std.list
pub fn main() -> Result<Unit, String> {
    task.scope(fn(s) -> Result<Unit, String> {
        let t = s.capture(fn() -> Result<Int, String> { err("lost") })
        ok(())
    })
}
