// expect-error: E0138
// A module value cannot hide an Atom behind a dyn returned by a function.
import std.io
protocol B { fn b(self: &Self) -> Int }
struct St { c: Atom<Int> }
impl B for St { fn b(self: &Self) -> Int { self.c.set(self.c.get() + 1); self.c.get() } }
fn mk() -> dyn B { let s: St = { c: Atom.new(0) }; s }
let w = mk()
pub fn main() -> Result<Unit, io.Error> {
    let _ = w.b()
    io.println(w.b())
}
