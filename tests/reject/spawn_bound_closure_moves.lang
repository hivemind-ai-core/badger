// expect-error: E0404
// A closure bound before spawning moves its affine captures.
import std.task
import std.buffer
pub fn main() -> Result<Unit, String> {
    use s <- task.scope()
    let b = buffer.new<Int>()
    let f = fn() { b.push(1); 1 }
    let t = s.spawn(f)
    b.push(2)
    let _ = t.join()
    ok(())
}
