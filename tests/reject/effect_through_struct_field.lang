// expect-error: E0501
// A function stored without an effect annotation may perform any effect.
import std.io
struct S { cb: fn() -> Unit }
fn run(s: S) -> Unit { (s.cb)() }
fn g() -> Unit !{} { let s: S = { cb: fn() { let _ = io.println("leaked via struct") } }; run(s) }
pub fn main() -> Result<Unit, io.Error> { g(); ok(()) }
