// expect-error: E0414
// A closure capturing a region's record cannot leave the block.
struct Node<R: Scope> { value: Int }
fn make<R: Scope>(value: Int) -> Node<R> { { value } }
pub fn main() -> Unit {
    let _ = region Local {
        let n: Node<Local> = make(1)
        fn() { n.value }
    }
}
