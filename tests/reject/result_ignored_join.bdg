// expect-error: E0337
// An ignored Result: result_ignored_join.
import std.io
import std.task
import std.list
fn f() -> Result<Int, String> { err("lost") }
pub fn main() -> Result<Unit, String> {
    task.scope(fn(s) -> Result<Unit, String> {
        let t = s.capture(fn() { f() })
        let x = t.join()
        ok(())
    })
}
