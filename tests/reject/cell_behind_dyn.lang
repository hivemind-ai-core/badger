// expect-error: E0402
// A dyn value may cross tasks: confined state cannot hide in one.
import std.task
import std.io
struct Holder { c: Cell<Int> }
protocol Ping { fn ping(self: &Self) -> Unit }
impl Ping for Holder { fn ping(self: &Self) -> Unit { self.c.set(2) } }
pub fn main() -> Result<Unit, String> {
    use scope <- task.scope()
    let c = Cell.new(0)
    let h: Holder = { c: c }
    let d: dyn Ping = h
    let child = scope.spawn(fn() { d.ping(); ok(()) })
    let r: Result<Unit, String> = child.join()
    let _ = io.println(c.get())
    r
}
