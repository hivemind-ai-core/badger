// expect-error: E0411
// A provider error must not carry a resource from the closing scope.
import std.sqlite
import std.system
pub struct Leaky { pub pool: sqlite.Pool<Unit> }
impl Display for Leaky { fn display(self: &Self) -> String { "leaky" } }
impl Error for Leaky {}
fn bad_init(scope: system.InitScope, c: { path: String }) -> Result<Int, Leaky> {
    match scope.acquire(sqlite.pool, c) {
        .ok(p) => err({ pool: p }),
        .err(_) => ok(0),
    }
}
let bad = system.provider({ name: #t/bad, init: bad_init })
pub fn main() {}
