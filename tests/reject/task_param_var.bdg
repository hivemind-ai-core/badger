// expect-error: E0402
// A var assigned from a parameter still reaches the task.
import std.io
import std.task
import std.list
fn run_in_task(gs: (fn() -> Int, Int)) -> Int {
    let x: Result<Int, String> = task.scope(fn(s) {
        var g = fn() { 0 }
        g = gs.0
        let t = s.spawn(fn() { g() })
        ok(t.join())
    })
    x.unwrap_or(0)
}
pub fn main() -> Result<Unit, io.Error> {
    let c = Cell.new(0)
    let f = fn() -> Int { c.set(c.get() + 1); c.get() }
    let n = run_in_task((f, 1))
    io.println($"RAN {n} {c.get()}")
}
