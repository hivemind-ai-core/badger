// expect-error: E0402
// A borrow stays on its owner's task: two tasks holding one `&mut` (or a
// task reading while the owner writes) would race.
import std.buffer
import std.io
import std.task

pub fn main() -> Result<Unit, io.Error> {
    let b = buffer.new<Int>()
    let m = &mut b
    use scope <- task.scope()
    let h = scope.spawn(fn() {
        m.push(1)
        0
    })
    ok(())
}
