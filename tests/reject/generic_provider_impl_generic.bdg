// expect-error: E0606
// An impl-level generic reaching a node output must be concrete at each call.
import std.io
import std.channel
import std.task
import std.system
import std.system.{component}
pub struct F { pub m: String }
impl Display for F { fn display(self: &Self) -> String { self.m } }
impl Error for F {}
fn say(s: String) -> Unit { let _ = io.println(s) }
pub enum AppError { sys(source: system.Error), cfg(source: channel.ConfigError), io(source: io.Error) } derive(Error, From)
fn nonep<T>() -> system.Provider<{ x: Int }, Option<T>, F> { system.provider({ name: #t/g, init: fn(scope, c) -> Result<Option<T>, F> { ok(none) } }) }
fn run_decl<T>(p: system.Provider<{ x: Int }, Option<T>, F>) -> Result<Unit, AppError> {
    let plan = system { a: component(p, { x: 1 }) }
    system.run(plan, fn(r) -> Result<Unit, AppError> { say($"decl, empty: {r.a.is_none()}"); ok(()) })
}
fn run_with(p) -> Result<Unit, AppError> {
    let plan = system { a: component(p, { x: 1 }) }
    system.run(plan, fn(r) -> Result<Unit, AppError> { say($"started, empty: {r.a.is_none()}"); ok(()) })
}
fn empty<T>() -> system.Provider<{ x: Int }, List<T>, F> { system.provider({ name: #t/g, init: fn(scope, c) -> Result<List<T>, F> { ok([]) } }) }
pub struct Holder<T> { pub n: Int }
fn mkh<T>() -> Holder<T> { { n: 1 } }
impl<T> Holder<T> {
    pub fn go(self: &Self) -> Result<Unit, AppError> {
        let p: system.Provider<{ x: Int }, List<T>, F> = empty()
        let plan = system { a: component(p, { x: 1 }) }
        system.run(plan, fn(r) -> Result<Unit, AppError> { say($"len {r.a.len()}"); ok(()) })
    }
}
pub fn main() -> Result<Unit, AppError> { mkh().go() }
