// expect-error: E0607
// Plan keys cannot collide with the running system's own fields.
import std.system
import std.system.{component}
pub struct F { pub m: String }
impl Display for F { fn display(self: &Self) -> String { self.m } }
impl Error for F {}
let p = system.provider({ name: :t/p, init: fn(scope, c: { v: Int }) -> Result<Int, F> { ok(c.v) } })
pub fn main() -> Unit {
    let plan = system { started: component(p, { v: 1 }) }
}
