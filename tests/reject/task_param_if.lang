// expect-error: E0402
// A closure chosen by an if from a parameter still reaches the task.
import std.io
import std.task
import std.list
fn run_in_task(gs: List<fn() -> Int>) -> Int {
    let x: Result<Int, String> = task.scope(fn(s) {
        let g = if gs.len() > 0 { gs[0] } else { fn() { 0 } }
        let t = s.spawn(fn() { g() })
        ok(t.join())
    })
    x.unwrap_or(0)
}
pub fn main() -> Result<Unit, io.Error> {
    let c = Cell.new(0)
    let f = fn() -> Int { c.set(c.get() + 1); c.get() }
    let n = run_in_task([f])
    io.println($"RAN {n} {c.get()}")
}
