// O04: a closure containing a transaction returned from its scope is rejected.
// expect-error: E0401
import stdx.sqlite

fn leak(pool: sqlite.Pool) -> Result<fn() -> Int, sqlite.Error> {
    use tx <- sqlite.transaction(pool)
    ok(fn() {
        let _ = sqlite.execute(tx, "SELECT 1", [])
        1
    })
}

pub fn main() -> Unit {}
