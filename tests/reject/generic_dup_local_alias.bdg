// expect-error: E0404
// Duplication through a local alias of a generic function.
import std.io
import std.buffer
fn dup<T>(x: T) -> (T, T) { (x, x) }
pub fn main() -> Result<Unit, io.Error> {
    let b: Buffer<Int> = buffer.new()
    let (p, q) = { let d = dup; d(b) }
    p.push(1)
    let a = buffer.freeze(p)
    q.push(2)
    io.println(a.len())?
    ok(())
}
