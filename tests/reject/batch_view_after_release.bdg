// expect-error: E0405
// A batch's items view borrows the batch: releasing it while the view is used is rejected.
import std.io
import std.channel
@derive(Error, From)
pub enum AppError { cfg(source: channel.ConfigError), io(source: io.Error) }
pub fn main() -> Result<Unit, AppError> {
    let b = channel.batch<Int>(channel.batch_defaults)?
    let _ = b.sender.append(5)
    match b.receiver.recv_batch() {
        .some(x) => { let s = x.items(); x.release(); for v in s { let _ = io.println($"{v}") } },
        .none => (),
    }
    ok(())
}
