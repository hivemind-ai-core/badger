// expect-error: E0404
// A closure a helper hands to a task moves its affine captures.
import std.task
import std.buffer
fn run_child<S>(s: &task.TaskScope<S>, f: fn() -> Int) -> task.Task<S, Int> { s.spawn(f) }
pub fn main() -> Result<Unit, String> {
    use s <- task.scope()
    let b = buffer.new<Int>()
    let t = run_child(&s, fn() { b.push(1); 1 })
    b.push(2)
    let _ = t.join()
    ok(())
}
