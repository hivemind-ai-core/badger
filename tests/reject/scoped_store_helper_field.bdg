// expect-error: E0401
// A helper storing into a field of a record argument.
import std.io
import std.task
import std.list
fn keep(r: { c: Cell<List<fn() -> Unit>> }, f: fn() -> Unit) -> Unit { r.c.set([f]) }
pub fn main() -> Result<Unit, io.Error> {
    let e: List<fn() -> Unit> = []
    let stash = Cell.new(e)
    let r: Result<Unit, io.Error> = task.scope(fn(s) {
        keep({ c: stash }, fn() { let t = s.spawn(fn() { let _ = io.println("ORPHAN") }); t.join() })
        ok(())
    })
    r?
    for f in stash.get() { f() }
    task.sleep(20ms)
    io.println("end")
}
