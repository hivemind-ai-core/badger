// expect-error: E0401
// A scoped component stored into an outer Cell escapes its callback.
import std.io
import std.system
import std.system.{component}
pub struct F { pub m: String }
impl Display for F { fn display(self: &Self) -> String { self.m } }
impl Error for F {}
let p = system.provider({ name: #t/p, init: fn(scope, c: { x: Int }) -> Result<fn() -> Int, F> { scope.on_halt(fn() -> Result<Unit, F> { let _ = io.println("halted a"); ok(()) }); ok(fn() { c.x }) } })
pub fn main() -> Result<Unit, system.Error> {
    let plan = system { a: component(p, { x: 7 }) }
    let cell: Cell<Option<fn() -> Int>> = Cell.new(Option.none)
    system.run(plan, fn(r) -> Result<Unit, system.Error> { cell.set(Option.some(r.a)); ok(()) })?
    match cell.get() { .some(f) => { let _ = io.println($"called escaped component after halt: {f()}") }, .none => () }
    ok(())
}
