import std.io
import std.buffer
fn consume(value: { child: { child: { child: { child: { child: { child: { child: { child: { child: { child: Buffer<Int> } } } } } } } } } }) -> Unit { let _ = buffer.freeze(value.child.child.child.child.child.child.child.child.child.child) }
pub fn main() -> Result<Unit, io.Error> {
    let b = buffer.new<Int>()
    let wrapped = { child: { child: { child: { child: { child: { child: { child: { child: { child: { child: b } } } } } } } } } }
    consume(wrapped)
    consume(wrapped)
    ok(())
}
