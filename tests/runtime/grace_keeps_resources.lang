// Run with LANG_CLEANUP_GRACE_MS=200 (crates/lang_cli/tests/programs.rs): the
// worker outlives the grace period, so its node's resources are not freed.
import std.io
import std.task
import std.system
import std.system.{component}
pub struct Failure { pub message: String }
impl Display for Failure { fn display(self: &Self) -> String { self.message } }
impl Error for Failure {}
fn say(s: String) -> Unit { let _ = io.println(s) }
pub enum AppError { system(source: system.Error) } derive(Error, From)
import std.worker
let res = system.provider({ name: :t/res, init: fn(scope, c: { x: Int }) -> Result<Int, Failure> {
    let alive = Atom.new(1)
    scope.on_halt(fn() -> Result<Unit, Failure> { alive.set(0); say("resource freed"); ok(()) })
    scope.worker(fn() -> Result<Unit, Failure> {
        let _ = task.scope(fn(s) -> Result<Unit, Failure> {
            s.defer(fn() { say("worker cleanup starts (slow)"); task.sleep(2s); say($"worker cleanup uses resource alive={alive.get()}") })
            task.sleep(60s)
            ok(())
        })
        ok(())
    }, worker.never())
    ok(1)
} })
pub fn main() -> Unit {
    let plan = system { r: component(res, { x: 1 }) }
    let out = task.scope(fn(s) -> Result<Unit, String> {
        let t = s.capture(fn() { system.run(plan, fn(r) -> Result<Unit, AppError> { task.sleep(20ms); say("body done"); ok(()) }) })
        match t.join() { .failed(i) => say($"failed: {i.message}"), .returned(r) => say($"returned ok={r.is_ok()}"), .cancelled(_) => say("cancelled") }
        ok(())
    })
    let _ = out
    task.sleep(2500ms)
    say("end")
}
