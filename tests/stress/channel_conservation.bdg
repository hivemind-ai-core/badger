// Stress: producers and consumers on bounded, small, and rendezvous
// channels. Every value sent is received exactly once, and closing ends
// every consumer.
import std.channel
import std.io
import std.list
import std.set
import std.task

pub enum AppError {
    config(source: channel.ConfigError),
    send(source: channel.SendError<Int>),
    io(source: io.Error),
    broken(message: String),
} derive(Error, From)

fn run(capacity: Int, producers: Int, consumers: Int, per: Int) -> Result<Unit, AppError> {
    let ends = channel.create<Int>({ ..channel.defaults, capacity: capacity })?
    let got: List<List<Int>> = task.scope(fn(s) -> Result<List<List<Int>>, AppError> {
        let ps = (0..producers).map(fn(p: Int) {
            s.spawn(fn() -> Result<Unit, AppError> {
                for i in 0..per { ends.sender.send(p * per + i)? }
                ok(())
            })
        }).collect()
        let cs = (0..consumers).map(fn(c: Int) {
            s.spawn(fn() -> List<Int> {
                var mine: List<Int> = []
                loop {
                    match ends.receiver.recv() {
                        .some(v) => { mine = mine.append(v) },
                        .none => { break },
                    }
                }
                mine
            })
        }).collect()
        s.try_all(ps)?
        ends.sender.close()
        ok(cs.map(fn(t) { t.join() }))
    })?
    let all = got.fold([], fn(acc: List<Int>, xs: List<Int>) { acc.concat(xs) })
    let distinct = set.from_list(all)
    let want = producers * per
    if all.len() != want || distinct.len() != want {
        return err(AppError.broken($"capacity {capacity}: received {all.len()} ({distinct.len()} distinct), sent {want}"))
    }
    ok(())
}

pub fn main() -> Result<Unit, AppError> {
    for round in 0..3 {
        run(0, 4, 3, 200)?
        run(1, 3, 4, 300)?
        run(16, 6, 2, 500)?
        run(1024, 2, 6, 1000)?
        let _ = round
    }
    io.println("channel conservation ok")?
    ok(())
}
