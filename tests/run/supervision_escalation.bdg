// A worker exceeding its restart budget escalates to its owning scope: the
// running system fails, its nodes halt, and the failure reaches `main`.
import std.io
import std.system
import std.system.{component}
import std.task
import std.worker

pub struct Boom {
    pub message: String,
}

impl Display for Boom {
    fn display(self: &Self) -> String { self.message }
}

impl Error for Boom {}

let always_failing = system.provider({
    name: #test/failing,
    init: fn(scope, _cfg) -> Result<Unit, Boom> {
        scope.on_halt(fn() -> Result<Unit, Boom> {
            let _ = io.println("node halted")
            ok(())
        })
        scope.worker_with(#test/bad, fn() -> Result<Unit, Boom> {
            err({ message: "always fails" })
        }, worker.on_failure({ max_restarts: 2, window: 10s, backoff: 1ms }), worker.cancel())
        ok(())
    },
})

@derive(Error, From)
pub enum AppError {
    system(source: system.Error),
}

pub fn main() -> Result<Unit, AppError> {
    let plan = system {
        failing: component(always_failing, {}),
    }
    use running <- system.run(plan)
    running.wait_for_shutdown()?
    ok(())
}
