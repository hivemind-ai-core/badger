get /items -> (200, "[{\"id\":1,\"name\":\"a\"}]")
get /items/1 -> (200, "{\"id\":1,\"name\":\"a\"}")
get /items/7 -> (404, "{\"error\":\"missing\",\"message\":\"missing: 7\"}")
get /items/x -> (400, "{\"error\":\"route/invalid_path\",\"message\":\"expected an integer\",\"path\":\"$.id\"}")
post /items -> (201, "{\"id\":2,\"name\":\"b\"}")
post /items -> (400, "{\"error\":\"invalid\",\"message\":\"invalid: empty name\"}")
post /items -> (400, "{\"error\":\"route/invalid_body\",\"message\":\"expected an object\",\"path\":\"$\"}")
put /items/3 -> (200, "{\"id\":3,\"name\":\"c\"}")
delete /items/4 -> (200, "{\"deleted\":4}")
get /search?q=badger -> (200, "{\"limit\":10,\"q\":\"badger\"}")
get /search?q=x&limit=2 -> (200, "{\"limit\":2,\"q\":\"x\"}")
get /search -> (400, "{\"error\":\"route/invalid_path\",\"message\":\"missing required field\",\"path\":\"$.q\"}")
