// `@display("...")` on a variant is its derived display (the error
// message): `{field}` interpolates a field, `{{`/`}}` are braces; variants
// without one keep `variant: payload`. Client error replies carry it.
import stdx.http
import std.io

@derive(Error, HttpError, From)
pub enum AppError {
    @http.status(404) @display("no book {id}")
    not_found(id: Int),
    @http.status(409) @display("a book called {title} by {author} exists")
    duplicate(title: String, author: String),
    @http.status(400) @display("nothing to do {{yet}}")
    empty,
    @http.status(400)
    invalid(message: String),
    io(source: io.Error),
}

@derive(Display)
enum Shape {
    @display("a circle of radius {0}")
    circle(Float),
    square(side: Int),
}

pub fn main() -> Result<Unit, AppError> {
    io.println(AppError.not_found(7).display())?
    io.println($"{AppError.duplicate("Dune", "Herbert")}")?
    io.println($"{AppError.empty}")?
    io.println($"{AppError.invalid("bad")}")?
    io.println($"{Shape.circle(1.5)} {Shape.square(2)}")?
    io.println($"{[AppError.not_found(1)]}")?
    let reply = http.error_reply(AppError.not_found(3))
    io.println($"{reply.status} {reply.body.to_text().unwrap_or("")}")?
    ok(())
}
