// The lazy-sequence adapters: chain, dedup, distinct, windows, generation.
import std.io
import std.seq
import std.list

pub fn main() -> Result<Unit, io.Error> {
    io.println($"chain {seq.chain(seq.range(0, 3), seq.range(10, 12)).collect()}")?
    io.println($"dedup {seq.range(0, 6).map(fn(x) => x / 2).dedup().collect()}")?
    io.println($"distinct {seq.range(0, 7).map(fn(x) => x % 3).distinct().collect()}")?
    io.println($"interpose {seq.range(0, 3).interpose(-1).collect()}")?
    io.println($"chunk_by {seq.range(0, 6).map(fn(x) => x / 2).chunk_by(fn(x) => x).collect()}")?
    io.println($"windows {seq.range(1, 5).windows(2).collect()}")?
    io.println($"zip_with {seq.range(0, 3).zip_with(seq.range(10, 13), fn(a, b) => a + b).collect()}")?
    io.println($"step_by {seq.range(0, 10).step_by(3).collect()}")?
    let freq = seq.range(0, 6).map(fn(x) => x % 2).frequencies()
    io.println($"frequencies {freq.get_or(0, 0)} {freq.get_or(1, 0)}")?
    let idx = seq.range(0, 4).index_by(fn(x) => x % 2)
    io.println($"index_by {idx.get(0).unwrap_or(-1)} {idx.get(1).unwrap_or(-1)}")?
    io.println($"fold_while {seq.range(0, 10).fold_while(0, fn(acc, x) => if acc > 3 { Option.none } else { Option.some(acc + x) }).unwrap_or(-1)}")?
    io.println($"position {seq.range(0, 10).position(fn(x) => x * x > 20).unwrap_or(-1)}")?
    io.println($"min {seq.range(3, 8).min().unwrap_or(-1)} max {seq.range(3, 8).max().unwrap_or(-1)} product {seq.product(seq.range(1, 5))}")?
    io.println($"repeat {seq.repeat("x", 3).collect()} iterate {seq.iterate(1, fn(x) => x * 2).take(5).collect()}")?
    let n = Cell.new(0)
    seq.range(0, 4).each(fn(x) => n.set(n.get() + x))
    io.println($"each {n.get()}")?
    ok(())
}
