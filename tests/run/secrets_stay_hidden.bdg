// A secret stays hidden wherever settings and fields are listed: a
// `config.Secret` has no fields to show (it encodes as "[redacted]", also
// inside a record), and an override of a setting whose name says it is a
// secret is redacted in its provenance too.
import stdx.config
import std.io
import std.schema

type Settings = { password: String, port: Int }

pub fn main() {
    let s = config.secret("hunter2")
    let _ = io.println($"secret fields: {schema.fields(s).len()}")
    let wrapped = { token: s, user: "ada" }
    for (name, value) in schema.fields(wrapped) {
        let _ = io.println($"{name} = {value}")
    }
    match config.resolve<Settings>("APP_", ["password=hunter2", "port=8080"]) {
        .ok(r) => {
            for x in r.settings {
                let _ = io.println($"{x.key} value={x.value} origin={x.origin}")
            }
        },
        .err(e) => { let _ = io.println($"err {e}") },
    }
}
