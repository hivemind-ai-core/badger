// Closures borrow captures that are used again afterwards, copy captured
// borrows, and move values they consume or that are not used again.
import std.io
import std.buffer

fn size(r: &Buffer<Int>) -> Int {
    let g = fn() { r.len() }
    g()
}

fn mk() -> fn() -> Int {
    let b = buffer.new<Int>()
    b.push(1)
    fn() { b.len() }
}

pub fn main() -> Result<Unit, io.Error> {
    let b = buffer.new<Int>()
    b.push(1)
    let count = fn() { b.len() }
    io.println(count())?
    // the borrow ended at the closure's last use
    b.push(2)
    io.println(size(&b))?
    io.println(mk()())?
    io.println(buffer.freeze(b).len())?
    ok(())
}
