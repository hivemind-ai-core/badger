// Polymorphic recursion of any depth: one fallback instance whose growing
// type argument is `Dynamic` (values carry their own descriptors).
import std.io
fn depth<T>(x: T, n: Int) -> Int { if n == 0 { 0 } else { 1 + depth((x, x), n - 1) } }
fn nest<T>(x: T, n: Int) -> Int { if n == 0 { 0 } else { 1 + nest([x], n - 1) } }
pub fn main() -> Result<Unit, io.Error> {
    io.println($"{depth(1, 3)} {depth(1, 40)} {nest(1, 100)}")
}
