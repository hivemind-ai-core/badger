// A provider may record plain data derived from its configuration in an
// outer Atom with `update`: only the closure's result is stored.
import std.io
import std.list
import std.system
import std.system.{component}

pub struct Never {
    pub message: String,
}

impl Display for Never {
    fn display(self: &Self) -> String { self.message }
}

impl Error for Never {}

pub enum AppError {
    system(source: system.Error),
    io(source: io.Error),
} derive(Error, From)

pub fn main() -> Result<Unit, AppError> {
    let log: Atom<List<String>> = Atom.new([])
    let p = system.provider({
        name: :test/logged,
        init: fn(scope, cfg: { label: String }) -> Result<Int, Never> {
            let _ = log.update(fn(xs: List<String>) -> List<String> { xs.append(cfg.label) })
            let _ = scope
            ok(1)
        },
    })
    let plan = system {
        a: component(p, { label: "a" }),
        b: component(p, { label: "b" }),
    }
    system.run(plan, fn(r) -> Result<Unit, AppError> {
        let _ = r
        ok(())
    })?
    io.println($"{log.get()}")?
    ok(())
}
