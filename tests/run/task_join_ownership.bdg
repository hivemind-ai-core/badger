// A task with a shareable result may be joined again; one with an affine
// result (a buffer) is joined once, and its joiner owns the result.
import std.io
import std.task
import std.buffer
pub fn main() -> Result<Unit, io.Error> {
    let r = task.scope(fn(s) -> Result<Int, io.Error> {
        let t = s.spawn(fn() { 20 })
        let shared = t.join() + t.join()
        let ts = [t, t]
        var again = 0
        for x in ts { again = again + x.join() }
        let u = s.spawn(fn() { let b = buffer.new<Int>(); b.push(1); b })
        let b = u.join()
        b.push(2)
        ok(shared + again + b.len())
    })?
    io.println($"{r}")?
    ok(())
}
