// A panicking halt callback does not stop the remaining cleanup: every
// halt is attempted, and the defect is reported afterwards.
import std.io
import std.system
import std.system.{component}
pub struct F { pub m: String }
impl Display for F { fn display(self: &Self) -> String { self.m } }
impl Error for F {}
pub enum AppError { system(source: system.Error) } derive(Error, From)
fn say(s: String) -> Unit { let _ = io.println(s) }
let p = system.provider({
    name: #t/p,
    init: fn(scope, c: { v: Int }) -> Result<Int, F> {
        scope.on_halt(fn() -> Result<Unit, F> { say("first registered halt still runs"); ok(()) })
        scope.on_halt(fn() -> Result<Unit, F> { panic("halt boom") })
        ok(c.v)
    },
})
pub fn main() -> Result<Unit, AppError> {
    let plan = system { a: component(p, { v: 1 }) }
    system.run(plan, fn(r) -> Result<Unit, AppError> { let _ = r.a
        ok(()) })
}
