// An inferred-generic function may build a system from its provider
// argument: the output is concrete at each instance.
import std.io
import std.channel
import std.task
import std.system
import std.system.{component}
pub struct F { pub m: String }
impl Display for F { fn display(self: &Self) -> String { self.m } }
impl Error for F {}
fn say(s: String) -> Unit { let _ = io.println(s) }
type Counter = { bump: fn() -> Int, closed: fn() -> Bool }
let counter = system.provider({ name: #t/counter, init: fn(scope, c: { start: Int }) -> Result<Counter, F> {
    let n = Atom.new(c.start)
    let open = Atom.new(1)
    scope.on_halt(fn() -> Result<Unit, F> { open.set(0); say("counter halted"); ok(()) })
    ok({ bump: fn() { n.update(fn(x: Int) -> Int { x + 1 }) }, closed: fn() { open.get() == 0 } })
} })
pub enum AppError { sys(source: system.Error), cfg(source: channel.ConfigError), io(source: io.Error) } derive(Error, From)
fn nonep<T>() -> system.Provider<{ x: Int }, Option<T>, F> { system.provider({ name: #t/g, init: fn(scope, c) -> Result<Option<T>, F> { ok(none) } }) }
fn run_with(p) -> Result<Unit, AppError> {
    let plan = system { a: component(p, { x: 1 }) }
    system.run(plan, fn(r) -> Result<Unit, AppError> { say($"started, empty: {r.a.is_none()}"); ok(()) })
}
pub fn main() -> Result<Unit, AppError> { let p: system.Provider<{ x: Int }, Option<Int>, F> = nonep(); run_with(p) }
