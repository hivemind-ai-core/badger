// A halt callback is one-shot (`once fn`): it may consume what it captured.
import std.io
import std.buffer
import std.system
import std.system.{component}
pub struct Failure { pub message: String }
impl Display for Failure { fn display(self: &Self) -> String { self.message } }
impl Error for Failure {}
pub enum AppError { system(source: system.Error), failed(source: Failure) } derive(Error, From)
fn consume(b: Buffer<Int>) -> Int { b.len() }
let p = system.provider({ name: :t/p, init: fn(scope, config: { v: Int }) -> Result<Int, Failure> {
    let b: Buffer<Int> = buffer.new()
    b.push(config.v)
    scope.on_halt(fn() -> Result<Unit, Failure> { let _ = io.println($"halt consumed {consume(b)}"); ok(()) })
    ok(config.v) } })
pub fn main() -> Result<Unit, AppError> {
    let plan = system { a: component(p, { v: 3 }) }
    system.run(plan, fn(running) -> Result<Unit, AppError> { ok(()) })
}
