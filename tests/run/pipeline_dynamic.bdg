// Pipelines are inspectable (stage names in order), runtime-selected stages
// compose through a checked adapter that preserves the context contract,
// and a defect inside the chain leaves a trace of the aborted stages.
import std.io
import std.pipeline
import std.pipeline.{handle}
import std.task

type Ctx = { path: String, hits: Int }

fn counter(name: Symbol) -> pipeline.Stage<Ctx, Ctx, String, String> {
    pipeline.stage({
        name,
        enter: fn(ctx: Ctx) -> Result<pipeline.Enter<Ctx, Ctx, String>, String> {
            pipeline.next({ ..ctx, hits: ctx.hits + 1 })
        },
        leave: fn(ctx: Ctx, reply: String) -> Result<(Ctx, String), String> {
            pipeline.leave(ctx, $"{reply} <{name}>")
        },
    })
}

fn log() {
    pipeline.stage({
        name: #app/log,
        leave: fn(ctx, reply) { pipeline.leave(ctx, $"{reply} [log]") },
    })
}

pub fn main() -> Result<Unit, io.Error> {
    let base = pipeline {
        log(),
        handle(fn(ctx: Ctx) -> Result<String, String> {
            if ctx.path == "/boom" {
                panic("handler defect")
            }
            ok($"{ctx.path} after {ctx.hits} stage(s)")
        }),
    }
    io.println(base.stages)?
    // the selection is a runtime value
    let wanted = [#app/a, #app/b, #app/c]
    let chosen = [counter(#app/a), counter(#app/b), counter(#app/c)]
    let plan = pipeline.with_stages(chosen, base)
    io.println(plan.stages)?
    let run = pipeline.compile(plan)
    io.println(run({ path: "/x", hits: 0 }).unwrap_or("failed"))?
    // a defect aborts the chain; cleanup records the aborted stages
    let r = task.scope(fn(s) -> Result<Bool, io.Error> {
        let t = s.capture(fn() { run({ path: "/boom", hits: 0 }) })
        match t.join() {
            .failed(info) => ok(true),
            _ => ok(false),
        }
    })?
    io.println($"defect contained: {r}, {wanted.len()} stages selected")?
    ok(())
}
