// A directory capability: paths are relative to its tree, and absolute
// paths, `..`, and symlinks pointing out of the tree are refused; `sub`
// narrows it and `reader` makes it read-only.
import std.io
import std.env
import std.fs

fn say(s: String) -> Unit { let _ = io.println(s) }

fn show(r: Result<String, io.Error>) -> String {
    match r {
        .ok(t) => $"ok {t.trim()}",
        .err(e) => $"refused ({e.kind})",
    }
}

/// Only reads: it is given a `ReadDir`.
fn summarize(d: fs.ReadDir) -> String {
    match d.list(".") {
        .ok(names) => $"{names}",
        .err(e) => $"error {e}",
    }
}

pub fn main() -> Result<Unit, io.Error> {
    let d = fs.root("tests/run/fs_capability_data")?
    say($"read {show(d.read_text("a.txt"))}")
    say($"nested {show(d.read_text("sub/b.txt"))}")
    say($"parent {show(d.read_text("../fs_capability.bdg"))}")
    say($"absolute {show(d.read_text("/etc/hostname"))}")
    say($"symlink out {show(d.read_text("escape"))}")
    say($"missing {show(d.read_text("nope.txt"))}")
    let sub = d.sub("sub")?
    say($"sub {show(sub.read_text("b.txt"))} {show(sub.read_text("../a.txt"))}")
    say($"exists {d.exists("a.txt")} {d.exists("../README.md")}")
    say($"reader {summarize(d.reader())}")
    // writing goes through a `Dir` of a scratch tree
    let tmp = fs.root(env.get("TMPDIR").unwrap_or("/tmp"))?
    tmp.write_text("lang-capability-test.txt", "written")?
    say($"write {show(tmp.read_text("lang-capability-test.txt"))}")
    ok(())
}
