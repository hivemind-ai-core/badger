// A closed subscription leaves the broadcast: publishing stops delivering
// to it, and under `#block` stops waiting for it (it would otherwise block
// once its backlog filled).
import std.broadcast
import std.io

pub fn main() -> Result<Unit, broadcast.Error> {
    let b = broadcast.create<Int>({ backlog: 2, policy: #block })?
    let live = b.subscribe()?
    let gone = b.subscribe()?
    let _ = io.println($"subscribers {b.subscribers()}")
    gone.close()
    // `gone` never reads: without leaving, the third publish would block
    for i in 1..=2 {
        let _ = io.println($"publish {i} reached {b.publish(i)}")
        let _ = live.recv()
    }
    let _ = io.println($"publish 3 reached {b.publish(3)}")
    let _ = io.println($"subscribers {b.subscribers()}, live got {live.recv()}")
    ok(())
}
