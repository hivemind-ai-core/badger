// A value from an associated call whose candidates all return one type
// (`From<Int>` or the reflexive `From<Meters>`) has that type before the
// literal argument is settled: its fields can be read.
import std.io

pub struct Meters { v: Int }

impl From<Int> for Meters {
    fn from(x: Int) -> Meters { { v: x } }
}

pub fn main() -> Result<Unit, io.Error> {
    let n = Meters.from(6)
    io.println($"{n.v}")?
    ok(())
}
