// Capacity zero selects a rendezvous channel: `send` completes only when a
// receiver takes the value, so the sender can never run ahead. The check
// holds under any scheduling, including several workers.
import std.channel
import std.io
import std.task

pub enum AppError {
    config(source: channel.ConfigError),
    send(source: channel.SendError<Int>),
    io(source: io.Error),
} derive(Error, From)

pub fn main() -> Result<Unit, AppError> {
    let ends = channel.create<Int>({ ..channel.defaults, capacity: 0 })?
    // receive calls started, and sends that completed before a matching
    // receive had started (must stay zero)
    let asked = Atom.new(0)
    let early = Atom.new(0)
    let total = task.scope(fn(s) -> Result<Int, AppError> {
        let producer = s.spawn(fn() -> Result<Unit, AppError> {
            for i in 0..50 {
                ends.sender.send(i)?
                if asked.get() <= i {
                    let _ = early.update(fn(n: Int) -> Int { n + 1 })
                }
            }
            ends.sender.close()
            ok(())
        })
        var sum = 0
        loop {
            task.sleep(1ms)
            let _ = asked.update(fn(n: Int) -> Int { n + 1 })
            match ends.receiver.recv() {
                .some(v) => { sum = sum + v },
                .none => { break },
            }
        }
        producer.join()?
        ok(sum)
    })?
    io.println($"received sum {total}; sends ahead of a receiver: {early.get()}")?
    ok(())
}
