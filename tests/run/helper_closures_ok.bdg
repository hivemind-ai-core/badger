// A helper may run a closure over an affine value; using it afterwards is fine when no task took it.
import std.io
import std.task
import std.buffer
fn run_child<S>(s: &task.TaskScope<S>, f: fn() -> Int) -> task.Task<S, Int> { s.spawn(f) }
fn call_here(f: fn() -> Int) -> Int { f() }
pub fn main() -> Result<Unit, String> {
    use s <- task.scope()
    let b = buffer.new<Int>()
    b.push(0)
    let t = run_child(&s, fn() { b.push(1); b.len() })
    let c = buffer.new<Int>()
    let n = call_here(fn() { c.push(5); c.len() })
    c.push(6)
    let _ = io.println($"{t.join()} {n} {c.len()}")
    ok(())
}
