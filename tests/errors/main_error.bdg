// A program ending with an error reports its code, causal chain, and the
// location where it started propagating.
import std.io

@derive(Error)
pub enum Inner {
    bad(n: Int),
}

@derive(Error, From)
pub enum Outer {
    wrap(source: Inner),
}

fn inner(n: Int) -> Result<Int, Inner> {
    if n > 3 { err(Inner.bad(n)) } else { ok(n) }
}

fn f() -> Result<Int, Outer> {
    let x = inner(4)?
    ok(x)
}

pub fn main() -> Result<Unit, Outer> {
    let x = f()?
    ok(())
}
