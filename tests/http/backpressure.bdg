// A streamed reply to a client that stops reading: the streaming task waits
// once `http_max_stream_buffer_bytes` are waiting for the client, instead
// of buffering the whole reply. `/count` reports how many chunks were made.
import stdx.config
import stdx.http
import std.io
import std.seq
import std.system
import std.system.{component}
import std.text

type Settings = { port: U16 }

@derive(Error, From)
pub enum AppError {
    config(source: config.Error),
    http(source: http.Error),
    io(source: io.Error),
    system(source: system.Error),
}

/// 1280 chunks of 16 KiB (20 MiB).
fn chunks(produced: Atom<Int>) -> Seq<Bytes> {
    let block = text.repeat("x", 16384)
    seq.scoped(
        fn() { Cell.new(0) },
        fn(c: Cell<Int>) {
            let k = c.get()
            if k < 1280 {
                c.set(k + 1)
                produced.set(k + 1)
                Option.some(text.to_bytes(block))
            } else {
                Option.none
            }
        },
        fn(c: Cell<Int>) {},
    )
}

let api = system.provider({
    name: #test/stream,
    init: fn(_scope, _cfg: {}) -> Result<_, AppError> {
        let produced = Atom.new(0)
        let streaming = http.streaming_handler(fn(request) -> Result<http.Streamed, http.Error> {
            http.stream(200, "text/plain", chunks(produced))
        })
        let count = http.handler(fn(request) -> Result<http.Response, http.Error> {
            http.json(200, { produced: produced.get() })
        })
        ok({ streaming, count })
    },
})

pub fn main() -> Result<Unit, AppError> {
    let settings = config.from_env<Settings>("BP_")?
    let plan = system {
        api: component(api, {}),
        streaming: component(http.server, { address: "127.0.0.1", port: settings.port, handler: ref(#api).streaming }),
        count: component(http.server, { address: "127.0.0.1", port: settings.port + 1, handler: ref(#api).count }),
    }
    use running <- system.run(plan)
    running.wait_for_shutdown()?
    ok(())
}
