// A running program for `lang inspect --connect`: a started system, a full
// channel with a blocked sender, a waiting receiver, and a sleeping task.
import std.channel
import std.io
import std.pipeline
import std.pipeline.{handle}
import std.system
import std.system.{component}
import std.task

pub struct Failure {
    pub message: String,
}

impl Display for Failure {
    fn display(self: &Self) -> String { self.message }
}

impl Error for Failure {}

fn value(v: Int) -> system.Provider<{ v: Int }, Int, Failure> {
    system.provider({ name: :test/value, init: fn(scope, config) -> Result<Int, Failure> { ok(config.v) } })
}

type Ctx = { path: String }

// a request parked inside a pipeline stage
fn slow_chain() -> Result<String, String> {
    let chain = pipeline {
        pipeline.stage({
            name: :test/auth,
            enter: fn(ctx: Ctx) -> Result<pipeline.Enter<Ctx, Ctx, String>, String> {
                task.sleep(1200ms)
                pipeline.next(ctx)
            },
        }),
        handle(fn(ctx: Ctx) -> Result<String, String> { ok(ctx.path) }),
    }
    pipeline.compile(chain)({ path: "/slow" })
}

pub enum AppError {
    config(source: channel.ConfigError),
    send(source: channel.SendError<Int>),
    io(source: io.Error),
    system(source: system.Error),
} derive(Error, From)

pub fn main() -> Result<Unit, AppError> {
    let plan = system {
        base: component(value(1), { v: 1 }),
        total: component(value(2), { v: ref(:base) + 1 }),
    }
    let full = channel.create<Int>({ ..channel.defaults, capacity: 1 })?
    let idle = channel.create<String>({ ..channel.defaults, capacity: 4 })?
    system.run(plan, fn(running) -> Result<Unit, AppError> {
        task.scope(fn(s) -> Result<Unit, AppError> {
            let _ = s.spawn(fn() -> Result<Unit, AppError> {
                full.sender.send(1)?
                full.sender.send(2)?
                ok(())
            })
            let _ = s.spawn(fn() { let _ = idle.receiver.recv() })
            let _ = s.spawn(fn() { let _ = slow_chain() })
            io.println($"ready {running.total}")?
            task.sleep(1500ms)
            let _ = full.receiver.recv()
            let _ = full.receiver.recv()
            idle.sender.close()
            ok(())
        })
    })
}
