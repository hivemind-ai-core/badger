// A long-running program for `lang repl --connect`: a module-level value the
// REPL can read, and a function it can replace.
import std.io
import std.task

let label = "counter"

fn greeting() -> String { "hello" }

pub fn main() -> Result<Unit, io.Error> {
    let hits = Atom.new(0)
    // runs until the REPL replaces `greeting`
    while greeting() == "hello" {
        let _ = hits.update(fn(n: Int) -> Int { n + 1 })
        task.sleep(20ms)
    }
    io.println($"greeting is now {greeting()}")?
    ok(())
}
