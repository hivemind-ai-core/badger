struct Point { x: Int, y: Int }
impl Point {
    fn norm(self: &Self) -> Int { self.x + "no" }
}
fn takes(p: Point) -> Int { p.x }
fn main() {
    let n: Int = takes(5)
    let q: Point = 3.5
    let r: Point = takes({ x: 1, y: 2 })
}
enum Shape { circle(r: Int), square(s: Int) }
fn more(p: Point, s: Shape) -> Int {
    let a = p.nope()
    let b = takes()
    match s {
        .circle(r) => r,
    }
}
