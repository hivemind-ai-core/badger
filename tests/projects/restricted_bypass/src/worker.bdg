import std.fs
import std.env
import stdx.fetch
import stdx.config
import stdx.sqlite
import std.system
import std.system.{component}
import main

pub fn direct() -> String { env.get("HOME").unwrap_or("") }

pub fn indirect() -> String { main.load("/etc/hostname") }

extern "c" fn getpid() -> I32

pub fn foreign() -> I32 { unsafe { getpid() } }

pub fn fetching() -> Bool !{Io, Wait} { fetch.get("http://127.0.0.1:1/").is_ok() }

// a client handed in is a capability, not ambient authority
pub fn given(c: fetch.Client) -> Bool !{Io, Wait} { c.get("/").is_ok() }

// standard helpers and providers that reach the environment or a database
type Settings = { secret_key: String }

pub fn settings() -> Bool { config.from_env<Settings>("").is_ok() }

pub fn database() -> Result<Int, system.Error> {
    let plan = system { db: component(sqlite.pool, { path: ":memory:" }) }
    system.run(plan, fn(running) -> Result<Int, system.Error> { ok(1) })
}
