// A database-backed REST service.
//
// What it demonstrates:
//
//   * Domain modelling: records (a new book's fields carry their rules,
//     `@validate.not_blank`, checked by `validate.check`), a `@flatten`
//     struct for the row id (it is a plain number in JSON and in SQL rows),
//     and the `Display` protocol.
//
//   * Errors: one `AppError` enum. `derive(From)` lets `?` convert every
//     underlying error; `derive(HttpError)` answers each variant with its
//     `@http.status` (a wrapped error with its own), and `@message` is its
//     text, so a handler just returns `err`.
//
//   * HTTP: JSON routes with typed path and query parameters
//     (`route.get_json` and friends), behind a pipeline of stages (an access
//     log and a timer). Invalid parameters and bodies are 400 replies
//     without a line of code; each request runs as its own task.
//
//   * SQLite: a pool, versioned migrations, transactions, named parameters
//     bound from records, and rows decoded straight into the domain type.
//
//   * Lifecycle: `system { ... }` with providers wired by `ref(#name)`, a
//     supervised worker that reports stats, and an `Atom` shared by both.
//
//   * Tests: one in-memory plan, driven in-process with `http.call_text`
//     (no socket, no port).
//
// Try it:
//
//     badger check 13_rest_service.bdg
//     badger test  13_rest_service.bdg
//
//     # Run as a server:
//     BOOKS_ADDRESS=127.0.0.1 BOOKS_PORT=8080 BOOKS_DATABASE=books.db \
//     BOOKS_REPORT_EVERY_MS=60000 badger run 13_rest_service.bdg
//
//     curl localhost:8080/health
//     curl -X POST localhost:8080/books -d '{"title":"Badger","author":"D."}'
//     curl localhost:8080/books
//     curl localhost:8080/books/1
//     curl -X PUT localhost:8080/books/1 -d '{"title":"Badger","author":"Ada"}'
//     curl -X DELETE localhost:8080/books/1
//     curl "localhost:8080/search?q=badger"
//     curl localhost:8080/stats
import std.config
import std.http
import std.io
import std.log
import std.pipeline
import std.pipeline.{handle}
import std.route
import std.sqlite
import std.system
import std.task
import std.text
import std.time
import std.trace
import std.validate
import std.worker

// ---- Configuration -------------------------------------------------------

type Settings = {
    database: String,
    address: String,
    port: U16,
    report_every_ms: Int,
}

// ---- Domain types --------------------------------------------------------

/// The row id, a type of its own; `@flatten` makes it its number on the
/// wire (`"id": 1`) and in rows.
@flatten
pub struct BookId {
    pub value: Int,
}

impl Display for BookId {
    fn display(self: &Self) -> String { $"book-{self.value}" }
}

pub type Book = { id: BookId, title: String, author: String }
/// What a client sends; its fields' rules are checked by `validate.check`.
pub type NewBook = {
    @validate.not_blank @validate.max_len(200) title: String,
    @validate.not_blank author: String,
}

/// Every way a request can fail. A variant wrapping a library's error
/// answers with that error's status (a 500 for these, whose details stay in
/// the log).
@derive(Error, HttpError, From)
pub enum AppError {
    configuration(source: config.Error),
    database(source: sqlite.Error),
    route(source: route.RouteError),
    system(source: system.Error),
    io(source: io.Error),
    @http.status(400) @message("{message}")
    invalid_input(message: String),
    @http.status(404) @message("no book {id}")
    not_found(id: Int),
}

// ---- Schema migrations ---------------------------------------------------

// Versions increase; `sqlite.require_current` refuses to start on a
// database that does not match exactly the migrations the program knows.
pub let migrations: List<sqlite.Migration> = [
    {
        version: 1,
        name: "books",
        sql: "CREATE TABLE books (id INTEGER PRIMARY KEY, title TEXT NOT NULL, author TEXT NOT NULL)",
    },
]

// ---- Validation ----------------------------------------------------------

/// Trimmed fields that keep `NewBook`'s rules, or every problem at once.
fn cleaned(input: NewBook) -> Result<NewBook, AppError> {
    let book: NewBook = { title: text.trim(input.title), author: text.trim(input.author) }
    validate.check(book).map_err(fn(problems) => AppError.invalid_input(validate.summary(problems)))
}

// ---- The store: typed SQLite queries -------------------------------------

pub type Store = {
    list: fn() -> Result<List<Book>, AppError> !{Io, Wait},
    search: fn(String) -> Result<List<Book>, AppError> !{Io, Wait},
    stats: fn() -> Result<Int, AppError> !{Io, Wait},
    find: fn(Int) -> Result<Option<Book>, AppError> !{Io, Wait},
    insert: fn(NewBook) -> Result<Book, AppError> !{Io, Wait},
    update: fn(Int, NewBook) -> Result<Option<Book>, AppError> !{Io, Wait},
    remove: fn(Int) -> Result<Bool, AppError> !{Io, Wait},
}

pub provider store(config: { pool: sqlite.Pool, migrate: Bool }) -> Result<Store, AppError> {
    let pool = config.pool
    if config.migrate {
        let _ = sqlite.migrate(pool, migrations)?
    } else {
        sqlite.require_current(pool, migrations)?
    }
    ok({
        list: fn() { ok(sqlite.query_as<Book>(pool, "SELECT id, title, author FROM books ORDER BY id", [])?) },
        // `:pattern` is bound from the record's field (twice), never
        // spliced into the SQL
        search: fn(query) {
            let sql = "SELECT id, title, author FROM books WHERE title LIKE :pattern OR author LIKE :pattern ORDER BY id"
            ok(sqlite.query_as<Book>(pool, sql, { pattern: $"%{query}%" })?)
        },
        stats: fn() { ok(sqlite.query_one_as<{ total: Int }>(pool, "SELECT COUNT(*) AS total FROM books", [])?.total) },
        find: fn(id) { ok(sqlite.query_opt_as<Book>(pool, "SELECT id, title, author FROM books WHERE id = :id", { id })?) },
        insert: fn(book) {
            // one connection for both statements
            use tx <- sqlite.transaction(pool)
            let _ = sqlite.execute(tx, "INSERT INTO books (title, author) VALUES (:title, :author)", book)?
            ok(sqlite.query_one_as<Book>(tx, "SELECT id, title, author FROM books WHERE id = last_insert_rowid()", [])?)
        },
        update: fn(id, book) {
            use tx <- sqlite.transaction(pool)
            let changed = sqlite.execute(tx, "UPDATE books SET title = :title, author = :author WHERE id = :id", { ..book, id })?
            if changed == 0 {
                return ok(none)
            }
            ok(sqlite.query_opt_as<Book>(tx, "SELECT id, title, author FROM books WHERE id = :id", { id })?)
        },
        remove: fn(id) { ok(sqlite.execute(pool, "DELETE FROM books WHERE id = :id", { id })? > 0) },
    })
}

// ---- Cross-cutting pipeline stages --------------------------------------

stage timing() {
    enter(ctx) {
        pipeline.next({ ..ctx, [#books/started]: time.now() })
    }
    leave(ctx, response: http.Response) {
        trace.event(#books/completed, {
            status: response.status,
            elapsed: time.now() - ctx[#books/started],
        })
        pipeline.leave(ctx, response)
    }
}

stage access_log(requests: Atom<Int>) -> Result<_, AppError> {
    enter(ctx) {
        let _ = requests.update(fn(n) => n + 1)
        pipeline.next(ctx)
    }
    leave(ctx, response: http.Response) {
        log.info("request", {
            method: ctx.request.method,
            path: ctx.request.path,
            status: response.status,
        })
        pipeline.leave(ctx, response)
    }
}

// ---- The routes ---------------------------------------------------------
//
// A handler receives its typed parameters (and body) and returns the reply
// or an `AppError`; the route answers with 200 (201 for a POST) or with
// the error's status, code, and message.

type ById = { id: Int }

fn found<T>(id: Int, value: Option<T>) -> Result<T, AppError> {
    value.ok_or(AppError.not_found(id))
}

fn routes(store: Store) -> List<route.Route> {
    [
        route.get_json("/health", #books/health, fn(_: {}) -> Result<{ status: String }, AppError> { ok({ status: "ok" }) }),
        route.get_json("/books", #books/list, fn(_: {}) { store.list() }),
        route.post_json("/books", #books/create, fn(_: {}, input: NewBook) { store.insert(cleaned(input)?) }),
        route.get_json("/books/:id", #books/show, fn(p: ById) { found(p.id, store.find(p.id)?) }),
        route.put_json("/books/:id", #books/update, fn(p: ById, input: NewBook) {
            found(p.id, store.update(p.id, cleaned(input)?)?)
        }),
        route.delete_json("/books/:id", #books/delete, fn(p: ById) -> Result<{ deleted: Bool }, AppError> {
            if !store.remove(p.id)? {
                return err(AppError.not_found(p.id))
            }
            ok({ deleted: true })
        }),
        // `GET /search?q=badger`: a parameter the path does not bind comes
        // from the query string
        route.get_json("/search", #books/search, fn(p: { q: String }) {
            let hits = store.search(p.q)?
            ok({ query: p.q, count: hits.len(), hits })
        }),
        route.get_json("/stats", #books/stats, fn(_: {}) { ok({ total: store.stats()? }) }),
    ]
}

// ---- API provider: builds the handler from the store --------------------

pub provider api(config: { store: Store, requests: Atom<Int> }) -> Result<http.Handler, AppError> {
    let table = route.table(routes(config.store))?
    // each request: count and log it, time it, then route it
    let process = pipeline.compile(pipeline {
        access_log(config.requests),
        timing(),
        handle(fn(ctx) -> Result<http.Response, AppError> { ok(http.call(table, ctx.request)) }),
    })
    ok(http.handler(fn(request) { process({ request }) }))
}

// ---- The stats worker: a background task that reports periodically -----
//
// A worker started with `scope.worker` is supervised (restarted after a
// failure, within the limits) and stops with the system.
provider stats_reporter(scope, config: { store: Store, every: Duration, requests: Atom<Int> }) -> Result<Unit, AppError> {
    let store = config.store
    let requests = config.requests
    scope.worker(fn() -> Result<Unit, AppError> {
        loop {
            task.sleep(config.every)
            match store.stats() {
                .ok(total) => log.info("stats", { served: requests.get(), total }),
                .err(e) => log.warn("stats failed", { message: e.display() }),
            }
        }
        ok(())
    }, worker.on_failure({ max_restarts: 3, window: 1s, backoff: 10ms }))
    ok(())
}

// ---- The service entry point -------------------------------------------

pub fn main() -> Result<Unit, AppError> {
    let settings = config.from_env<Settings>("BOOKS_")?
    // requests served: the access log counts, the reporter reads
    let requests: Atom<Int> = Atom.new(0)
    let plan = system {
        database: sqlite.pool({ path: settings.database }),
        // `migrate: true` applies pending migrations at startup; `false`
        // refuses to start on a database that is not the expected one
        store: store({ pool: ref(#database), migrate: true }),
        api: api({ store: ref(#store), requests }),
        reporter: stats_reporter({ store: ref(#store), every: time.millis(settings.report_every_ms), requests }),
        server: http.server({ address: settings.address, port: settings.port, handler: ref(#api) }),
    }
    use running <- system.run(plan)
    log.info("serving", { address: settings.address, port: settings.port })
    running.wait_for_shutdown()?
    ok(())
}

// ---- Tests: drive the API in-process, no port ---------------------------

/// The service over an in-memory database, without the server and worker.
fn in_memory() -> _ {
    let requests: Atom<Int> = Atom.new(0)
    system {
        database: sqlite.pool({ path: ":memory:" }),
        store: store({ pool: ref(#database), migrate: true }),
        api: api({ store: ref(#store), requests }),
    }
}

fn test_health() -> Result<Unit, AppError> {
    use running <- system.run(in_memory())
    assert(http.call_text(running.api, #get, "/health", "") == (200, "{\"status\":\"ok\"}"))
    ok(())
}

fn test_create_and_show() -> Result<Unit, AppError> {
    use running <- system.run(in_memory())
    let api = running.api
    let created = http.call_text(api, #post, "/books", "{\"title\":\" Badger \",\"author\":\"D.\"}")
    assert(created == (201, "{\"author\":\"D.\",\"id\":1,\"title\":\"Badger\"}"))
    assert(http.call_text(api, #get, "/books/1", "") == (200, created.1))
    assert(http.call_text(api, #get, "/books/999", "") == (404, "{\"error\":\"not_found\",\"message\":\"no book 999\"}"))
    assert(http.call_text(api, #get, "/books/abc", "").0 == 400)
    ok(())
}

fn test_validation_errors() -> Result<Unit, AppError> {
    use running <- system.run(in_memory())
    let api = running.api
    assert(http.call_text(api, #post, "/books", "{\"title\":\"\",\"author\":\"D.\"}").0 == 400)
    // every problem in one message
    let (status, body) = http.call_text(api, #post, "/books", "{\"title\":\"\",\"author\":\"\"}")
    assert(status == 400)
    assert(text.contains(body, "author must not be blank; title must not be blank"))
    assert(http.call_text(api, #post, "/books", "not json").0 == 400)
    ok(())
}

fn test_update_and_delete() -> Result<Unit, AppError> {
    use running <- system.run(in_memory())
    let api = running.api
    let _ = http.call_text(api, #post, "/books", "{\"title\":\"A\",\"author\":\"B\"}")
    assert(http.call_text(api, #put, "/books/1", "{\"title\":\"A2\",\"author\":\"B2\"}") == (200, "{\"author\":\"B2\",\"id\":1,\"title\":\"A2\"}"))
    assert(http.call_text(api, #put, "/books/7", "{\"title\":\"A2\",\"author\":\"B2\"}").0 == 404)
    assert(http.call_text(api, #delete, "/books/999", "").0 == 404)
    assert(http.call_text(api, #delete, "/books/1", "") == (200, "{\"deleted\":true}"))
    assert(http.call_text(api, #get, "/books", "") == (200, "[]"))
    ok(())
}

fn test_search_and_stats() -> Result<Unit, AppError> {
    use running <- system.run(in_memory())
    let api = running.api
    for body in ["{\"title\":\"Badger\",\"author\":\"Ada\"}", "{\"title\":\"Beaver\",\"author\":\"Bram\"}", "{\"title\":\"Otter\",\"author\":\"Olaf\"}"] {
        let _ = http.call_text(api, #post, "/books", body)
    }
    let (status, body) = http.call_text(api, #get, "/search?q=bad", "")
    assert(status == 200 && text.contains(body, "\"count\":1") && text.contains(body, "\"Badger\""))
    let (_, several) = http.call_text(api, #get, "/search?q=er", "")
    assert(text.contains(several, "\"Badger\"") && text.contains(several, "\"Beaver\""))
    assert(http.call_text(api, #get, "/search", "").0 == 400)
    assert(http.call_text(api, #get, "/stats", "") == (200, "{\"total\":3}"))
    ok(())
}
