import orders.api
import std.pipeline
import std.pipeline.{handle}
import std.text
import std.trace

stage audit() {
    enter(ctx) {
        pipeline.next({ ..ctx, validated: false })
    }
    leave(ctx, reply) {
        // Observe the latest value of a field introduced by this stage.
        assert(ctx.validated)
        trace.event(#orders/created, { id: reply.id, validated: ctx.validated })
        pipeline.leave(ctx, reply)
    }
    error(ctx, error) {
        trace.event(#orders/rejected, { validated: ctx.validated })
        pipeline.propagate(ctx, error)
    }
}

stage validate() -> Result<_, api.Error> {
    enter(ctx) {
        let title = text.trim(ctx.input.title)
        if title == "" {
            return err(api.Error.invalid_title)
        }
        pipeline.next({ ..ctx, input: { title }, validated: true })
    }
}

pub fn create(store: api.Store) -> api.Service {
    let process = pipeline.compile(pipeline {
        audit(),
        validate(),
        handle(fn(ctx) -> Result<api.Order, api.Error> {
            store.insert(ctx.input)
        }),
    })
    { create: fn(input) { process({ input }) } }
}
