// The HTTP binding of the tasks feature: each operation bound to a method
// and path (typed parameters, body, and reply; explicit replies for the
// feature's errors), behind an access-log stage.
import std.endpoint
import std.http
import std.log
import std.pipeline
import std.pipeline.{handle}
import std.route
import tasks.model

pub enum Error {
    route(source: route.RouteError),
} derive(Error, From)

// Log each request's outcome; `leave` sees the reply of every later stage.
stage access_log() -> Result<_, Error> {
    leave(ctx, response: http.Response) {
        log.info("request", {
            method: ctx.request.method,
            path: ctx.request.path,
            status: response.status,
            correlation: response.headers.get("x-correlation-id").unwrap_or(""),
        })
        pipeline.leave(ctx, response)
    }
}

// The feature's errors are client errors, with the message the feature gives.
fn failure(e: model.Error) -> endpoint.Failure {
    match e {
        .invalid_title(message) => endpoint.failure(400, #tasks/invalid_title, message),
        .not_found(id) => endpoint.failure(404, #tasks/not_found, $"no task {id}"),
    }
}

pub fn routes(tasks: model.Tasks) -> List<route.Route> {
    [
        endpoint.bind({
            method: #get,
            path: "/tasks",
            operation: tasks.list,
            input: fn(_params: {}, _body: {}) { {} },
            status: 200,
            errors: failure,
        }),
        endpoint.bind({
            method: #post,
            path: "/tasks",
            operation: tasks.create,
            input: fn(_params: {}, body: model.NewTask) { body },
            status: 201,
            errors: failure,
        }),
        endpoint.bind({
            method: #post,
            path: "/tasks/:id/done",
            operation: tasks.complete,
            input: fn(params: { id: Int }, _body: {}) { params.id },
            status: 200,
            errors: failure,
        }),
    ]
}

pub provider api(config: { tasks: model.Tasks }) -> Result<http.Handler, Error> {
    let table = route.table(routes(config.tasks))?
    let process = pipeline.compile(pipeline {
        access_log(),
        handle(fn(ctx) -> Result<http.Response, Error> { ok(http.call(table, ctx.request)) }),
    })
    ok(http.handler(fn(request) { process({ request }) }))
}
