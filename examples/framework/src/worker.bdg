// A background activity owned by a node: a reminder worker, supervised
// (restarted after a failure, within limits) and stopped with the system.
import std.app
import std.io
import std.system
import std.task
import std.worker
import tasks.memory
import tasks.model
import tasks.service

pub enum AppError {
    tasks(source: model.Error),
    system(source: system.Error),
    io(source: io.Error),
} derive(Error, From)

// Report the open tasks `rounds` times, then finish.
provider reminders(scope, config: { tasks: model.Tasks, rounds: Int, sent: Atom<Int> }) -> Result<Unit, AppError> {
    let tasks = config.tasks
    let sent = config.sent
    let rounds = config.rounds
    scope.worker(fn() -> Result<Unit, AppError> {
        for _ in 0..rounds {
            let open = tasks.open.call(app.call(), {})?
            io.println($"reminder: {open.len()} open")?
            let _ = sent.update(fn(n) { n + 1 })
            task.sleep(1ms)
        }
        ok(())
    }, worker.on_failure({ max_restarts: 3, window: 1s, backoff: 10ms }))
    ok(())
}

pub fn main() -> Result<Unit, AppError> {
    let sent = Atom.new(0)
    let plan = system {
        store: memory.store({ first_id: 1 }),
        tasks: service.tasks({ store: ref(#store), max_title: 80 }),
        reminders: reminders({ tasks: ref(#tasks), rounds: 3, sent }),
    }
    use running <- system.run(plan)
    let call = app.call()
    let _ = running.tasks.create.call(call, { title: "Write the docs" })?
    let _ = running.tasks.create.call(call, { title: "Ship the release" })?
    // wait for the worker's rounds; leaving the scope stops it
    while sent.get() < 3 {
        task.sleep(1ms)
    }
    io.println("done")?
    ok(())
}
