// The feature's vocabulary: what a task is, what can go wrong, what the
// feature needs (a store), and what it offers: operations, the same ones to
// HTTP, the command line, and workers.
import stdx.app
import stdx.command
import stdx.http

pub type Task = { id: Int, title: String, done: Bool }
pub type NewTask = { title: String }

// What can go wrong, said once for every binding: each variant's message,
// its HTTP status and code (`#tasks/<variant>`; a server error's details
// stay out of the reply), and the exit status it ends a command with.
@derive(Error, HttpError, CommandError)
@http.codes(#tasks)
pub enum Error {
    @display("{message}") @http.status(400) @command.exit(1)
    invalid_title(message: String),
    @display("no task {id}") @http.status(404) @command.exit(3)
    not_found(id: Int),
    @display("{message}") @http.status(503) @command.exit(74)
    storage(message: String),
}

// What the feature needs from storage; `memory.store` and `sqlite_store.store`
// provide it (and `store_contract` in the tests checks both the same way).
pub type Store = {
    insert: fn(String) -> Result<Task, Error> !{Io, Wait, State},
    all: fn() -> Result<List<Task>, Error> !{Io, Wait, State},
    complete: fn(Int) -> Result<Option<Task>, Error> !{Io, Wait, State},
}

pub type Tasks = {
    create: app.Operation<NewTask, Task, Error, !{Io, Wait, State}>,
    list: app.Operation<{}, List<Task>, Error, !{Io, Wait, State}>,
    open: app.Operation<{}, List<Task>, Error, !{Io, Wait, State}>,
    complete: app.Operation<Int, Task, Error, !{Io, Wait, State}>,
}
