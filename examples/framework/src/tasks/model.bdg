// The feature's vocabulary: what a task is, what can go wrong, what the
// feature needs (a store), and what it offers: operations, the same ones to
// HTTP, the command line, and workers.
import std.app

pub type Task = { id: Int, title: String, done: Bool }
pub type NewTask = { title: String }

pub enum Error {
    invalid_title(message: String),
    not_found(id: Int),
} derive(Error)

pub type Store = {
    insert: fn(String) -> Task !{State},
    all: fn() -> List<Task> !{State},
    complete: fn(Int) -> Option<Task> !{State},
}

pub type Tasks = {
    create: app.Operation<NewTask, Task, Error, !{State}>,
    list: app.Operation<{}, List<Task>, Error, !{State}>,
    open: app.Operation<{}, List<Task>, Error, !{State}>,
    complete: app.Operation<Int, Task, Error, !{State}>,
}
