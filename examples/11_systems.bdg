import std.io
import std.system
import std.trace

@derive(Error, From)
pub enum AppError {
    io(source: io.Error),
    system(source: system.Error),
}

// A provider is a component factory: its initializer receives a scope (to
// register halts) and its configuration, and returns its public interface.
provider greeting(scope, config) -> Result<_, AppError> {
    trace.event(#greeting/started, { prefix: config.prefix })
    scope.on_halt(fn() -> Result<Unit, AppError> {
        trace.event(#greeting/stopped, {})
        ok(())
    })
    // The component's public interface is simply a record of functions.
    ok({ greet: fn(name: String) { $"{config.prefix}, {name}" } })
}

provider announcement(scope, config) -> Result<_, AppError> {
    scope.on_halt(fn() -> Result<Unit, AppError> {
        trace.event(#announcement/stopped, {})
        ok(())
    })
    ok({ announce: fn(name: String) { config.greeting.greet(name) } })
}

pub fn main() -> Result<Unit, AppError> {
    let plan = system {
        // References establish startup order even when declarations differ.
        announcement: announcement({ greeting: ref(#greeting) }),
        greeting: greeting({ prefix: "Welcome" }),
    }

    use running <- system.run(plan)
    io.println(running.announcement.announce("Ada"))?
    // Scope exit halts announcement before greeting, including on I/O failure.
    ok(())
}
