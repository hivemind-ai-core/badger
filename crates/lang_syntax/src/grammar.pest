// Draft-0 grammar. Input is the output of `layout::layout`: comments are
// blanked and statement-terminating newlines are replaced by U+001E (NL).
// Precedence is resolved by a Pratt parser during AST lowering.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
NL         = _{ "\u{1E}" }
semi       =  { ";" }
sep        = _{ NL | ";" }
// separators inside aggregate literals and declarations
sepc       = _{ "," | NL | ";" }
// entries of aggregate literals/types: commas separate, newlines are layout
nls        = _{ NL* }
csep       = _{ NL* ~ "," ~ NL* }
trail      = _{ NL* ~ ("," ~ NL*)? }

// ---------------------------------------------------------------- lexical
ident_char = _{ ASCII_ALPHANUMERIC | "_" }
reserved   = @{
    ("import" | "as" | "pub" | "type" | "struct" | "enum" | "protocol" | "impl" | "for" | "where"
     | "fn" | "once" | "let" | "var" | "const" | "if" | "else" | "match" | "while" | "loop"
     | "in" | "break" | "continue" | "return" | "use" | "unsafe" | "extern" | "dyn" | "true"
     | "false" | "mut") ~ !ident_char
}
// any identifier-shaped name; case rules are checked during lowering
name        = @{ !reserved ~ (ASCII_ALPHA | "_" ~ ASCII_ALPHA_LOWER) ~ ident_char* }
value_ident = @{ !reserved ~ ("_" ~ ASCII_ALPHA_LOWER | ASCII_ALPHA_LOWER) ~ ident_char* }
type_ident  = @{ ASCII_ALPHA_UPPER ~ ident_char* }
// after a dot, keywords may name members; tuple fields are numeric
member      = @{ ("_" ~ ASCII_ALPHA_LOWER | ASCII_ALPHA) ~ ident_char* | ASCII_DIGIT+ }
discard     = @{ "_" ~ !ident_char }

symbol   = @{ ":" ~ sym_seg ~ ("/" ~ sym_seg)? }
sym_seg  = @{ ASCII_ALPHA ~ ident_char* }

dec_digits = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
num_suffix = @{ ("I" | "U" | "F") ~ ASCII_DIGIT+ ~ !ident_char }
duration   = @{ dec_digits ~ ("ns" | "us" | "ms" | "min" | "s" | "h") ~ !ident_char }
float      = @{
    dec_digits ~ ("." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ exponent? | exponent) ~ num_suffix?
  | dec_digits ~ &("F" ~ ASCII_DIGIT) ~ num_suffix
}
exponent   = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+ }
int        = @{
    ("0x" ~ (ASCII_HEX_DIGIT | "_")+ | "0b" ~ ("0" | "1" | "_")+ | dec_digits) ~ num_suffix? ~ !ident_char
}
bool_lit   = @{ ("true" | "false") ~ !ident_char }

escape      = @{ "\\" ~ ("n" | "r" | "t" | "\\" | "\"" | "'" | "0" | "u{" ~ ASCII_HEX_DIGIT+ ~ "}") }
string      = ${ "\"" ~ str_content ~ "\"" }
str_content = @{ (escape | !("\"" | "\\" | "\n") ~ ANY)* }
raw_string  = ${ "\"\"\"" ~ raw_content ~ "\"\"\"" }
raw_content = @{ (!"\"\"\"" ~ ANY)* }
interp      = ${ "$\"" ~ (interp_text | interp_hole)* ~ "\"" }
interp_raw  = ${ "$\"\"\"" ~ (interp_raw_text | interp_hole)* ~ "\"\"\"" }
interp_text     = @{ ("{{" | "}}" | escape | !("\"" | "\\" | "{" | "}" | "\n") ~ ANY)+ }
interp_raw_text = @{ ("{{" | "}}" | !("\"\"\"" | "{" | "}") ~ ANY)+ }
interp_hole     = !{ "{" ~ expr ~ "}" }
char_lit    = ${ "'" ~ char_content ~ "'" }
char_content = @{ escape | !("'" | "\\") ~ ANY }

pub_kw  = { &kw_pub ~ "pub" }
kw_pub = @{ "pub" ~ !ident_char }
once_kw = { &kw_once ~ "once" }
kw_once = @{ "once" ~ !ident_char }
mut_kw  = { &kw_mut ~ "mut" }
kw_mut = @{ "mut" ~ !ident_char }

// ---------------------------------------------------------------- program
program = { SOI ~ (sep | item)* ~ EOI }
item    = { import_decl | extern_type | type_decl | struct_decl | enum_decl | protocol_decl | impl_decl | fn_decl
          | extern_decl | global_decl }

import_decl = { K_import ~ module_path ~ (K_as ~ name | "." ~ "{" ~ sepc* ~ import_item ~ (sepc+ ~ import_item)* ~ sepc* ~ "}")? }
module_path = { name ~ ("." ~ name)* }
import_item = { name ~ (K_as ~ name)? }

type_decl   = { pub_kw? ~ K_type ~ name ~ generic_params? ~ "=" ~ type_expr }
struct_decl = { pub_kw? ~ repr_c? ~ K_struct ~ name ~ generic_params? ~ "{" ~ sepc* ~ (struct_field ~ (sepc+ ~ struct_field)*)? ~ sepc* ~ "}" ~ (NL? ~ derives)? }
repr_c      = { K_repr ~ C_kw }
C_kw        = _{ &kw_c ~ "c" }
kw_c = @{ "c" ~ !ident_char }
struct_field = { pub_kw? ~ member ~ ":" ~ type_expr }
enum_decl   = { pub_kw? ~ K_enum ~ name ~ generic_params? ~ "{" ~ sepc* ~ (variant ~ (sepc+ ~ variant)*)? ~ sepc* ~ "}" ~ (NL? ~ derives)? }
variant     = { member ~ ("(" ~ (variant_field ~ ("," ~ variant_field)* ~ ","?)? ~ ")")? }
variant_field = { (member ~ ":" ~ !":")? ~ type_expr }
derives     = { K_derive ~ "(" ~ path_type ~ ("," ~ path_type)* ~ ","? ~ ")" }

protocol_decl = { pub_kw? ~ K_protocol ~ name ~ generic_params? ~ (":" ~ type_expr ~ ("+" ~ type_expr)*)? ~ "{" ~ (sep | method_decl | assoc_type)* ~ "}" }
impl_decl     = { K_impl ~ generic_params? ~ type_expr ~ impl_for? ~ where_clause? ~ "{" ~ (sep | method_decl | assoc_type)* ~ "}" }
impl_for      = { K_for ~ type_expr }
assoc_type    = { K_type ~ name ~ ("=" ~ type_expr)? }

fn_decl  = { (contract ~ sep+)* ~ pub_kw? ~ K_fn ~ name ~ generic_params? ~ "(" ~ params ~ ")" ~ ret_type? ~ effect? ~ where_clause? ~ block? }
// `requires COND` / `ensures COND`, optionally `, "message"`, on lines before a function
contract     = { (requires_kw | ensures_kw) ~ expr ~ ("," ~ (string | raw_string))? }
requires_kw  = @{ "requires" ~ !ident_char }
ensures_kw   = @{ "ensures" ~ !ident_char }
// methods are members: a keyword may name one (`s.match()`)
method_decl = { (contract ~ sep+)* ~ pub_kw? ~ K_fn ~ member ~ generic_params? ~ "(" ~ params ~ ")" ~ ret_type? ~ effect? ~ where_clause? ~ block? }
ret_type = { "->" ~ type_expr }
params   = { (param ~ ("," ~ param)* ~ ","?)? }
param    = { pattern ~ (":" ~ type_expr)? }
generic_params = { "<" ~ generic_param ~ ("," ~ generic_param)* ~ ","? ~ ">" }
generic_param  = { name ~ (":" ~ type_expr ~ ("+" ~ type_expr)*)? }
where_clause   = { K_where ~ where_pred ~ ("," ~ where_pred)* }
where_pred     = { type_expr ~ ":" ~ type_expr ~ ("+" ~ type_expr)* }

extern_type = { pub_kw? ~ K_extern ~ K_type ~ name ~ generic_params? }
extern_decl = { pub_kw? ~ K_extern ~ string ~ K_fn ~ name ~ generic_params? ~ "(" ~ params ~ ")" ~ ret_type ~ effect? ~ where_clause? }
global_decl = { pub_kw? ~ let_kind ~ pattern ~ (":" ~ type_expr)? ~ "=" ~ expr }

// ---------------------------------------------------------------- types
type_expr   = { hole_type | fn_type | forall_type | ref_type | dyn_type | record_type | unit_type | tuple_type | paren_type | path_type }
hole_type   = { discard }
path_type   = { (value_ident ~ ".")* ~ type_ident ~ ("." ~ type_ident)? ~ type_args? }
type_args   = { "<" ~ type_arg ~ ("," ~ type_arg)* ~ ","? ~ ">" }
// an effect row argument of an effect-generic type (`Seq<Int, !{Io}>`)
type_arg    = _{ effect | type_expr }
unit_type   = { "(" ~ ")" }
paren_type  = { "(" ~ type_expr ~ ")" }
tuple_type  = { "(" ~ type_expr ~ "," ~ (type_expr ~ ("," ~ type_expr)*)? ~ ","? ~ ")" }
fn_type     = { once_kw? ~ K_fn ~ "(" ~ (type_expr ~ ("," ~ type_expr)* ~ ","?)? ~ ")" ~ "->" ~ type_expr ~ effect? }
forall_type = { K_for ~ generic_params ~ type_expr }
ref_type    = { "&" ~ mut_kw? ~ type_expr }
dyn_type    = { K_dyn ~ path_type }
record_type = { "{" ~ nls ~ (type_field ~ (csep ~ type_field)* ~ (csep ~ row_rest)? | row_rest)? ~ trail ~ "}" }
type_field  = { label ~ ":" ~ type_expr }
row_rest    = { ".." ~ type_ident }
effect      = { "!" ~ ("{" ~ (type_expr ~ ("," ~ type_expr)* ~ ","?)? ~ "}" | type_ident) }

// ---------------------------------------------------------------- statements
block      = { "{" ~ (NL | semi | stmt)* ~ "}" }
stmt       = { let_stmt | use_stmt | assign_stmt | expr }
let_kind   = @{ ("let" | "var" | "const") ~ !ident_char }
let_stmt   = { let_kind ~ pattern ~ (":" ~ type_expr)? ~ "=" ~ expr }
use_stmt   = { K_use ~ pattern ~ ("," ~ pattern)* ~ "<-" ~ expr }
assign_stmt = { place ~ "=" ~ !("=" | ">") ~ expr }
place      = { value_ident ~ (place_field | place_index)* }
place_field = { "." ~ member }
place_index = { "[" ~ expr ~ "]" }

// ---------------------------------------------------------------- expressions
expr = { prefix_op* ~ primary ~ postfix* ~ (infix_op ~ prefix_op* ~ primary ~ postfix*)* }

infix_op = _{ pipe_op | or_op | and_op | eq_op | ne_op | le_op | ge_op | shl_op | shr_op | lt_op | gt_op
            | range_incl_op | range_op | bitor_op | bitxor_op | bitand_op | add_op | sub_op | mul_op
            | div_op | rem_op }
pipe_op  = { "|>" }
or_op    = { "||" }
and_op   = { "&&" }
eq_op    = { "==" }
ne_op    = { "!=" }
le_op    = { "<=" }
ge_op    = { ">=" }
shl_op   = { "<<" }
shr_op   = { ">>" }
lt_op    = { "<" ~ !"-" }
gt_op    = { ">" }
range_incl_op = { "..=" }
range_op = { ".." }
bitor_op = { "|" ~ !("|" | ">") }
bitxor_op = { "^" }
bitand_op = { "&" ~ !"&" }
add_op   = { "+" }
sub_op   = { "-" ~ !">" }
mul_op   = { "*" }
div_op   = { "/" }
rem_op   = { "%" }

prefix_op  = _{ neg_op | not_op | ref_mut_op | ref_op }
neg_op     = { "-" }
not_op     = { "!" ~ !"=" }
ref_mut_op = @{ "&" ~ WHITESPACE* ~ "mut" ~ !ident_char }
ref_op     = { "&" ~ !"&" }

postfix  = _{ call_op | field_op | index_op | try_op }
call_op  = { type_args? ~ "(" ~ args ~ ")" }
field_op = { "." ~ !"." ~ member }
index_op = { "[" ~ expr ~ "]" }
try_op   = { "?" }
args     = { (expr ~ ("," ~ expr)* ~ ","?)? }

primary = _{
    interp_raw | interp | raw_string | string | char_lit | symbol | duration | float | int | bool_lit
  | lambda | if_expr | match_expr | while_expr | for_expr | loop_expr
  | system_expr | pipeline_expr | map_lit | set_lit | ref_expr | unsafe_expr
  | return_expr | break_expr | continue_expr
  | record_lit | block | unit_lit | tuple_lit | paren | list_lit
  | type_name_expr | name_expr
}
name_expr      = { value_ident }
type_name_expr = { type_ident }
unit_lit  = { "(" ~ ")" }
paren     = { "(" ~ expr ~ ")" }
tuple_lit = { "(" ~ expr ~ "," ~ (expr ~ ("," ~ expr)*)? ~ ","? ~ ")" }
list_lit  = { "[" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "]" }

record_lit   = { "{" ~ nls ~ "}" | "{" ~ nls ~ &record_head ~ record_entry ~ (csep ~ record_entry)* ~ trail ~ "}" }
record_head  = _{ ".." | label_path ~ ":" | value_ident ~ ("," | sepc* ~ "}") }
record_entry = _{ spread | field_entry | shorthand }
spread       = { ".." ~ expr }
field_entry  = { label_path ~ ":" ~ expr }
shorthand    = { value_ident }
label        = { member | "[" ~ symbol ~ "]" }
label_path   = { label ~ ("." ~ label)* }

lambda      = { once_kw? ~ K_fn ~ "(" ~ params ~ ")" ~ ret_type? ~ effect? ~ (block | lambda_expr) }
// `fn(x) => x + 1`: an expression body, the same as `{ x + 1 }`
lambda_expr = { "=>" ~ expr }
if_expr     = { K_if ~ (let_cond | expr) ~ block ~ (NL? ~ K_else ~ (if_expr | block))? }
// `if let PATTERN = EXPR` / `while let PATTERN = EXPR`
let_cond    = { K_let ~ pattern ~ "=" ~ expr }
match_expr  = { K_match ~ expr ~ "{" ~ sepc* ~ (match_arm ~ (sepc+ ~ match_arm)*)? ~ sepc* ~ "}" }
match_arm   = { pattern ~ guard? ~ "=>" ~ expr }
guard       = { K_if ~ expr }
while_expr  = { K_while ~ (let_cond | expr) ~ block }
for_expr    = { K_for ~ pattern ~ K_in ~ expr ~ block }
loop_expr   = { K_loop ~ block }
system_expr = { K_system ~ "{" ~ nls ~ (system_entry ~ (csep ~ system_entry)*)? ~ trail ~ "}" }
system_entry = { label ~ ":" ~ expr }
pipeline_expr = { K_pipeline ~ "{" ~ nls ~ (expr ~ (csep ~ expr)*)? ~ trail ~ "}" }
map_lit     = { K_map ~ "{" ~ nls ~ (map_entry ~ (csep ~ map_entry)*)? ~ trail ~ "}" }
map_entry   = { expr ~ "=>" ~ expr }
set_lit     = { K_set ~ "{" ~ nls ~ (expr ~ (csep ~ expr)*)? ~ trail ~ "}" }
ref_expr    = { K_ref ~ "(" ~ symbol ~ ")" }
unsafe_expr = { K_unsafe ~ block }
return_expr = { K_return ~ expr? }
break_expr  = { K_break ~ expr? }
continue_expr = { K_continue }

// ---------------------------------------------------------------- patterns
pattern      = { discard_pat | literal_pat | unit_pat | tuple_pat | paren_pat | record_pat | variant_pat | bind_pat }
discard_pat  = { discard }
literal_pat  = { neg_op? ~ (float | int) | duration | raw_string | string | char_lit | symbol | bool_lit }
unit_pat     = { "(" ~ ")" }
paren_pat    = { "(" ~ pattern ~ ")" }
tuple_pat    = { "(" ~ pattern ~ "," ~ (pattern ~ ("," ~ pattern)*)? ~ ","? ~ ")" }
record_pat   = { "{" ~ nls ~ (pat_field ~ (csep ~ pat_field)* ~ (csep ~ rest_pat)? | rest_pat)? ~ trail ~ "}" }
pat_field    = { label ~ (":" ~ pattern)? }
rest_pat     = { ".." }
variant_pat  = { variant_type? ~ "." ~ member ~ variant_args? }
variant_type = { (value_ident ~ ".")* ~ type_ident }
variant_args = { "(" ~ (pattern ~ ("," ~ pattern)* ~ ","?)? ~ ")" }
bind_pat     = { name }

// ---------------------------------------------------------------- keywords
K_import = _{ &kw_import ~ "import" }
kw_import = @{ "import" ~ !ident_char }
K_as = _{ &kw_as ~ "as" }
kw_as = @{ "as" ~ !ident_char }
K_type = _{ &kw_type ~ "type" }
kw_type = @{ "type" ~ !ident_char }
K_struct = _{ &kw_struct ~ "struct" }
kw_struct = @{ "struct" ~ !ident_char }
K_enum = _{ &kw_enum ~ "enum" }
kw_enum = @{ "enum" ~ !ident_char }
K_protocol = _{ &kw_protocol ~ "protocol" }
kw_protocol = @{ "protocol" ~ !ident_char }
K_impl = _{ &kw_impl ~ "impl" }
kw_impl = @{ "impl" ~ !ident_char }
K_for = _{ &kw_for ~ "for" }
kw_for = @{ "for" ~ !ident_char }
K_where = _{ &kw_where ~ "where" }
kw_where = @{ "where" ~ !ident_char }
K_fn = _{ &kw_fn ~ "fn" }
kw_fn = @{ "fn" ~ !ident_char }
K_if = _{ &kw_if ~ "if" }
kw_if = @{ "if" ~ !ident_char }
K_else = _{ &kw_else ~ "else" }
kw_else = @{ "else" ~ !ident_char }
K_match = _{ &kw_match ~ "match" }
kw_match = @{ "match" ~ !ident_char }
K_while = _{ &kw_while ~ "while" }
kw_while = @{ "while" ~ !ident_char }
K_loop = _{ &kw_loop ~ "loop" }
K_let = _{ "let" ~ !ident_char }
kw_loop = @{ "loop" ~ !ident_char }
K_in = _{ &kw_in ~ "in" }
kw_in = @{ "in" ~ !ident_char }
K_use = _{ &kw_use ~ "use" }
kw_use = @{ "use" ~ !ident_char }
K_unsafe = _{ &kw_unsafe ~ "unsafe" }
kw_unsafe = @{ "unsafe" ~ !ident_char }
K_extern = _{ &kw_extern ~ "extern" }
kw_extern = @{ "extern" ~ !ident_char }
K_dyn = _{ &kw_dyn ~ "dyn" }
kw_dyn = @{ "dyn" ~ !ident_char }
K_derive = _{ &kw_derive ~ "derive" }
kw_derive = @{ "derive" ~ !ident_char }
K_repr = _{ &kw_repr ~ "repr" }
kw_repr = @{ "repr" ~ !ident_char }
K_system = _{ &kw_system ~ "system" }
kw_system = @{ "system" ~ !ident_char }
K_pipeline = _{ &kw_pipeline ~ "pipeline" }
kw_pipeline = @{ "pipeline" ~ !ident_char }
K_map = _{ &kw_map ~ "map" }
kw_map = @{ "map" ~ !ident_char }
K_set = _{ &kw_set ~ "set" }
kw_set = @{ "set" ~ !ident_char }
K_ref = _{ &kw_ref ~ "ref" }
kw_ref = @{ "ref" ~ !ident_char }
K_return = _{ &kw_return ~ "return" }
kw_return = @{ "return" ~ !ident_char }
K_break = _{ &kw_break ~ "break" }
kw_break = @{ "break" ~ !ident_char }
K_continue = _{ &kw_continue ~ "continue" }
kw_continue = @{ "continue" ~ !ident_char }
