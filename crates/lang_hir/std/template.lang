// Templates in Jinja syntax (`{{ value }}`, `{% for x in xs %}`, `{% if %}`,
// filters such as `upper` and `join`, `{% include %}`, `{% extends %}`):
// a template renders a value (any `Codec` value, seen through its
// schema). HTML rendering escapes values; a misspelled name is an error,
// not empty output. The `lang_template` native module (minijinja)
// renders.

import std.codec
import std.native

/// A template that does not parse, or names something the value lacks.
pub struct Error {
    pub message: String,
}

impl Display for Error {
    fn display(self: &Self) -> String { self.message }
}

extern "native lang_template.render" fn t_render(text: String, context: Data, html: Bool) -> Result<String, Error>
extern "native lang_template.compile" fn t_compile(templates: Map<String, String>, html: Bool) -> Result<native.Handle, Error>
extern "native lang_template.render_named" fn t_render_named(set: native.Handle, name: String, context: Data) -> Result<String, Error>

/// Render `text` with `value` (its fields are the template's names).
pub fn render<T>(text: String, value: T) -> Result<String, Error> where T: Codec { t_render(text, codec.to_data(value), false) }

/// `render`, escaping values for HTML (`|safe` marks trusted markup).
pub fn render_html<T>(text: String, value: T) -> Result<String, Error> where T: Codec { t_render(text, codec.to_data(value), true) }

/// Named templates compiled once, which may include and extend each other.
pub struct Templates {
    handle: native.Handle,
}

/// Compile `templates` (name to text).
pub fn compile(templates: Map<String, String>) -> Result<Templates, Error> {
    let h = t_compile(templates, false)?
    ok({ handle: h })
}

/// `compile`, escaping values for HTML.
pub fn compile_html(templates: Map<String, String>) -> Result<Templates, Error> {
    let h = t_compile(templates, true)?
    ok({ handle: h })
}

impl Templates {
    /// Render the template `name` with `value`.
    pub fn render<T>(self: &Self, name: String, value: T) -> Result<String, Error> where T: Codec {
        t_render_named(self.handle, name, codec.to_data(value))
    }
}
