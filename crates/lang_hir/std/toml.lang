// TOML documents, as `Data` or typed values (records decoded by their
// schema, as `std.codec` decodes JSON). The `lang_formats` native module
// does the parsing.

import std.codec

/// A document that does not parse or encode, or does not fit the type.
pub struct Error {
    pub message: String,
}

impl Display for Error {
    fn display(self: &Self) -> String { self.message }
}

extern "native lang_formats.toml_parse" fn toml_parse(text: String) -> Result<Data, Error>
extern "native lang_formats.toml_encode" fn toml_encode(document: Data) -> Result<String, Error>

/// The document `text` as `Data`.
pub fn parse(text: String) -> Result<Data, Error> { toml_parse(text) }

/// The document `text` as a `T`.
pub fn decode<T>(text: String) -> Result<T, Error> where T: Codec {
    match codec.from_data<T>(toml_parse(text)?) {
        .ok(v) => ok(v),
        .err(e) => err({ message: $"{e}" }),
    }
}

/// `value` as a document.
pub fn encode<T>(value: T) -> Result<String, Error> where T: Codec { toml_encode(codec.to_data(value)) }
