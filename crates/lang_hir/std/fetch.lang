// Outbound HTTP(S) requests, run on the blocking pool (the calling task
// parks). Every status is a reply, not an error. `get`/`post`/... and
// `Client` read text bodies and follow no redirects; `send` takes any
// `Request` (method, headers, a byte body, redirects to follow, a body
// limit) and gives a `Response` with a byte body and JSON helpers.

import std.io
import std.time
import std.codec

pub type Reply = { status: Int, headers: List<(String, String)>, body: String }

// the `lang_fetch` native module (crates/lang_fetch)
extern "native lang_fetch.origin" fn fetch_origin(url: String) -> Result<String, io.Error>
extern "native lang_fetch.join" fn fetch_join(origin: String, path: String) -> Result<String, io.Error>
extern "native lang_fetch.send" fn fetch_send(method: String, url: String, headers: Map<String, String>, body: Bytes, timeout_ms: Int, max_redirects: Int, max_body_bytes: Int) -> Result<Response, io.Error> !{Io, Wait}
extern "intrinsic" fn text_to_bytes(text: String) -> Bytes
extern "intrinsic" fn text_from_bytes(bytes: Bytes) -> Result<String, String>
extern "native lang_fetch.request" fn fetch_request(method: String, url: String, body: String, content_type: String, timeout_ms: Int) -> Result<Reply, io.Error> !{Io, Wait}

/// `GET url` (30 s limit).
pub fn get(url: String) -> Result<Reply, io.Error> !{Io, Wait} { fetch_request("GET", url, "", "", 30000) }

/// `POST url` with a body of `content_type` (30 s limit).
pub fn post(url: String, body: String, content_type: String) -> Result<Reply, io.Error> !{Io, Wait} {
    fetch_request("POST", url, body, content_type, 30000)
}

/// Authority to make requests to one origin (`scheme://host[:port]`), and
/// no other: request paths must start with a single `/`. A capability the
/// entry module of a restricted project can hand out.
pub struct Client {
    origin: String,
    timeout_ms: Int,
}

/// A client for `base`, an `http` or `https` origin.
pub fn client(base: String) -> Result<Client, io.Error> !{Io} {
    let c: Client = { origin: fetch_origin(base)?, timeout_ms: 30000 }
    ok(c)
}

impl Client {
    /// The origin it may reach.
    pub fn origin(self: &Self) -> String { self.origin }
    /// The same client with another time limit per request.
    pub fn timeout(self: &Self, limit: Duration) -> Client {
        let c: Client = { origin: self.origin, timeout_ms: time.as_millis(limit) }
        c
    }
    pub fn get(self: &Self, path: String) -> Result<Reply, io.Error> !{Io, Wait} {
        fetch_request("GET", fetch_join(self.origin, path)?, "", "", self.timeout_ms)
    }
    pub fn delete(self: &Self, path: String) -> Result<Reply, io.Error> !{Io, Wait} {
        fetch_request("DELETE", fetch_join(self.origin, path)?, "", "", self.timeout_ms)
    }
    pub fn post(self: &Self, path: String, body: String, content_type: String) -> Result<Reply, io.Error> !{Io, Wait} {
        fetch_request("POST", fetch_join(self.origin, path)?, body, content_type, self.timeout_ms)
    }
    pub fn put(self: &Self, path: String, body: String, content_type: String) -> Result<Reply, io.Error> !{Io, Wait} {
        fetch_request("PUT", fetch_join(self.origin, path)?, body, content_type, self.timeout_ms)
    }
}

// ---------------------------------------------------------------- any request

/// A request: any method, headers, a byte body, a time limit, how many
/// redirects to follow (none by default), and the largest reply body to
/// read (16 MiB by default; more is `:io/too_large`).
pub type Request = {
    method: String,
    url: String,
    headers: Map<String, String>,
    body: Bytes,
    timeout_ms: Int,
    max_redirects: Int,
    max_body_bytes: Int,
}

/// A reply: every status is one (not an error); the body is bytes, and
/// `url` is where it came from after any redirects.
pub struct Response {
    pub status: Int,
    pub headers: List<(String, String)>,
    pub body: Bytes,
    pub url: String,
}

impl Response {
    /// The first value of a header (names compare case-insensitively).
    pub fn header(self: &Self, name: String) -> Option<String> {
        let want = lower(name)
        for (k, v) in self.headers {
            if lower(k) == want {
                return Option.some(v)
            }
        }
        Option.none
    }
    /// The body as UTF-8 text.
    pub fn text(self: &Self) -> Result<String, io.Error> {
        match text_from_bytes(self.body) {
            .ok(t) => ok(t),
            .err(e) => err(io_error(:io/invalid_data, $"{self.url}: the body is not UTF-8 ({e})")),
        }
    }
    /// The body decoded from JSON as `T`.
    pub fn json<T>(self: &Self) -> Result<T, io.Error> where T: Codec {
        match codec.decode<T>(self.body) {
            .ok(v) => ok(v),
            .err(e) => err(io_error(:io/invalid_data, $"{self.url}: {e.message}")),
        }
    }
    /// Whether the status is 2xx.
    pub fn is_success(self: &Self) -> Bool { self.status >= 200 && self.status < 300 }
}

extern "intrinsic" fn text_to_lower(text: String) -> String
fn lower(s: String) -> String { text_to_lower(s) }

fn io_error(kind: Symbol, message: String) -> io.Error { { kind, message } }

/// A request of `method` to `url` with the defaults (no body, 30 s, no
/// redirects followed, 16 MiB).
pub fn request(method: String, url: String) -> Request {
    { method, url, headers: map {}, body: text_to_bytes(""), timeout_ms: 30000, max_redirects: 0, max_body_bytes: 16777216 }
}

/// Send `r`.
pub fn send(r: Request) -> Result<Response, io.Error> !{Io, Wait} {
    fetch_send(r.method, r.url, r.headers, r.body, r.timeout_ms, r.max_redirects, r.max_body_bytes)
}

/// `GET url` and decode a 2xx reply's JSON body as `T` (another status
/// is an `:io/http_status` error).
pub fn get_json<T>(url: String) -> Result<T, io.Error> !{Io, Wait} where T: Codec {
    let r = send({ ..request("GET", url), headers: map { "accept" => "application/json" } })?
    expect_json(r)
}

/// `POST url` with `value` as JSON, decoding a 2xx reply's JSON as `R`.
pub fn post_json<T, R>(url: String, value: T) -> Result<R, io.Error> !{Io, Wait} where T: Codec, R: Codec {
    let r = send({ ..request("POST", url), headers: map { "content-type" => "application/json", "accept" => "application/json" }, body: codec.encode(value) })?
    expect_json(r)
}

fn expect_json<R>(r: Response) -> Result<R, io.Error> where R: Codec {
    if !r.is_success() {
        return err(io_error(:io/http_status, $"{r.url}: status {r.status}"))
    }
    r.json<R>()
}

impl Client {
    /// Send `r` to `path` on this client's origin (its own `url` is
    /// replaced); redirects are never followed, as they could leave the
    /// origin.
    pub fn send(self: &Self, path: String, r: Request) -> Result<Response, io.Error> !{Io, Wait} {
        let url = fetch_join(self.origin, path)?
        fetch_send(r.method, url, r.headers, r.body, self.timeout_ms, 0, r.max_body_bytes)
    }
}
