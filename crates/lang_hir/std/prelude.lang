/// Explicit dynamic data.
pub enum Data {
    null,
    bool(value: Bool),
    int(value: Int),
    float(value: Float),
    string(value: String),
    list(items: List<Data>),
    object(fields: Map<String, Data>),
}

pub protocol Display {
    fn display(self: &Self) -> String
}

/// An expected failure: display text, a stable machine-readable code, an
/// optional cause (the causal chain), and structured details.
pub protocol Error: Display {
    /// Stable code: by default the enum variant (or type) name.
    fn code(self: &Self) -> Symbol { error_code(self) }
    /// The error this one wraps, if any (`derive(Error)` reports the payload
    /// of a single-field variant that is itself an `Error`).
    fn cause(self: &Self) -> Option<dyn Error> { Option.none }
    /// Structured diagnostic details (by default, none).
    fn details(self: &Self) -> Data { error_details(self) }
}

extern "intrinsic" fn error_code<T>(value: T) -> Symbol
extern "intrinsic" fn error_details<T>(value: T) -> Data

/// The causal chain of an error, outermost first.
pub fn error_chain(e: dyn Error) -> List<String> {
    var out = [e.display()]
    var cur = e.cause()
    loop {
        match cur {
            .some(c) => {
                out = out.append(c.display())
                cur = c.cause()
            },
            .none => { break },
        }
    }
    out
}

pub protocol From<T> {
    fn from(value: T) -> Self
}

/// Checked conversion: `Target.try_from(value)` (see `std.num`).
pub protocol TryFrom<T> {
    fn try_from(value: T) -> Result<Self, NumericError>
}

/// Failure of a checked arithmetic helper or numeric conversion.
pub enum NumericError {
    overflow,
    division_by_zero,
    out_of_range,
}

impl Display for NumericError {
    fn display(self: &Self) -> String {
        match self {
            .overflow => "arithmetic overflow",
            .division_by_zero => "division by zero",
            .out_of_range => "value out of range for the target type",
        }
    }
}

impl Error for NumericError {}

/// Total equality (reflexive): floats are excluded, having only IEEE
/// `PartialEq`.
pub protocol Eq {}
/// Equality as `==` computes it (IEEE for floats: `nan != nan`).
pub protocol PartialEq {}
/// Ordering as `<` computes it (IEEE for floats).
pub protocol PartialOrd {}
pub protocol Hash {}
pub protocol Codec {}
pub protocol Transfer {}
/// Safely duplicable and usable by several tasks: neither affine nor
/// task-confined (a compiler-checked capability, like `Transfer`).
pub protocol Share {}
/// Carries no value bound to a scope region (pools, transactions, request
/// scopes, ...): may outlive the scope that produced it (compiler-checked).
pub protocol Unscoped {}
/// Any integer type (`I8`..`U64`).
pub protocol Integer {}

/// Kind markers usable as bounds (`Rest: Row`, `S: Scope`, `E: Effect`).
pub protocol Row {}
pub protocol Scope {}
pub protocol Effect {}

