// Conversions involving floats. A float converts to an integer only when it
// is finite, integral, and in range (no silent truncation); an integer
// converts to a float losslessly (`From`) when every value is exact, and
// checked (`TryFrom`) otherwise.
extern "intrinsic" fn num_fits<A, B>(value: A) -> Bool

impl TryFrom<F32> for I8 {
    fn try_from(value: F32) -> Result<I8, NumericError> {
        if num_fits<F32, I8>(value) { ok(convert_lossy(value)) } else { err(NumericError.out_of_range) }
    }
}

impl TryFrom<F32> for I16 {
    fn try_from(value: F32) -> Result<I16, NumericError> {
