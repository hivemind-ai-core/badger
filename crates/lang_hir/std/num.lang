// Numeric conversions and explicit checked/wrapping arithmetic.
//
// `Target.from(value)` exists only for lossless conversions;
// `Target.try_from(value)` checks the value fits. Ordinary operators are
// checked (overflow is a task defect); `checked_*` helpers return `Result`
// and `wrapping_*` helpers compute modulo 2^bits.
// Generated by a script: one block per integer type.

extern "intrinsic" fn convert_lossy<A, B>(value: A) -> B
extern "intrinsic" fn int_fits<A, B>(value: A) -> Bool
extern "intrinsic" fn add_overflows<T>(a: T, b: T) -> Bool
extern "intrinsic" fn sub_overflows<T>(a: T, b: T) -> Bool
extern "intrinsic" fn mul_overflows<T>(a: T, b: T) -> Bool
extern "intrinsic" fn div_overflows<T>(a: T, b: T) -> Bool
extern "intrinsic" fn rem_overflows<T>(a: T, b: T) -> Bool
extern "intrinsic" fn wrapping_add<T>(a: T, b: T) -> T
extern "intrinsic" fn wrapping_sub<T>(a: T, b: T) -> T
extern "intrinsic" fn wrapping_mul<T>(a: T, b: T) -> T

