impl I8 {
    pub fn checked_add(self: &Self, other: I8) -> Result<I8, NumericError> {
        if add_overflows(self, other) { err(NumericError.overflow) } else { ok(wrapping_add(self, other)) }
    }
    pub fn checked_sub(self: &Self, other: I8) -> Result<I8, NumericError> {
        if sub_overflows(self, other) { err(NumericError.overflow) } else { ok(wrapping_sub(self, other)) }
    }
    pub fn checked_mul(self: &Self, other: I8) -> Result<I8, NumericError> {
        if mul_overflows(self, other) { err(NumericError.overflow) } else { ok(wrapping_mul(self, other)) }
    }
    pub fn checked_div(self: &Self, other: I8) -> Result<I8, NumericError> {
        if other == 0 { err(NumericError.division_by_zero) } else if div_overflows(self, other) { err(NumericError.overflow) } else { ok(self / other) }
    }
    pub fn checked_rem(self: &Self, other: I8) -> Result<I8, NumericError> {
        if other == 0 { err(NumericError.division_by_zero) } else { ok(self % other) }
    }
    pub fn wrapping_add(self: &Self, other: I8) -> I8 { wrapping_add(self, other) }
    pub fn wrapping_sub(self: &Self, other: I8) -> I8 { wrapping_sub(self, other) }
    pub fn wrapping_mul(self: &Self, other: I8) -> I8 { wrapping_mul(self, other) }
    pub fn abs(self: &Self) -> I8 { if self < 0 { -self } else { self } }
    pub fn min(self: &Self, other: I8) -> I8 { if self < other { self } else { other } }
    pub fn max(self: &Self, other: I8) -> I8 { if self > other { self } else { other } }
}

