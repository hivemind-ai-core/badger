// Process environment.

extern "intrinsic" fn env_args() -> List<String>
extern "intrinsic" fn env_get(name: String) -> Option<String>

/// Program arguments, excluding the executable.
pub fn args() -> List<String> !{Io} { env_args() }

pub fn get(name: String) -> Option<String> !{Io} { env_get(name) }
