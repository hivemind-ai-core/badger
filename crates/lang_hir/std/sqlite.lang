// Embedded SQLite storage with scoped transactions.

import std.prelude

import std.system
import std.codec

pub struct Error {
    pub code: Symbol,
    pub message: String,
    /// The callback error a failed rollback happened after, if any.
    pub cause: Option<dyn prelude.Error>,
}

impl Display for Error {
    fn display(self: &Self) -> String { $"{self.code}: {self.message}" }
}

impl prelude.Error for Error {
    fn code(self: &Self) -> Symbol { self.code }
    fn cause(self: &Self) -> Option<dyn prelude.Error> { self.cause }
}

/// A shareable connection pool, scoped to region `S` (the system or
/// callback that opened it). The region may be elided in annotations:
/// `sqlite.Pool` means `sqlite.Pool<_>`.
pub extern type Pool<S: Scope>
extern type TxHandle
pub extern type ConnRef

/// A task-confined transaction, branded with its callback's region.
pub struct Tx<S> {
    handle: TxHandle,
}

/// Things SQL can run against: pools and transactions.
pub protocol Connection {
    fn connection(self: &Self) -> ConnRef
}

extern "intrinsic" fn identity<A, B>(value: A) -> B
extern "intrinsic" fn sql_open<S>(path: String) -> Result<Pool<S>, Error>
extern "intrinsic" fn sql_close<S>(pool: Pool<S>) -> Unit
extern "intrinsic" fn sql_is_closed<S>(pool: Pool<S>) -> Bool
extern "intrinsic" fn sql_execute(conn: ConnRef, sql: String, params: List<Data>) -> Result<Int, Error>
extern "intrinsic" fn sql_query(conn: ConnRef, sql: String, params: List<Data>) -> Result<List<Data>, Error>
extern "intrinsic" fn sql_query_one(conn: ConnRef, sql: String, params: List<Data>) -> Result<Data, Error>
extern "intrinsic" fn sql_begin<S>(pool: Pool<S>) -> Result<TxHandle, Error>
extern "intrinsic" fn sql_finish(tx: TxHandle, commit: Bool) -> Result<Unit, Error>
extern "intrinsic" fn tx_guard(tx: TxHandle) -> Int
extern "intrinsic" fn tx_unguard(handle: Int, tx: TxHandle) -> Unit

impl<S> Connection for Pool<S> {
    fn connection(self: &Self) -> ConnRef { identity(self) }
}

impl<S> Connection for Tx<S> {
    fn connection(self: &Self) -> ConnRef { identity(self.handle) }
}

pub fn open<S: Scope>(path: String) -> Result<Pool<S>, Error> !{Io, Wait} { sql_open(path) }
pub fn close<S: Scope>(pool: Pool<S>) -> Unit { sql_close(pool) }
pub fn is_closed<S: Scope>(pool: Pool<S>) -> Bool { sql_is_closed(pool) }

/// Execute a statement with bound parameters; returns the changed row count.
pub fn execute<C>(conn: C, sql: String, params: List<Data>) -> Result<Int, Error> !{Io, Wait} where C: Connection {
    sql_execute(conn.connection(), sql, params)
}

pub fn query<C>(conn: C, sql: String, params: List<Data>) -> Result<List<Data>, Error> !{Io, Wait} where C: Connection {
    sql_query(conn.connection(), sql, params)
}

/// Exactly one row as `Data`; zero or several rows are an error.
pub fn query_one<C>(conn: C, sql: String, params: List<Data>) -> Result<Data, Error> !{Io, Wait} where C: Connection {
    sql_query_one(conn.connection(), sql, params)
}

fn decode_row<T>(row: Data) -> Result<T, Error> where T: Codec {
    match codec.from_data<T>(row) {
        .ok(v) => ok(v),
        .err(e) => err({ code: :sqlite/decode, message: $"a row does not decode: {e}", cause: Option.none }),
    }
}

/// Rows as `T`, a record whose fields are named like the result's columns
/// (an `Option` field for a column that can be NULL). In a project with
/// `[database] schema`, `lang check` checks a literal statement's columns
/// against `T`.
pub fn query_as<T, C>(conn: C, sql: String, params: List<Data>) -> Result<List<T>, Error> !{Io, Wait} where T: Codec, C: Connection {
    var out: List<T> = []
    for row in sql_query(conn.connection(), sql, params)? {
        out = out.append(decode_row(row)?)
    }
    ok(out)
}

/// Exactly one row, as `T` (see `query_as`).
pub fn query_one_as<T, C>(conn: C, sql: String, params: List<Data>) -> Result<T, Error> !{Io, Wait} where T: Codec, C: Connection {
    decode_row(sql_query_one(conn.connection(), sql, params)?)
}

/// Run `body` in a transaction: commit after `ok`, roll back after `err`,
/// defect, or cancellation. A failed begin or commit is returned even when
/// the body succeeded. A failed rollback after a body error is returned as a
/// `:sqlite/rollback_failed` error whose `cause` is the body's error, so
/// neither failure is discarded.
pub fn transaction<P: Scope, R, E>(pool: Pool<P>, body: for<S: Scope> fn(Tx<S>) -> Result<R, E>) -> Result<R, E> !{Io, Wait} where E: From<Error>, E: prelude.Error {
    match sql_begin(pool) {
        .err(e) => err(E.from(e)),
        .ok(h) => {
            let guard = tx_guard(h)
            let r = body({ handle: h })
            tx_unguard(guard, h)
            match r {
                .ok(v) => match sql_finish(h, true) {
                    .ok(_) => ok(v),
                    .err(e) => err(E.from(e)),
                },
                .err(e) => match sql_finish(h, false) {
                    .ok(_) => err(e),
                    .err(re) => {
                        let cause: dyn prelude.Error = e
                        let failure: Error = { code: :sqlite/rollback_failed, message: $"rollback failed: {re.message}", cause: Option.some(cause) }
                        err(E.from(failure))
                    },
                },
            }
        },
    }
}

fn pool_init<S: Scope>(scope: system.InitScope, config: { path: String }) -> Result<Pool<S>, Error> {
    let p = open(config.path)?
    scope.on_halt(fn() -> Result<Unit, Error> {
        close(p)
        ok(())
    })
    ok(p)
}

/// Provider of a pool for `{path: String}`.
pub let pool = system.provider({ name: :sqlite/pool, init: pool_init })
