// Typed routing descriptions: method/path patterns, stable names, body and
// reply schemas, and handlers. Tables are validated (conflicts, malformed
// patterns, duplicate names and parameters) before serving; URLs and
// OpenAPI documents are derived from the same descriptions.

import std.codec
import std.http
import std.list
import std.map
import std.schema
import std.text

pub type Params = Map<String, String>

pub type Route = {
    method: Symbol,
    path: String,
    name: Symbol,
    /// A one-line description (OpenAPI `summary`).
    summary: Option<String>,
    /// JSON Schemas of the path parameters, request body, and reply, when
    /// the route is typed.
    params: Option<String>,
    body: Option<String>,
    reply: Option<String>,
    run: fn(http.Request, Params) -> http.Response !{Io, Wait, State, Foreign},
}

pub struct RouteError {
    pub message: String,
}

impl Display for RouteError {
    fn display(self: &Self) -> String { self.message }
}

impl Error for RouteError {}

impl HttpStatus for RouteError {}

extern "intrinsic" fn trace_event<T>(name: Symbol, data: T) -> Unit

fn json_reply<T>(status: Int, value: T) -> http.Response where T: Codec {
    { status, headers: map { "content-type" => "application/json" }, body: codec.encode(value) }
}

fn route<E>(method: Symbol, path: String, name: Symbol, handler: fn(http.Request, Params) -> Result<http.Response, E>) -> Route where E: Display, E: HttpStatus {
    {
        method,
        path,
        name,
        summary: Option.none,
        params: Option.none,
        body: Option.none,
        reply: Option.none,
        run: fn(request, params) {
            match handler(request, params) {
                .ok(r) => r,
                .err(e) => {
                    trace_event(#route/handler_error, { route: name, message: e.display() })
                    http.error_reply(e)
                },
            }
        },
    }
}

pub fn get<E>(path: String, name: Symbol, handler: fn(http.Request, Params) -> Result<http.Response, E>) -> Route where E: Display, E: HttpStatus {
    route(#get, path, name, handler)
}

pub fn post<E>(path: String, name: Symbol, handler: fn(http.Request, Params) -> Result<http.Response, E>) -> Route where E: Display, E: HttpStatus {
    route(#post, path, name, handler)
}

pub fn put<E>(path: String, name: Symbol, handler: fn(http.Request, Params) -> Result<http.Response, E>) -> Route where E: Display, E: HttpStatus {
    route(#put, path, name, handler)
}

pub fn delete<E>(path: String, name: Symbol, handler: fn(http.Request, Params) -> Result<http.Response, E>) -> Route where E: Display, E: HttpStatus {
    route(#delete, path, name, handler)
}

/// A typed JSON route: the request body is validated against `B`'s schema
/// (a failure is a structured 400 reply naming the input path) and the
/// handler's `(status, reply)` is encoded with `R`'s schema. Both schemas
/// are part of the description (OpenAPI).
pub fn json<B, R, E>(method: Symbol, path: String, name: Symbol, handler: fn(http.Request, Params, B) -> Result<(Int, R), E>) -> Route where B: Codec, R: Codec, E: Display, E: HttpStatus {
    {
        method,
        path,
        name,
        summary: Option.none,
        params: Option.none,
        body: Option.some(schema.json_schema(schema.of<B>())),
        reply: Option.some(schema.json_schema(schema.of<R>())),
        run: fn(request, params) {
            match codec.decode<B>(request.body) {
                .err(e) => json_reply(400, { error: "route/invalid_body", path: e.path, message: e.message }),
                .ok(b) => match handler(request, params, b) {
                    .ok((status, reply)) => json_reply(status, reply),
                    .err(e) => {
                        trace_event(#route/handler_error, { route: name, message: e.display() })
                        http.error_reply(e)
                    },
                },
            }
        },
    }
}

/// A typed JSON route without a request body.
pub fn json_get<R, E>(path: String, name: Symbol, handler: fn(http.Request, Params) -> Result<(Int, R), E>) -> Route where R: Codec, E: Display, E: HttpStatus {
    {
        method: #get,
        path,
        name,
        summary: Option.none,
        params: Option.none,
        body: Option.none,
        reply: Option.some(schema.json_schema(schema.of<R>())),
        run: fn(request, params) {
            match handler(request, params) {
                .ok((status, reply)) => json_reply(status, reply),
                .err(e) => {
                    trace_event(#route/handler_error, { route: name, message: e.display() })
                    http.error_reply(e)
                },
            }
        },
    }
}

extern "intrinsic" fn params_decode<P>(params: Params) -> Result<P, codec.DecodeError>
extern "intrinsic" fn data_field_names(schema: String) -> List<String>

/// A fully typed route: path parameters decode into `P` (a record whose
/// fields are the pattern's `:name`s; numbers and booleans are parsed), the
/// body into `B`, and the reply encodes `R`. Invalid parameters or bodies are
/// structured 400 replies; all three schemas are part of the description.
pub fn typed<P, B, R, E>(method: Symbol, path: String, name: Symbol, handler: fn(http.Request, P, B) -> Result<(Int, R), E>) -> Route where P: Codec, B: Codec, R: Codec, E: Display, E: HttpStatus {
    {
        method,
        path,
        name,
        summary: Option.none,
        params: Option.some(schema.json_schema(schema.of<P>())),
        body: if method == #get || method == #delete { Option.none } else { Option.some(schema.json_schema(schema.of<B>())) },
        reply: Option.some(schema.json_schema(schema.of<R>())),
        run: fn(request, raw) {
            match params_decode<P>(raw) {
                .err(e) => json_reply(400, { error: "route/invalid_path", path: e.path, message: e.message }),
                .ok(p) => {
                    let body = if method == #get || method == #delete { codec.decode<B>(codec.encode({})) } else { codec.decode<B>(request.body) }
                    match body {
                        .err(e) => json_reply(400, { error: "route/invalid_body", path: e.path, message: e.message }),
                        .ok(b) => match handler(request, p, b) {
                            .ok((status, reply)) => json_reply(status, reply),
                            .err(e) => {
                                trace_event(#route/handler_error, { route: name, message: e.display() })
                                http.error_reply(e)
                            },
                        },
                    }
                },
            }
        },
    }
}

fn segments(path: String) -> List<String> {
    list.filter(text.split(path, "/"), fn(s) { !text.is_empty(s) })
}

/// The URI without its fragment (`#...`): a fragment is not part of the
/// path or of the query.
fn strip_fragment(uri: String) -> String {
    match text.index_of(uri, "#") {
        .some(i) => text.slice(uri, 0, i).unwrap_or(uri),
        .none => uri,
    }
}

/// The path of a request URI, without its query string: `/search?q=bad`
/// becomes `/search`.
pub fn path_of(uri: String) -> String {
    let uri = strip_fragment(uri)
    match text.index_of(uri, "?") {
        .some(i) => text.slice(uri, 0, i).unwrap_or(uri),
        .none => uri,
    }
}

/// The query string of a request URI (without the `?`), if it has one.
pub fn query_of(uri: String) -> Option<String> {
    let uri = strip_fragment(uri)
    match text.index_of(uri, "?") {
        .some(i) => Option.some(text.slice(uri, i + 1, text.len(uri)).unwrap_or("")),
        .none => Option.none,
    }
}

/// The query parameters of a request URI (`?a=1&b=2`): the names and
/// values are percent-decoded. A parameter without a value (`?a`) has the
/// empty string as its value.
pub fn query_params(uri: String) -> Params {
    var out: Params = map.empty()
    match query_of(uri) {
        .some(query) => {
            for pair in text.split(query, "&") {
                if pair == "" {
                    continue
                }
                let (name, value) = match text.index_of(pair, "=") {
                    .some(i) => (text.slice(pair, 0, i).unwrap_or(""), text.slice(pair, i + 1, text.len(pair)).unwrap_or("")),
                    .none => (pair, ""),
                }
                out = map.insert(out, url_decode(name), url_decode(value))
            }
        },
        .none => (),
    }
    out
}

/// The query parameters of a request: `params.get("q")` for
/// `GET /search?q=bad`.
pub fn params(request: http.Request) -> Params { query_params(request.path) }

/// The `:name` parameters of a pattern, in order.
pub fn params_of(path: String) -> List<String> {
    list.map(list.filter(segments(path), fn(s) { text.starts_with(s, ":") }), fn(s) { text.replace(s, ":", "") })
}

/// Match a path against a pattern (`:name` segments capture).
fn match_path(pattern: String, path: String) -> Option<Params> {
    let ps = segments(pattern)
    let xs = segments(path)
    if list.len(ps) != list.len(xs) {
        return Option.none
    }
    var params: Params = map.empty()
    var i = 0
    while i < list.len(ps) {
        let p = ps[i]
        let x = xs[i]
        if text.starts_with(p, ":") {
            params = map.insert(params, text.replace(p, ":", ""), decode_segment(x))
        } else if p != x {
            return Option.none
        }
        i = i + 1
    }
    Option.some(params)
}

/// Whether two patterns can match the same path: same length, and every
/// segment pair is equal or involves a parameter.
fn overlap(a: String, b: String) -> Bool {
    let xs = segments(a)
    let ys = segments(b)
    if xs.len() != ys.len() {
        return false
    }
    var i = 0
    while i < xs.len() {
        let (x, y) = (xs[i], ys[i])
        if !text.starts_with(x, ":") && !text.starts_with(y, ":") && x != y {
            return false
        }
        i = i + 1
    }
    true
}

/// Check a route table: names unique and present, paths well formed,
/// parameters named and unique, methods known, no two routes matching the
/// same requests.
pub fn validate(routes: List<Route>) -> Result<Unit, RouteError> {
    var i = 0
    while i < list.len(routes) {
        let r = routes[i]
        if ![#get, #post, #put, #delete, #patch].contains(r.method) {
            return err({ message: $"route {r.name} has unknown method {r.method}" })
        }
        if !text.starts_with(r.path, "/") {
            return err({ message: $"route {r.name} path must start with /" })
        }
        let ps = params_of(r.path)
        // a typed route's parameter record names exactly the pattern's
        match r.params {
            .some(sch) => {
                let fields = data_field_names(sch)
                for f in fields {
                    if !ps.contains(f) {
                        return err({ message: $"route {r.name}: parameter field {f} is not in {r.path}" })
                    }
                }
                for q in ps {
                    if !fields.contains(q) {
                        return err({ message: $"route {r.name}: path parameter :{q} has no field in the parameter type" })
                    }
                }
            },
            .none => (),
        }
        var k = 0
        while k < list.len(ps) {
            if text.is_empty(ps[k]) {
                return err({ message: $"route {r.name} has an unnamed parameter in {r.path}" })
            }
            var m = 0
            while m < k {
                if ps[m] == ps[k] {
                    return err({ message: $"route {r.name} repeats parameter :{ps[k]}" })
                }
                m = m + 1
            }
            k = k + 1
        }
        var j = 0
        while j < i {
            let b = routes[j]
            if r.name == b.name {
                return err({ message: $"duplicate route name {r.name}" })
            }
            if r.method == b.method && overlap(r.path, b.path) {
                return err({ message: $"routes {b.name} and {r.name} conflict on {r.method} {r.path}" })
            }
            j = j + 1
        }
        i = i + 1
    }
    ok(())
}

/// Validate a route table and compile it into an HTTP handler.
pub fn table(routes: List<Route>) -> Result<http.Handler, RouteError> {
    validate(routes)?
    ok(http.handler(fn(request) -> Result<http.Response, RouteError> {
        for r in routes {
            if r.method == request.method {
                match match_path(r.path, path_of(request.path)) {
                    .some(params) => { return ok(r.run(request, with_query(params, request))) },
                    .none => (),
                }
            }
        }
        ok(json_reply(404, { error: "route/not_found" }))
    }))
}

/// The path parameters of a match with the request's query parameters
/// added: a path parameter wins over a query parameter of the same name.
fn with_query(params: Params, request: http.Request) -> Params {
    var out = query_params(request.path)
    for (name, value) in map.to_list(params) {
        out = map.insert(out, name, value)
    }
    out
}

/// Build the URL of a named route from its parameters. An unknown route,
/// a missing parameter, or an unexpected one is a structured error; values
/// are percent-encoded.
pub fn url(routes: List<Route>, name: Symbol, params: Params) -> Result<String, RouteError> {
    for r in routes {
        if r.name == name {
            let wanted = params_of(r.path)
            for (k, _) in map.to_list(params) {
                if !wanted.contains(k) {
                    return err({ message: $"route {name} has no parameter :{k}" })
                }
            }
            var parts: List<String> = []
            for s in segments(r.path) {
                if text.starts_with(s, ":") {
                    let key = text.replace(s, ":", "")
                    match map.get(params, key) {
                        .some(v) => { parts = parts.append(encode_segment(v)) },
                        .none => { return err({ message: $"route {name} needs parameter :{key}" }) },
                    }
                } else {
                    parts = parts.append(s)
                }
            }
            return ok($"/{text.join(parts, "/")}")
        }
    }
    err({ message: $"no route named {name}" })
}

extern "intrinsic" fn url_encode(s: String) -> String
extern "intrinsic" fn url_decode(s: String) -> String

fn encode_segment(s: String) -> String { url_encode(s) }
fn decode_segment(s: String) -> String { url_decode(s) }

fn json_text(s: String) -> String { codec.encode_text(s) }

extern "intrinsic" fn data_property_schemas(schema: String) -> Map<String, String>

fn param_schemas(s: Option<String>) -> Map<String, String> {
    match s {
        .some(x) => data_property_schemas(x),
        .none => map.empty(),
    }
}

/// An OpenAPI 3.1 document for the table, from the same descriptions:
/// operation ids are route names, path parameters come from the patterns,
/// and typed routes contribute their body/reply JSON Schemas.
pub fn openapi(routes: List<Route>, title: String, version: String) -> Result<String, RouteError> {
    validate(routes)?
    // group operations by OpenAPI path (`/orders/{id}`)
    var paths: List<(String, List<Route>)> = []
    for r in routes {
        let p = $"/{text.join(list.map(segments(r.path), fn(s) { if text.starts_with(s, ":") { $"{{{text.replace(s, ":", "")}}}" } else { s } }), "/")}"
        var found = false
        var next: List<(String, List<Route>)> = []
        for (q, rs) in paths {
            if q == p {
                next = next.append((q, rs.append(r)))
                found = true
            } else {
                next = next.append((q, rs))
            }
        }
        paths = if found { next } else { next.append((p, [r])) }
    }
    var out = $"{{\"openapi\":\"3.1.0\",\"info\":{{\"title\":{json_text(title)},\"version\":{json_text(version)}}},\"paths\":{{"
    var first_path = true
    for (p, rs) in paths {
        out = $"{out}{if first_path { "" } else { "," }}{json_text(p)}:{{"
        first_path = false
        var first_op = true
        for r in rs {
            let schemas = param_schemas(r.params)
            let params = list.map(params_of(r.path), fn(n) {
                let sch = schemas.get(n).unwrap_or("{\"type\":\"string\"}")
                $"{{\"name\":{json_text(n)},\"in\":\"path\",\"required\":true,\"schema\":{sch}}}"
            })
            let body = match r.body {
                .some(s) => $",\"requestBody\":{{\"required\":true,\"content\":{{\"application/json\":{{\"schema\":{s}}}}}}}",
                .none => "",
            }
            let reply = match r.reply {
                .some(s) => $"{{\"content\":{{\"application/json\":{{\"schema\":{s}}}}},\"description\":\"reply\"}}",
                .none => "{\"description\":\"reply\"}",
            }
            let summary = match r.summary {
                .some(s) => $",\"summary\":{json_text(s)}",
                .none => "",
            }
            out = $"{out}{if first_op { "" } else { "," }}\"{r.method}\":{{\"operationId\":{json_text($"{r.name}")}{summary},\"parameters\":[{text.join(params, ",")}]{body},\"responses\":{{\"default\":{reply}}}}}"
            first_op = false
        }
        out = $"{out}}}"
    }
    ok($"{out}}}}}")
}
