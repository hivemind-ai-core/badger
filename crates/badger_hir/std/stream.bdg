// Suspending input streams (e.g. from channels). Unlike `Seq`, pulling from
// a stream may wait, and a stream is consumed as it is read: a `for` loop
// that stops early leaves the rest readable. Closing a stream (`close`, or
// an operation that stops at an error) closes what it reads from, so a
// producer learns to stop.

import std.channel
import std.list

/// `Eff` is what pulling may do (and whether the stream captures task-local
/// state).
pub struct Stream<T, Eff: Effect> {
    pub next: fn() -> Option<T> !Eff,
    /// Stop reading: release the source (idempotent).
    pub close: fn() -> Unit !Eff,
}

/// A stream pulling from `next`, with nothing to release.
pub fn from_fn<T, Eff>(next: fn() -> Option<T> !Eff) -> Stream<T, Eff> {
    { next, close: fn() {} }
}

/// Messages from a receiver until it is closed and drained. Closing the
/// stream closes the receiver: further sends fail.
pub fn from_receiver<T>(r: channel.Receiver<T>) -> Stream<T, !{Wait}> {
    { next: fn() { r.recv() }, close: fn() { r.close() } }
}

/// The items of a list, in order.
pub fn from_list<T>(items: List<T>) -> Stream<T, !{State}> {
    let i = Atom.new(0)
    {
        next: fn() {
            let k = i.get()
            if k < items.len() {
                i.set(k + 1)
                items.get(k)
            } else {
                Option.none
            }
        },
        close: fn() { i.set(items.len()) },
    }
}

/// Stop reading `s` and release its source.
pub fn close<T, Eff>(s: Stream<T, Eff>) -> Unit { s.close() }

pub fn map<T, U, Eff>(s: Stream<T, Eff>, f: fn(T) -> U !Eff) -> Stream<U, Eff> {
    {
        next: fn() {
            match s.next() {
                .some(x) => Option.some(f(x)),
                .none => Option.none,
            }
        },
        close: s.close,
    }
}

pub fn filter<T, Eff>(s: Stream<T, Eff>, keep: fn(T) -> Bool !Eff) -> Stream<T, Eff> {
    {
        next: fn() -> Option<T> {
            loop {
                match s.next() {
                    .some(x) => if keep(x) { return Option.some(x) },
                    .none => { return Option.none },
                }
            }
        },
        close: s.close,
    }
}

/// `f`'s results that are `some`.
pub fn filter_map<T, U, Eff>(s: Stream<T, Eff>, f: fn(T) -> Option<U> !Eff) -> Stream<U, Eff> {
    {
        next: fn() -> Option<U> {
            loop {
                match s.next() {
                    .some(x) => match f(x) {
                        .some(y) => { return Option.some(y) },
                        .none => (),
                    },
                    .none => { return Option.none },
                }
            }
        },
        close: s.close,
    }
}

/// Each item with its position, from 0.
pub fn enumerate<T, Eff>(s: Stream<T, Eff>) -> Stream<(Int, T), !{State, Eff}> {
    let i = Atom.new(0)
    {
        next: fn() {
            match s.next() {
                .some(x) => {
                    let n = i.get()
                    i.set(n + 1)
                    Option.some((n, x))
                },
                .none => Option.none,
            }
        },
        close: fn() { s.close() },
    }
}

/// The running results of `f`, starting from `initial` (not itself
/// produced): `scan([1, 2, 3], 0, +)` is 1, 3, 6.
pub fn scan<T, A, Eff>(s: Stream<T, Eff>, initial: A, f: fn(A, T) -> A !Eff) -> Stream<A, !{State, Eff}> {
    let acc = Atom.new(initial)
    {
        next: fn() {
            match s.next() {
                .some(x) => {
                    let a = f(acc.get(), x)
                    acc.set(a)
                    Option.some(a)
                },
                .none => Option.none,
            }
        },
        close: fn() { s.close() },
    }
}

/// The first item `matches` accepts, reading no further (the stream is
/// closed when one is found).
pub fn find<T, Eff>(s: Stream<T, Eff>, matches: fn(T) -> Bool !Eff) -> Option<T> {
    loop {
        match s.next() {
            .some(x) => if matches(x) {
                s.close()
                return Option.some(x)
            },
            .none => { return Option.none },
        }
    }
}

/// At most `n` items; the rest of `s` stays readable.
pub fn take<T, Eff>(s: Stream<T, Eff>, n: Int) -> Stream<T, !{State, Eff}> {
    let left = Atom.new(n)
    {
        next: fn() {
            if left.get() <= 0 {
                Option.none
            } else {
                left.set(left.get() - 1)
                s.next()
            }
        },
        close: fn() { s.close() },
    }
}

/// Items while `keep` holds (the first that fails is consumed).
pub fn take_while<T, Eff>(s: Stream<T, Eff>, keep: fn(T) -> Bool !Eff) -> Stream<T, !{State, Eff}> {
    let done = Atom.new(false)
    {
        next: fn() {
            if done.get() {
                return Option.none
            }
            match s.next() {
                .some(x) => if keep(x) {
                    Option.some(x)
                } else {
                    done.set(true)
                    Option.none
                },
                .none => Option.none,
            }
        },
        close: fn() { s.close() },
    }
}

/// Items in lists of `size` (the last may be shorter; a size below 1
/// counts as 1, as `list.chunks_of`).
pub fn batches<T, Eff>(s: Stream<T, Eff>, size: Int) -> Stream<List<T>, Eff> {
    let size = if size < 1 { 1 } else { size }
    {
        next: fn() -> Option<List<T>> {
            let b = list.builder<T>()
            var n = 0
            while n < size {
                match s.next() {
                    .some(x) => {
                        b.append(x)
                        n = n + 1
                    },
                    .none => break,
                }
            }
            let items = b.finish()
            if items.len() == 0 { Option.none } else { Option.some(items) }
        },
        close: s.close,
    }
}

/// A fallible transform: each item becomes `ok` or `err` (reading goes on;
/// `try_collect` and `try_each` stop at the first error).
pub fn try_map<T, U, E, Eff>(s: Stream<T, Eff>, f: fn(T) -> Result<U, E> !Eff) -> Stream<Result<U, E>, Eff> {
    map(s, f)
}

/// Run `f` on each item.
pub fn each<T, Eff>(s: Stream<T, Eff>, f: fn(T) -> Unit !Eff) -> Unit {
    loop {
        match s.next() {
            .some(x) => f(x),
            .none => break,
        }
    }
}

/// Run `f` on each item, stopping at the first error: the stream is
/// closed, and the error returned.
pub fn try_each<T, E, Eff>(s: Stream<T, Eff>, f: fn(T) -> Result<Unit, E> !Eff) -> Result<Unit, E> {
    loop {
        match s.next() {
            .some(x) => match f(x) {
                .ok(_) => (),
                .err(e) => {
                    s.close()
                    return err(e)
                },
            },
            .none => break,
        }
    }
    ok(())
}

pub fn fold<T, A, Eff>(s: Stream<T, Eff>, initial: A, f: fn(A, T) -> A !Eff) -> A {
    var acc = initial
    loop {
        match s.next() {
            .some(x) => { acc = f(acc, x) },
            .none => break,
        }
    }
    acc
}

/// Read and discard every remaining item: how many there were.
pub fn drain<T, Eff>(s: Stream<T, Eff>) -> Int {
    var n = 0
    loop {
        match s.next() {
            .some(_) => { n = n + 1 },
            .none => break,
        }
    }
    n
}

/// Read every remaining item. This is unbounded: a stream that never ends
/// never returns, and a long one is held in memory whole (`collect_at_most`
/// bounds it).
pub fn collect<T, Eff>(s: Stream<T, Eff>) -> List<T> !{Wait, Eff} {
    let b = list.builder<T>()
    loop {
        match s.next() {
            .some(x) => b.append(x),
            .none => { break },
        }
    }
    b.finish()
}

/// Every remaining item when there are at most `limit`; otherwise
/// `none`, with the stream closed after reading one item past the limit.
pub fn collect_at_most<T, Eff>(s: Stream<T, Eff>, limit: Int) -> Option<List<T>> {
    let b = list.builder<T>()
    var n = 0
    loop {
        match s.next() {
            .some(x) => {
                if n >= limit {
                    s.close()
                    return Option.none
                }
                b.append(x)
                n = n + 1
            },
            .none => break,
        }
    }
    Option.some(b.finish())
}

/// The items of a stream of results, or the first error (the stream is
/// then closed).
pub fn try_collect<T, E, Eff>(s: Stream<Result<T, E>, Eff>) -> Result<List<T>, E> {
    let b = list.builder<T>()
    loop {
        match s.next() {
            .some(.ok(x)) => b.append(x),
            .some(.err(e)) => {
                s.close()
                return err(e)
            },
            .none => break,
        }
    }
    ok(b.finish())
}

/// All but the first `n` items.
pub fn skip<T, Eff>(s: Stream<T, Eff>, n: Int) -> Stream<T, !{State, Eff}> {
    let left = Atom.new(n)
    {
        next: fn() {
            while left.get() > 0 {
                left.set(left.get() - 1)
                match s.next() {
                    .some(_) => (),
                    .none => return Option.none,
                }
            }
            s.next()
        },
        close: fn() { s.close() },
    }
}

/// Items after the leading ones `skip` accepts.
pub fn skip_while<T, Eff>(s: Stream<T, Eff>, skip: fn(T) -> Bool !Eff) -> Stream<T, !{State, Eff}> {
    let skipping = Atom.new(true)
    {
        next: fn() -> Option<T> {
            loop {
                match s.next() {
                    .some(x) => if !skipping.get() || !skip(x) {
                        skipping.set(false)
                        return Option.some(x)
                    },
                    .none => { return Option.none },
                }
            }
        },
        close: fn() { s.close() },
    }
}

/// Pairs from `a` and `b` (as long as the shorter).
pub fn zip<A, B, Eff>(a: Stream<A, Eff>, b: Stream<B, Eff>) -> Stream<(A, B), Eff> {
    {
        next: fn() {
            match a.next() {
                .some(x) => match b.next() {
                    .some(y) => Option.some((x, y)),
                    .none => Option.none,
                },
                .none => Option.none,
            }
        },
        close: fn() {
            a.close()
            b.close()
        },
    }
}

/// Read and discard every remaining item: how many there were.
pub fn count<T, Eff>(s: Stream<T, Eff>) -> Int {
    var n = 0
    loop {
        match s.next() {
            .some(_) => { n = n + 1 },
            .none => break,
        }
    }
    n
}

/// The last item (reading the rest of the stream).
pub fn last<T, Eff>(s: Stream<T, Eff>) -> Option<T> {
    var out: Option<T> = Option.none
    loop {
        match s.next() {
            .some(x) => { out = Option.some(x) },
            .none => break,
        }
    }
    out
}

/// The first item (the stream is closed after reading it).
pub fn first<T, Eff>(s: Stream<T, Eff>) -> Option<T> { find(s, fn(_x) => true) }

/// Whether some item satisfies `test` (the stream is closed when decided).
pub fn any<T, Eff>(s: Stream<T, Eff>, test: fn(T) -> Bool !Eff) -> Bool {
    loop {
        match s.next() {
            .some(x) => if test(x) {
                s.close()
                return true
            },
            .none => { return false },
        }
    }
}

/// Whether every item satisfies `test` (the stream is closed when decided).
pub fn all<T, Eff>(s: Stream<T, Eff>, test: fn(T) -> Bool !Eff) -> Bool {
    loop {
        match s.next() {
            .some(x) => if !test(x) {
                s.close()
                return false
            },
            .none => { return true },
        }
    }
}

/// The item with the smallest key (the first, on ties).
pub fn min_by<T, K, Eff>(s: Stream<T, Eff>, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd {
    var best: Option<(K, T)> = Option.none
    loop {
        match s.next() {
            .some(x) => {
                let k = key(x)
                best = match best {
                    .some((bk, bx)) => if k < bk { Option.some((k, x)) } else { Option.some((bk, bx)) },
                    .none => Option.some((k, x)),
                }
            }
            .none => break,
        }
    }
    best.map(fn(p) => p.1)
}

/// The item with the largest key (the first, on ties).
pub fn max_by<T, K, Eff>(s: Stream<T, Eff>, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd {
    var best: Option<(K, T)> = Option.none
    loop {
        match s.next() {
            .some(x) => {
                let k = key(x)
                best = match best {
                    .some((bk, bx)) => if k > bk { Option.some((k, x)) } else { Option.some((bk, bx)) },
                    .none => Option.some((k, x)),
                }
            }
            .none => break,
        }
    }
    best.map(fn(p) => p.1)
}

impl<T, Eff> Stream<T, Eff> {
    pub fn map<U>(self: &Self, f: fn(T) -> U !Eff) -> Stream<U, Eff> { map(self, f) }
    pub fn filter(self: &Self, keep: fn(T) -> Bool !Eff) -> Stream<T, Eff> { filter(self, keep) }
    pub fn filter_map<U>(self: &Self, f: fn(T) -> Option<U> !Eff) -> Stream<U, Eff> { filter_map(self, f) }
    pub fn enumerate(self: &Self) -> Stream<(Int, T), !{State, Eff}> { enumerate(self) }
    pub fn scan<A>(self: &Self, initial: A, f: fn(A, T) -> A !Eff) -> Stream<A, !{State, Eff}> { scan(self, initial, f) }
    pub fn find(self: &Self, matches: fn(T) -> Bool !Eff) -> Option<T> { find(self, matches) }
    pub fn take(self: &Self, n: Int) -> Stream<T, !{State, Eff}> { take(self, n) }
    pub fn batches(self: &Self, size: Int) -> Stream<List<T>, Eff> { batches(self, size) }
    pub fn each(self: &Self, f: fn(T) -> Unit !Eff) -> Unit { each(self, f) }
    pub fn try_each<E>(self: &Self, f: fn(T) -> Result<Unit, E> !Eff) -> Result<Unit, E> { try_each(self, f) }
    pub fn try_map<U, E>(self: &Self, f: fn(T) -> Result<U, E> !Eff) -> Stream<Result<U, E>, Eff> { try_map(self, f) }
    pub fn fold<A>(self: &Self, initial: A, f: fn(A, T) -> A !Eff) -> A { fold(self, initial, f) }
    pub fn drain(self: &Self) -> Int { drain(self) }
    pub fn collect_at_most(self: &Self, limit: Int) -> Option<List<T>> { collect_at_most(self, limit) }
    pub fn skip(self: &Self, n: Int) -> Stream<T, !{State, Eff}> { skip(self, n) }
    pub fn skip_while(self: &Self, skip: fn(T) -> Bool !Eff) -> Stream<T, !{State, Eff}> { skip_while(self, skip) }
    pub fn zip<U>(self: &Self, other: Stream<U, Eff>) -> Stream<(T, U), Eff> { zip(self, other) }
    pub fn count(self: &Self) -> Int { count(self) }
    pub fn last(self: &Self) -> Option<T> { last(self) }
    pub fn first(self: &Self) -> Option<T> { first(self) }
    pub fn any(self: &Self, test: fn(T) -> Bool !Eff) -> Bool { any(self, test) }
    pub fn all(self: &Self, test: fn(T) -> Bool !Eff) -> Bool { all(self, test) }
    pub fn min_by<K>(self: &Self, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd { min_by(self, key) }
    pub fn max_by<K>(self: &Self, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd { max_by(self, key) }
}
