// Typed lazy sequences. A `Seq<T>` is a reusable description: each
// iteration calls `start` for a fresh iterator. Effects happen during
// iteration, in order, not when the view is constructed.

import std.list
import std.map as maps

extern "intrinsic" fn iter_on_close<T>(it: fn() -> Option<T>, close: fn() -> Unit) -> Unit
extern "intrinsic" fn iter_has_close<T>(it: fn() -> Option<T>) -> Bool
extern "intrinsic" fn iter_close<T>(it: fn() -> Option<T>) -> Unit

/// Close an iterator's scoped resources now (no-op when it has none or is
/// already closed). `for` loops call this when they exit early.
pub fn close_iter<T>(it: fn() -> Option<T>) -> Unit { iter_close(it) }

/// Make closing `outer` close `inner` (an adapter over a scoped iterator).
fn link<T, U, Eff>(outer: fn() -> Option<T> !Eff, inner: fn() -> Option<U>) -> fn() -> Option<T> !Eff {
    if iter_has_close(inner) {
        iter_on_close(outer, fn() { iter_close(inner) })
    }
    outer
}

/// A sequence over a scoped resource. Each iteration calls `open`; the
/// resource is closed exactly once when iteration is exhausted, when the
/// consumer terminates early (`break`, `return`, `?`, `take`), or when the
/// iterating task exits by defect or cancellation.
pub fn scoped<R, T, Eff>(open: fn() -> R !Eff, next: fn(R) -> Option<T> !Eff, close: fn(R) -> Unit !Eff) -> Seq<T, Eff> {
    {
        start: fn() {
            let r = open()
            let me: Cell<Option<fn() -> Option<T>>> = Cell.new(Option.none)
            let it = fn() -> Option<T> {
                match me.get() {
                    .none => Option.none,
                    .some(self_it) => match next(r) {
                        .some(x) => Option.some(x),
                        .none => {
                            iter_close(self_it)
                            Option.none
                        },
                    },
                }
            }
            me.set(Option.some(it))
            iter_on_close(it, fn() {
                me.set(Option.none)
                close(r)
            })
            it
        },
    }
}

pub fn from_fn<T, Eff>(start: fn() -> (fn() -> Option<T> !{Local, Eff}) !Eff) -> Seq<T, Eff> {
    { start }
}

extern "intrinsic" fn range_field(r: Range<Int>, i: Int) -> Int

/// The integers of a range (`a..b` or `a..=b`), as a sequence. A range is
/// used where a `Seq<Int>` is expected through this view.
pub fn from_range(r: Range<Int>) -> Seq<Int, !{}> {
    let (lo, hi, inclusive) = (range_field(r, 0), range_field(r, 1), range_field(r, 2) != 0)
    {
        start: fn() {
            let i = Cell.new(lo)
            let done = Cell.new(false)
            fn() {
                let k = i.get()
                if done.get() || k > hi || (!inclusive && k == hi) {
                    Option.none
                } else {
                    // an inclusive end stops without stepping past it
                    if k == hi { done.set(true) } else { i.set(k + 1) }
                    Option.some(k)
                }
            }
        },
    }
}

pub fn map<T, U, Eff>(items: Seq<T, Eff>, f: fn(T) -> U !Eff) -> Seq<U, Eff> {
    {
        start: fn() {
            let next = items.start()
            link(fn() {
                match next() {
                    .some(x) => Option.some(f(x)),
                    .none => Option.none,
                }
            }, next)
        },
    }
}

pub fn filter<T, Eff>(items: Seq<T, Eff>, keep: fn(T) -> Bool !Eff) -> Seq<T, Eff> {
    {
        start: fn() {
            let next = items.start()
            link(fn() -> Option<T> {
                loop {
                    match next() {
                        .some(x) => if keep(x) { return Option.some(x) },
                        .none => { return Option.none },
                    }
                }
            }, next)
        },
    }
}

pub fn take<T, Eff>(items: Seq<T, Eff>, n: Int) -> Seq<T, Eff> {
    {
        start: fn() {
            let next = items.start()
            let left = Cell.new(n)
            link(fn() {
                if left.get() <= 0 {
                    // early termination closes the upstream iterator
                    iter_close(next)
                    Option.none
                } else {
                    left.set(left.get() - 1)
                    next()
                }
            }, next)
        },
    }
}

/// `f`'s values, skipping the items it maps to `none`.
pub fn filter_map<T, U, Eff>(items: Seq<T, Eff>, f: fn(T) -> Option<U> !Eff) -> Seq<U, Eff> {
    {
        start: fn() {
            let next = items.start()
            link(fn() -> Option<U> {
                loop {
                    match next() {
                        .some(x) => match f(x) {
                            .some(y) => { return Option.some(y) },
                            .none => (),
                        },
                        .none => { return Option.none },
                    }
                }
            }, next)
        },
    }
}

/// Each item with its position, from 0.
pub fn enumerate<T, Eff>(items: Seq<T, Eff>) -> Seq<(Int, T), Eff> {
    {
        start: fn() {
            let next = items.start()
            let i = Cell.new(0)
            link(fn() {
                match next() {
                    .some(x) => {
                        let k = i.get()
                        i.set(k + 1)
                        Option.some((k, x))
                    },
                    .none => Option.none,
                }
            }, next)
        },
    }
}

/// All but the first `n` items.
pub fn skip<T, Eff>(items: Seq<T, Eff>, n: Int) -> Seq<T, Eff> {
    {
        start: fn() {
            let next = items.start()
            let left = Cell.new(n)
            link(fn() -> Option<T> {
                while left.get() > 0 {
                    left.set(left.get() - 1)
                    if next().is_none() {
                        return Option.none
                    }
                }
                next()
            }, next)
        },
    }
}

/// Items while `keep` accepts them; the first it refuses ends the
/// sequence (and closes the source).
pub fn take_while<T, Eff>(items: Seq<T, Eff>, keep: fn(T) -> Bool !Eff) -> Seq<T, Eff> {
    {
        start: fn() {
            let next = items.start()
            let done = Cell.new(false)
            link(fn() -> Option<T> {
                if done.get() {
                    return Option.none
                }
                match next() {
                    .some(x) => if keep(x) {
                        Option.some(x)
                    } else {
                        done.set(true)
                        iter_close(next)
                        Option.none
                    },
                    .none => Option.none,
                }
            }, next)
        },
    }
}

/// Items after the leading ones `skip` accepts.
pub fn skip_while<T, Eff>(items: Seq<T, Eff>, skip: fn(T) -> Bool !Eff) -> Seq<T, Eff> {
    {
        start: fn() {
            let next = items.start()
            let skipping = Cell.new(true)
            link(fn() -> Option<T> {
                loop {
                    match next() {
                        .some(x) => if !skipping.get() || !skip(x) {
                            skipping.set(false)
                            return Option.some(x)
                        },
                        .none => { return Option.none },
                    }
                }
            }, next)
        },
    }
}

/// Running states: `f(state, item)` for each item, starting from `initial`.
pub fn scan<T, A, Eff>(items: Seq<T, Eff>, initial: A, f: fn(A, T) -> A !Eff) -> Seq<A, Eff> {
    {
        start: fn() {
            let next = items.start()
            let state = Cell.new(initial)
            link(fn() {
                match next() {
                    .some(x) => {
                        let s = f(state.get(), x)
                        state.set(s)
                        Option.some(s)
                    },
                    .none => Option.none,
                }
            }, next)
        },
    }
}

/// Consecutive groups of `size` items (the last may be shorter).
pub fn chunks<T, Eff>(items: Seq<T, Eff>, size: Int) -> Seq<List<T>, Eff> {
    // a size below 1 counts as 1 (as `list.chunks_of`)
    let size = if size < 1 { 1 } else { size }
    {
        start: fn() {
            let next = items.start()
            link(fn() -> Option<List<T>> {
                let b = list.builder<T>()
                while b.len() < size {
                    match next() {
                        .some(x) => b.append(x),
                        .none => { break },
                    }
                }
                if b.len() == 0 { Option.none } else { Option.some(b.finish()) }
            }, next)
        },
    }
}

/// The first item `matches` accepts (consuming no further).
pub fn find<T, Eff>(items: Seq<T, Eff>, matches: fn(T) -> Bool !Eff) -> Option<T> {
    for x in items {
        if matches(x) {
            return Option.some(x)
        }
    }
    Option.none
}

/// The first `some` that `f` gives.
pub fn find_map<T, U, Eff>(items: Seq<T, Eff>, f: fn(T) -> Option<U> !Eff) -> Option<U> {
    for x in items {
        match f(x) {
            .some(y) => { return Option.some(y) },
            .none => (),
        }
    }
    Option.none
}

/// Whether some item satisfies `test` (stopping at the first).
pub fn any<T, Eff>(items: Seq<T, Eff>, test: fn(T) -> Bool !Eff) -> Bool {
    for x in items {
        if test(x) {
            return true
        }
    }
    false
}

/// Whether every item satisfies `test` (stopping at the first that does not).
pub fn all<T, Eff>(items: Seq<T, Eff>, test: fn(T) -> Bool !Eff) -> Bool {
    for x in items {
        if !test(x) {
            return false
        }
    }
    true
}

pub fn first<T, Eff>(items: Seq<T, Eff>) -> Option<T> {
    for x in items {
        return Option.some(x)
    }
    Option.none
}

pub fn last<T, Eff>(items: Seq<T, Eff>) -> Option<T> {
    var out: Option<T> = Option.none
    for x in items {
        out = Option.some(x)
    }
    out
}

/// The item with the smallest key (the first, on ties).
pub fn min_by<T, K, Eff>(items: Seq<T, Eff>, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd {
    var best: Option<(K, T)> = Option.none
    for x in items {
        let k = key(x)
        best = match best {
            .some((bk, bx)) => if k < bk { Option.some((k, x)) } else { Option.some((bk, bx)) },
            .none => Option.some((k, x)),
        }
    }
    best.map(fn(p) => p.1)
}

/// The item with the largest key (the first, on ties).
pub fn max_by<T, K, Eff>(items: Seq<T, Eff>, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd {
    var best: Option<(K, T)> = Option.none
    for x in items {
        let k = key(x)
        best = match best {
            .some((bk, bx)) => if k > bk { Option.some((k, x)) } else { Option.some((bk, bx)) },
            .none => Option.some((k, x)),
        }
    }
    best.map(fn(p) => p.1)
}

/// The items `keep` accepts and those it refuses, each in order.
pub fn partition<T, Eff>(items: Seq<T, Eff>, keep: fn(T) -> Bool !Eff) -> (List<T>, List<T>) {
    let yes = list.builder<T>()
    let no = list.builder<T>()
    for x in items {
        if keep(x) { yes.append(x) } else { no.append(x) }
    }
    (yes.finish(), no.finish())
}

pub fn sum<Eff>(items: Seq<Int, Eff>) -> Int {
    var total = 0
    for x in items {
        total = total + x
    }
    total
}

pub fn flat_map<T, U, Eff>(items: Seq<T, Eff>, f: fn(T) -> Seq<U, Eff> !Eff) -> Seq<U, Eff> {
    {
        start: fn() {
            let outer = items.start()
            let inner: Cell<Option<fn() -> Option<U>>> = Cell.new(Option.none)
            let me: Cell<Option<fn() -> Option<U>>> = Cell.new(Option.none)
            let closer = fn() {
                match inner.get() {
                    .some(i) => iter_close(i),
                    .none => (),
                }
                iter_close(outer)
            }
            let it = fn() -> Option<U> {
                loop {
                    match inner.get() {
                        .some(i) => match i() {
                            .some(x) => { return Option.some(x) },
                            .none => inner.set(Option.none),
                        },
                        .none => match outer() {
                            .some(x) => {
                                let i = f(x).start()
                                inner.set(Option.some(i))
                                // a scoped inner iterator makes this one scoped
                                if iter_has_close(i) {
                                    match me.get() {
                                        .some(s) => if !iter_has_close(s) { iter_on_close(s, closer) },
                                        .none => (),
                                    }
                                }
                            },
                            .none => { return Option.none },
                        },
                    }
                }
            }
            me.set(Option.some(it))
            if iter_has_close(outer) {
                iter_on_close(it, closer)
            }
            it
        },
    }
}

pub fn zip<A, B, Eff>(a: Seq<A, Eff>, b: Seq<B, Eff>) -> Seq<(A, B), Eff> {
    {
        start: fn() {
            let na = a.start()
            let nb = b.start()
            let it = fn() {
                match na() {
                    .some(x) => match nb() {
                        .some(y) => Option.some((x, y)),
                        .none => {
                            iter_close(na)
                            Option.none
                        },
                    },
                    .none => {
                        iter_close(nb)
                        Option.none
                    },
                }
            }
            if iter_has_close(na) || iter_has_close(nb) {
                iter_on_close(it, fn() {
                    iter_close(na)
                    iter_close(nb)
                })
            }
            it
        },
    }
}

/// `f` over the items, lazily, as results: `try_collect` (or `try_each`)
/// then stops at the first error, so later items are never mapped.
pub fn try_map<T, U, E, Eff>(items: Seq<T, Eff>, f: fn(T) -> Result<U, E> !Eff) -> Seq<Result<U, E>, Eff> {
    map(items, f)
}

/// Fold in order, stopping at the first error; a scoped source is closed
/// either way.
pub fn try_fold<T, A, E, Eff>(items: Seq<T, Eff>, initial: A, f: fn(A, T) -> Result<A, E> !Eff) -> Result<A, E> {
    var acc = initial
    for x in items {
        acc = f(acc, x)?
    }
    ok(acc)
}

/// Run `f` on each item, stopping at the first error (closing a scoped
/// source).
pub fn try_each<T, E, Eff>(items: Seq<T, Eff>, f: fn(T) -> Result<Unit, E> !Eff) -> Result<Unit, E> {
    for x in items {
        f(x)?
    }
    ok(())
}

/// The items of a sequence of results, or the first error (the rest are
/// not produced, and a scoped source is closed).
pub fn try_collect<T, E, Eff>(items: Seq<Result<T, E>, Eff>) -> Result<List<T>, E> {
    let b = list.builder<T>()
    for r in items {
        b.append(r?)
    }
    ok(b.finish())
}

pub fn fold<T, A, Eff>(items: Seq<T, Eff>, initial: A, f: fn(A, T) -> A !Eff) -> A {
    var acc = initial
    for x in items {
        acc = f(acc, x)
    }
    acc
}

pub fn count<T, Eff>(items: Seq<T, Eff>) -> Int {
    var n = 0
    for _ in items {
        n = n + 1
    }
    n
}

pub fn range(start: Int, end: Int) -> Seq<Int, !{}> {
    {
        start: fn() {
            let i = Cell.new(start)
            fn() {
                let k = i.get()
                if k < end {
                    i.set(k + 1)
                    Option.some(k)
                } else {
                    Option.none
                }
            }
        },
    }
}

/// Group items by key. Groups keep the items' iteration order.
pub fn group_by<T, K, Eff>(items: Seq<T, Eff>, key: fn(T) -> K !Eff) -> Map<K, List<T>> where K: Hash {
    var groups: Map<K, List<T>> = maps.empty()
    for x in items {
        let k = key(x)
        let group = groups.get(k).unwrap_or(list.empty())
        groups = groups.insert(k, list.append(group, x))
    }
    groups
}

impl<T, Eff> Seq<T, Eff> {
    pub fn map<U>(self: &Self, f: fn(T) -> U !Eff) -> Seq<U, Eff> { map(self, f) }
    pub fn try_map<U, E>(self: &Self, f: fn(T) -> Result<U, E> !Eff) -> Seq<Result<U, E>, Eff> { try_map(self, f) }
    pub fn filter(self: &Self, keep: fn(T) -> Bool !Eff) -> Seq<T, Eff> { filter(self, keep) }
    pub fn take(self: &Self, n: Int) -> Seq<T, Eff> { take(self, n) }
    pub fn flat_map<U>(self: &Self, f: fn(T) -> Seq<U, Eff> !Eff) -> Seq<U, Eff> { flat_map(self, f) }
    pub fn zip<U>(self: &Self, other: Seq<U, Eff>) -> Seq<(T, U), Eff> { zip(self, other) }
    pub fn fold<A>(self: &Self, initial: A, f: fn(A, T) -> A !Eff) -> A { fold(self, initial, f) }
    pub fn try_fold<A, E>(self: &Self, initial: A, f: fn(A, T) -> Result<A, E> !Eff) -> Result<A, E> { try_fold(self, initial, f) }
    pub fn try_each<E>(self: &Self, f: fn(T) -> Result<Unit, E> !Eff) -> Result<Unit, E> { try_each(self, f) }
    pub fn count(self: &Self) -> Int { count(self) }
    pub fn collect(self: &Self) -> List<T> { list.collect(self) }
    pub fn group_by<K>(self: &Self, key: fn(T) -> K !Eff) -> Map<K, List<T>> where K: Hash { group_by(self, key) }
    pub fn filter_map<U>(self: &Self, f: fn(T) -> Option<U> !Eff) -> Seq<U, Eff> { filter_map(self, f) }
    pub fn enumerate(self: &Self) -> Seq<(Int, T), Eff> { enumerate(self) }
    pub fn skip(self: &Self, n: Int) -> Seq<T, Eff> { skip(self, n) }
    pub fn take_while(self: &Self, keep: fn(T) -> Bool !Eff) -> Seq<T, Eff> { take_while(self, keep) }
    pub fn skip_while(self: &Self, skip: fn(T) -> Bool !Eff) -> Seq<T, Eff> { skip_while(self, skip) }
    pub fn scan<A>(self: &Self, initial: A, f: fn(A, T) -> A !Eff) -> Seq<A, Eff> { scan(self, initial, f) }
    pub fn chunks(self: &Self, size: Int) -> Seq<List<T>, Eff> { chunks(self, size) }
    pub fn find(self: &Self, matches: fn(T) -> Bool !Eff) -> Option<T> { find(self, matches) }
    pub fn find_map<U>(self: &Self, f: fn(T) -> Option<U> !Eff) -> Option<U> { find_map(self, f) }
    pub fn any(self: &Self, test: fn(T) -> Bool !Eff) -> Bool { any(self, test) }
    pub fn all(self: &Self, test: fn(T) -> Bool !Eff) -> Bool { all(self, test) }
    pub fn first(self: &Self) -> Option<T> { first(self) }
    pub fn last(self: &Self) -> Option<T> { last(self) }
    pub fn min_by<K>(self: &Self, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd { min_by(self, key) }
    pub fn max_by<K>(self: &Self, key: fn(T) -> K !Eff) -> Option<T> where K: PartialOrd { max_by(self, key) }
    pub fn partition(self: &Self, keep: fn(T) -> Bool !Eff) -> (List<T>, List<T>) { partition(self, keep) }
}
