// Persistent maps with value semantics.

import std.list

extern "intrinsic" fn map_empty<K, V>() -> Map<K, V>
extern "intrinsic" fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V>
extern "intrinsic" fn map_remove<K, V>(m: Map<K, V>, key: K) -> Map<K, V>
extern "intrinsic" fn map_get<K, V>(m: Map<K, V>, key: K) -> Option<V>
extern "intrinsic" fn map_contains<K, V>(m: Map<K, V>, key: K) -> Bool
extern "intrinsic" fn map_len<K, V>(m: Map<K, V>) -> Int
extern "intrinsic" fn map_entries<K, V>(m: Map<K, V>) -> List<(K, V)>
extern "intrinsic" fn map_insert_mut<K, V>(m: Map<K, V>, key: K, value: V) -> Unit

/// Affine builder for bulk construction; `finish` freezes the map in place.
pub struct MapBuilder<K, V> {
    map: Map<K, V>,
}

impl<K, V> MapBuilder<K, V> {
    /// Insert or replace an entry.
    pub fn insert(self: &mut Self, key: K, value: V) -> Unit { map_insert_mut(self.map, key, value) }
    pub fn len(self: &Self) -> Int { map_len(self.map) }
    pub fn finish(self: Self) -> Map<K, V> { self.map }
}

pub fn builder<K, V>() -> MapBuilder<K, V> where K: Hash { { map: map_empty() } }

/// A map built by `fill`, which inserts into a builder that is finished
/// when it returns.
pub fn build<K, V>(fill: once fn(&mut MapBuilder<K, V>) -> Unit) -> Map<K, V> where K: Hash {
    var b: MapBuilder<K, V> = { map: map_empty() }
    fill(&mut b)
    b.finish()
}

/// Bulk construction from entries (later duplicates win).
pub fn from_list<K, V>(entries: List<(K, V)>) -> Map<K, V> where K: Hash {
    let m = map_empty()
    for (k, v) in entries {
        map_insert_mut(m, k, v)
    }
    m
}

pub fn collect<K, V>(entries: Seq<(K, V)>) -> Map<K, V> where K: Hash {
    let m = map_empty()
    for (k, v) in entries {
        map_insert_mut(m, k, v)
    }
    m
}

pub fn empty<K, V>() -> Map<K, V> where K: Hash { map_empty() }
pub fn insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> { map_insert(m, key, value) }
pub fn remove<K, V>(m: Map<K, V>, key: K) -> Map<K, V> { map_remove(m, key) }
pub fn get<K, V>(m: Map<K, V>, key: K) -> Option<V> { map_get(m, key) }
pub fn contains<K, V>(m: Map<K, V>, key: K) -> Bool { map_contains(m, key) }
pub fn len<K, V>(m: Map<K, V>) -> Int { map_len(m) }
/// Entries in unspecified order.
pub fn to_list<K, V>(m: Map<K, V>) -> List<(K, V)> { map_entries(m) }

/// One trie walk for `entries().map(..)`: the compiler lowers that chain
/// here, so no intermediate entry list is built. The callback receives the
/// entry tuple.
pub fn entries_map<K, V, U>(m: Map<K, V>, f: fn((K, V)) -> U) -> List<U> {
    let b = list.builder<U>()
    for (k, v) in m {
        b.append(f((k, v)))
    }
    b.finish()
}

/// One trie walk for `entries().filter(..)`.
pub fn entries_filter<K, V>(m: Map<K, V>, keep: fn((K, V)) -> Bool) -> List<(K, V)> {
    let b = list.builder<(K, V)>()
    for (k, v) in m {
        if keep((k, v)) {
            b.append((k, v))
        }
    }
    b.finish()
}

/// One trie walk for `entries().fold(..)`.
pub fn entries_fold<K, V, A>(m: Map<K, V>, initial: A, f: fn(A, (K, V)) -> A) -> A {
    var acc = initial
    for (k, v) in m {
        acc = f(acc, (k, v))
    }
    acc
}

/// The keys, in the map's (unspecified but stable) entry order.
pub fn keys<K, V>(m: Map<K, V>) -> List<K> {
    let out = list.builder<K>()
    for (k, _) in m { out.append(k) }
    out.finish()
}

/// The values, in the map's entry order.
pub fn values<K, V>(m: Map<K, V>) -> List<V> {
    let out = list.builder<V>()
    for (_, v) in m { out.append(v) }
    out.finish()
}

/// The value at `key`, or `default`.
pub fn get_or<K, V>(m: Map<K, V>, key: K, default: V) -> V {
    match map_get(m, key) {
        .some(v) => v,
        .none => default,
    }
}

/// Change the entry at `key`: `f` gets the current value (`none` if
/// absent) and returns the new one (`none` removes the entry).
pub fn update<K, V>(m: Map<K, V>, key: K, f: once fn(Option<V>) -> Option<V>) -> Map<K, V> {
    match f(map_get(m, key)) {
        .some(v) => map_insert(m, key, v),
        .none => if map_contains(m, key) { map_remove(m, key) } else { m },
    }
}

/// Both maps' entries; where both have a key, `combine(a's, b's)` decides.
pub fn merge_with<K, V>(a: Map<K, V>, b: Map<K, V>, combine: fn(V, V) -> V) -> Map<K, V> where K: Hash {
    let out = map_empty()
    for (k, v) in a {
        map_insert_mut(out, k, v)
    }
    for (k, v) in b {
        let merged = match map_get(a, k) {
            .some(x) => combine(x, v),
            .none => v,
        }
        map_insert_mut(out, k, merged)
    }
    out
}

/// Both maps' entries; `b`'s win where both have a key.
pub fn merge<K, V>(a: Map<K, V>, b: Map<K, V>) -> Map<K, V> where K: Hash { merge_with(a, b, fn(_x, y) => y) }

/// The same keys with `f` applied to each value.
pub fn map_values<K, V, W>(m: Map<K, V>, f: fn(V) -> W) -> Map<K, W> where K: Hash {
    let out = map_empty()
    for (k, v) in m {
        map_insert_mut(out, k, f(v))
    }
    out
}

/// The entries `keep` accepts.
pub fn filter<K, V>(m: Map<K, V>, keep: fn(K, V) -> Bool) -> Map<K, V> where K: Hash {
    let out = map_empty()
    for (k, v) in m {
        if keep(k, v) {
            map_insert_mut(out, k, v)
        }
    }
    out
}

pub fn is_empty<K, V>(m: Map<K, V>) -> Bool { map_len(m) == 0 }

// ---------------------------------------------------------------- reshaping

/// The same entries with `f` applied to each key (duplicates: the last wins).
pub fn map_keys<K, V, W>(m: Map<K, V>, f: fn(K) -> W) -> Map<W, V> where W: Hash {
    let out = map_empty()
    for (k, v) in m {
        map_insert_mut(out, f(k), v)
    }
    out
}

/// Only the entries whose keys are in `keys`.
pub fn select_keys<K, V>(m: Map<K, V>, keys: List<K>) -> Map<K, V> where K: Hash {
    let out = map_empty()
    for k in keys {
        match map_get(m, k) {
            .some(v) => map_insert_mut(out, k, v),
            .none => (),
        }
    }
    out
}

/// The entries whose keys are not in `keys`.
pub fn omit_keys<K, V>(m: Map<K, V>, keys: List<K>) -> Map<K, V> where K: Hash {
    let out = map_empty()
    for (k, v) in m {
        if !keys.contains(k) {
            map_insert_mut(out, k, v)
        }
    }
    out
}

/// The map with `key` set only when it is absent.
pub fn put_new<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
    if map_contains(m, key) { m } else { map_insert(m, key, value) }
}

/// Change the entry at `key` through `f` on its value, using `default`
/// when the key is absent.
pub fn update_with<K, V>(m: Map<K, V>, key: K, default: V, f: fn(V) -> V) -> Map<K, V> {
    let cur = match map_get(m, key) {
        .some(v) => v,
        .none => default,
    }
    map_insert(m, key, f(cur))
}

/// The first entry `keep` accepts.
pub fn find<K, V>(m: Map<K, V>, keep: fn(K, V) -> Bool) -> Option<(K, V)> {
    for (k, v) in m {
        if keep(k, v) {
            return Option.some((k, v))
        }
    }
    Option.none
}

pub fn any<K, V>(m: Map<K, V>, test: fn(K, V) -> Bool) -> Bool {
    for (k, v) in m {
        if test(k, v) {
            return true
        }
    }
    false
}

pub fn all<K, V>(m: Map<K, V>, test: fn(K, V) -> Bool) -> Bool {
    for (k, v) in m {
        if !test(k, v) {
            return false
        }
    }
    true
}

/// How many entries satisfy `test`.
pub fn count<K, V>(m: Map<K, V>, test: fn(K, V) -> Bool) -> Int {
    var n = 0
    for (k, v) in m {
        if test(k, v) {
            n = n + 1
        }
    }
    n
}

pub fn each<K, V>(m: Map<K, V>, f: fn(K, V) -> Unit) -> Unit {
    for (k, v) in m {
        f(k, v)
    }
}

/// Fold over the entries in order.
pub fn fold<K, V, A>(m: Map<K, V>, initial: A, f: fn(A, (K, V)) -> A) -> A {
    var acc = initial
    for (k, v) in m {
        acc = f(acc, (k, v))
    }
    acc
}

/// The map with keys and values swapped (later duplicates win).
pub fn invert<K, V>(m: Map<K, V>) -> Map<V, K> where V: Hash {
    let out = map_empty()
    for (k, v) in m {
        map_insert_mut(out, v, k)
    }
    out
}

impl<K, V> Map<K, V> {
    pub fn map_keys<W>(self: &Self, f: fn(K) -> W) -> Map<W, V> where W: Hash { map_keys(self, f) }
    pub fn select_keys(self: &Self, keys: List<K>) -> Map<K, V> where K: Hash { select_keys(self, keys) }
    pub fn omit_keys(self: &Self, keys: List<K>) -> Map<K, V> where K: Hash { omit_keys(self, keys) }
    pub fn put_new(self: &Self, key: K, value: V) -> Map<K, V> { put_new(self, key, value) }
    pub fn update_with(self: &Self, key: K, default: V, f: fn(V) -> V) -> Map<K, V> { update_with(self, key, default, f) }
    pub fn find(self: &Self, keep: fn(K, V) -> Bool) -> Option<(K, V)> { find(self, keep) }
    pub fn any(self: &Self, test: fn(K, V) -> Bool) -> Bool { any(self, test) }
    pub fn all(self: &Self, test: fn(K, V) -> Bool) -> Bool { all(self, test) }
    pub fn count(self: &Self, test: fn(K, V) -> Bool) -> Int { count(self, test) }
    pub fn each(self: &Self, f: fn(K, V) -> Unit) -> Unit { each(self, f) }
    pub fn fold<A>(self: &Self, initial: A, f: fn(A, (K, V)) -> A) -> A { fold(self, initial, f) }
    pub fn invert(self: &Self) -> Map<V, K> where V: Hash { invert(self) }
    pub fn remove(self: &Self, key: K) -> Map<K, V> { map_remove(self, key) }
    pub fn keys(self: &Self) -> List<K> { keys(self) }
    pub fn values(self: &Self) -> List<V> { values(self) }
    pub fn entries(self: &Self) -> List<(K, V)> { map_entries(self) }
    pub fn get_or(self: &Self, key: K, default: V) -> V { get_or(self, key, default) }
    pub fn update(self: &Self, key: K, f: once fn(Option<V>) -> Option<V>) -> Map<K, V> { update(self, key, f) }
    pub fn merge(self: &Self, other: Map<K, V>) -> Map<K, V> where K: Hash { merge(self, other) }
    pub fn merge_with(self: &Self, other: Map<K, V>, combine: fn(V, V) -> V) -> Map<K, V> where K: Hash { merge_with(self, other, combine) }
    pub fn map_values<W>(self: &Self, f: fn(V) -> W) -> Map<K, W> where K: Hash { map_values(self, f) }
    pub fn filter(self: &Self, keep: fn(K, V) -> Bool) -> Map<K, V> where K: Hash { filter(self, keep) }
    pub fn is_empty(self: &Self) -> Bool { map_len(self) == 0 }
    pub fn get(self: &Self, key: K) -> Option<V> { map_get(self, key) }
    pub fn insert(self: &Self, key: K, value: V) -> Map<K, V> { map_insert(self, key, value) }
    pub fn contains(self: &Self, key: K) -> Bool { map_contains(self, key) }
    pub fn len(self: &Self) -> Int { map_len(self) }
}
