// Explicit random sources. A seeded source is deterministic, so tests can
// control randomness; an OS-seeded source is an explicit `State` effect.

pub struct Random {
    id: Int,
}

extern "intrinsic" fn random_seeded(seed: Int) -> Int
extern "intrinsic" fn random_os() -> Int
extern "intrinsic" fn random_next(id: Int) -> U64
extern "intrinsic" fn convert_lossy<A, B>(value: A) -> B

/// A deterministic source.
pub fn seeded(seed: Int) -> Random { { id: random_seeded(seed) } }

/// A source seeded from the clock and process id.
pub fn system() -> Random !{State} { { id: random_os() } }

impl Random {
    /// A uniformly distributed integer in `low..high`.
    pub fn int(self: &Self, low: Int, high: Int) -> Int !{State} {
        let span = high - low
        if span <= 0 { return low }
        let r: Int = convert_lossy(random_next(self.id) % convert_lossy<Int, U64>(span))
        low + r
    }

    /// A float in `[0, 1)`.
    pub fn float(self: &Self) -> Float !{State} {
        let bits: U64 = random_next(self.id) / 2048U64
        let f: Float = convert_lossy(bits)
        f / 9007199254740992.0
    }

    pub fn bool(self: &Self) -> Bool !{State} { random_next(self.id) % 2U64 == 0U64 }
}
