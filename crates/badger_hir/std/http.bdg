// HTTP request/reply adapter.

import std.prelude

import std.codec
import std.system
import std.native
import std.websocket
import std.list
import std.text as texts

/// Immutable request metadata and body.
pub type Request = { method: Symbol, path: String, headers: Map<String, String>, body: Bytes }

pub struct Response {
    pub status: Int,
    pub headers: Map<String, String>,
    pub body: Bytes,
}

pub struct Error {
    pub message: String,
}

impl Display for Error {
    fn display(self: &Self) -> String { self.message }
}

impl HttpStatus for Error {}

impl prelude.Error for Error {}

/// The default status for an error that does not choose one.
pub let internal_status = 500

/// The HTTP status an error variant is answered with:
/// `@http.status(404) not_found(id: Int)`, read by `derive(HttpError)` (an
/// error status, 400 to 599; a variant without one is answered 500).
pub attribute status on variant {
    code: Int,
}

/// An error that carries the status the application intends: the route
/// system answers with that status instead of a generic 500. A client
/// error carries the error's message; a server error does not.
pub struct StatusError<E> {
    pub status: Int,
    pub error: E,
}

impl<E> Display for StatusError<E> where E: Display {
    fn display(self: &Self) -> String { self.error.display() }
}

impl<E> HttpStatus for StatusError<E> {
    fn http_status(self: &Self) -> Int { self.status }
    fn http_code(self: &Self) -> Symbol { error_code(self.error) }
}

extern "intrinsic" fn error_code<T>(value: T) -> Symbol

/// An error with the status the application intends.
pub fn status<E>(code: Int, error: E) -> StatusError<E> { { status: code, error } }

/// A streamed reply: the head is sent first, then each chunk as the
/// request task produces it (chunked transfer encoding). The chunk sequence
/// may use request-scoped resources: it is fully consumed (and a scoped
/// sequence closed) by the request task before the request scope ends.
pub struct Streamed {
    pub status: Int,
    pub headers: Map<String, String>,
    pub chunks: Seq<Bytes>,
}

enum Reply {
    full(response: Response),
    stream(reply: Streamed),
    /// already written during the handler (a request-scoped stream)
    sent,
}

/// The connection side of one request: a live exchange, or an in-process
/// sink (`call`).
pub struct Exchange {
    conn: Option<native.Handle>,
    sink: Option<Cell<Response>>,
    /// the server's service scope (disconnect watchers run in it)
    service: Int,
}

/// A packaged request handler; a handler's error is answered with the
/// status it carries (500 unless it chooses one).
pub struct Handler {
    run: fn(Request, Exchange) -> Reply !{Io, Wait, State, Foreign},
}

extern "intrinsic" fn identity<A, B>(value: A) -> B

/// One request's scope, for its fresh region `S`. Values branded with `S`
/// (the body reader) cannot outlive the request; a stream written through
/// it is fully consumed (and a scoped sequence closed) before the handler
/// returns, so it may use request-scoped resources.
pub struct RequestScope<S: Scope> {
    brand: system.Brand<S>,
    request: Request,
    exchange: Exchange,
}

/// Scoped access to the request body (valid only within the request).
pub struct BodyReader<S: Scope> {
    brand: system.Brand<S>,
    bytes: Bytes,
}

/// Proof that a scoped handler produced its reply.
pub struct Sent {
    status: Int,
}

extern "intrinsic" fn bytes_len(b: Bytes) -> Int
extern "intrinsic" fn bytes_slice(b: Bytes, start: Int, end: Int) -> Option<Bytes>

impl<S: Scope> BodyReader<S> {
    pub fn len(self: &Self) -> Int { bytes_len(self.bytes) }
    pub fn bytes(self: &Self) -> Bytes { self.bytes }
    pub fn text(self: &Self) -> String { http_body_text(self.bytes) }
    /// Validate and decode the body (JSON) as `T`.
    pub fn decode<T>(self: &Self) -> Result<T, codec.DecodeError> where T: Codec { codec.decode(self.bytes) }
    /// The body in pieces of at most `size` bytes.
    pub fn chunks(self: &Self, size: Int) -> Seq<Bytes> {
        let b = self.bytes
        let n = bytes_len(b)
        {
            start: fn() {
                let at = Cell.new(0)
                fn() -> Option<Bytes> {
                    let i = at.get()
                    if i >= n {
                        Option.none
                    } else {
                        let j = if i + size > n { n } else { i + size }
                        at.set(j)
                        bytes_slice(b, i, j)
                    }
                }
            },
        }
    }
}

impl<S: Scope> RequestScope<S> {
    /// The immutable request metadata and body.
    pub fn request(self: &Self) -> Request { self.request }
    /// A reader of the body, branded with this request's region.
    pub fn body(self: &Self) -> BodyReader<S> { { brand: self.brand, bytes: self.request.body } }
    /// Reply with a complete response.
    pub fn respond(self: &Self, response: Response) -> Sent {
        send_full(self.exchange, response)
        { status: response.status }
    }
    /// Stream a reply now: the head, then each chunk as it is produced;
    /// the sequence is consumed (and closed) before this returns.
    pub fn stream(self: &Self, status: Int, content_type: String, chunks: Seq<Bytes>) -> Sent {
        self.stream_with(status, map { "content-type" => content_type }, chunks)
    }
    /// Stream server-sent events now (`text/event-stream`); stops early,
    /// closing the sequence, if the client goes away.
    pub fn events(self: &Self, events: Seq<Event>) -> Sent {
        self.stream_with(200, event_headers(), events.map(fn(e: Event) -> Bytes { text_to_bytes(encode_event(e)) }))
    }
    /// Upgrade to a WebSocket and run `session` on it in this request's
    /// task; the socket closes when it returns (or the task stops). A
    /// request that is not an upgrade is answered 426 without running it.
    pub fn websocket<E>(self: &Self, session: fn(websocket.WebSocket) -> Result<Unit, E>) -> Sent where E: Display {
        run_websocket(self.exchange, self.request, session)
    }
    fn stream_with(self: &Self, status: Int, headers: Map<String, String>, chunks: Seq<Bytes>) -> Sent {
        match self.exchange.sink {
            .some(cell) => {
                var body = text_to_bytes("")
                for chunk in chunks {
                    body = bytes_concat(body, chunk)
                }
                cell.set({ status, headers, body })
            },
            .none => match self.exchange.conn {
                .some(conn) => pump(conn, self.exchange.service, status, headers, chunks),
                .none => (),
            },
        }
        { status }
    }
}

fn send_full(ex: Exchange, response: Response) -> Unit {
    match ex.sink {
        .some(cell) => cell.set(response),
        .none => match ex.conn {
            .some(conn) => http_respond(conn, response.status, response.headers, response.body),
            .none => (),
        },
    }
}

/// Package a request-scoped callback: it runs under a fresh request region
/// `S`, may capture longer-lived values (a system's pool), and replies
/// through its scope (`respond` or `stream`). An error is answered with
/// the status it carries (500 unless it chooses one).
pub fn scoped<E, Eff>(f: for<S: Scope> fn(RequestScope<S>) -> Result<Sent, E> !Eff) -> Handler where E: Display, E: HttpStatus, for<S: Scope> fn(RequestScope<S>) -> Result<Sent, E> !Eff: Transfer {
    {
        run: fn(request, exchange) {
            let scope: RequestScope<Unit> = { brand: identity<Int, system.Brand<Unit>>(0), request, exchange }
            match f(scope) {
                .ok(_) => Reply.sent,
                .err(e) => {
                    trace_event(#http/handler_error, { message: e.display() })
                    Reply.full(error_reply(e))
                },
            }
        },
    }
}

/// Explicit request limits. A body over `max_body_bytes` is answered 413,
/// headers over `max_header_bytes` 431, and a request arriving while
/// `max_in_flight` are being handled 503 (bounded admission), all without
/// running the handler. Open connections are bounded at four times
/// `max_in_flight` (at least 256): past that, new connections wait in the
/// listen backlog until one closes. Defaults come from the runtime configuration
/// (`[runtime] http_max_body_bytes`, `http_max_header_bytes`,
/// `http_max_in_flight`).
pub struct Limits {
    pub max_body_bytes: Int,
    pub max_header_bytes: Int,
    pub max_in_flight: Int,
}

/// A server's effective limits and how many requests they rejected.
pub struct LimitStats {
    pub max_body_bytes: Int,
    pub max_header_bytes: Int,
    pub max_in_flight: Int,
    pub rejected: Int,
}

/// A running server: the module's listener, and the scope of its acceptor
/// and request tasks.
pub struct Server {
    handle: native.Handle,
    scope: Int,
}

/// An admitted request with its exchange (answered through it).
type Incoming = { exchange: native.Handle, method: Symbol, path: String, headers: Map<String, String>, body: Bytes }

type ListenLimits = { max_body_bytes: Int, max_header_bytes: Int, max_in_flight: Int, max_stream_buffer_bytes: Int }

// the `badger_http` native module (crates/badger_http)
extern "native badger_http.listen" fn http_listen(address: String, port: U16, limits: ListenLimits) -> Result<native.Handle, Error> !{Io}
extern "native badger_http.accept" fn http_accept(server: native.Handle) -> Result<Incoming, Error> !{Io, Wait}
extern "native badger_http.respond" fn http_respond(exchange: native.Handle, status: Int, headers: Map<String, String>, body: Bytes) -> Unit
extern "native badger_http.stream_begin" fn http_stream_begin(exchange: native.Handle, status: Int, headers: Map<String, String>) -> Unit
extern "native badger_http.stream_chunk" fn http_stream_chunk(exchange: native.Handle, chunk: Bytes) -> Bool !{Wait}
extern "native badger_http.stream_end" fn http_stream_end(exchange: native.Handle) -> Unit
extern "native badger_http.stream_watch" fn http_stream_watch(exchange: native.Handle) -> Bool !{Wait}
extern "native badger_http.ws_accept" fn http_ws_accept(exchange: native.Handle, subprotocol: String) -> Result<websocket.WebSocket, native.Error> !{Io, Wait}
extern "native badger_http.abort" fn http_abort(exchange: native.Handle) -> Unit
extern "native badger_http.stop" fn http_stop(server: native.Handle) -> Unit
extern "native badger_http.port" fn http_port(server: native.Handle) -> Int
extern "native badger_http.stats" fn http_stats(server: native.Handle) -> LimitStats
extern "intrinsic" fn http_default_limits() -> Limits
extern "intrinsic" fn http_stream_buffer_default() -> Int
extern "intrinsic" fn http_body_text(body: Bytes) -> String
extern "intrinsic" fn service_scope() -> Int
extern "intrinsic" fn service_spawn(scope: Int, f: fn() -> Unit) -> Unit
extern "intrinsic" fn service_close(scope: Int) -> Unit
extern "intrinsic" fn cleanup_push(f: fn() -> Unit) -> Int
extern "intrinsic" fn cleanup_remove(handle: Int) -> Unit
extern "intrinsic" fn task_id() -> Int
extern "intrinsic" fn task_cancel(id: Int) -> Unit
extern "intrinsic" fn trace_event<T>(name: Symbol, data: T) -> Unit

/// Package a request callback. An error is answered with the status it
/// carries (500 unless it chooses one).
pub fn handler<E, Eff>(f: fn(Request) -> Result<Response, E> !Eff) -> Handler where E: Display, E: HttpStatus, fn(Request) -> Result<Response, E> !Eff: Transfer {
    {
        run: fn(request, _exchange) {
            match f(request) {
                .ok(r) => Reply.full(r),
                .err(e) => {
                    trace_event(#http/handler_error, { message: e.display() })
                    Reply.full(error_reply(e))
                },
            }
        },
    }
}

/// Package a streaming request callback; an error before streaming starts
/// is answered with the status it carries.
pub fn streaming_handler<E, Eff>(f: fn(Request) -> Result<Streamed, E> !Eff) -> Handler where E: Display, E: HttpStatus, fn(Request) -> Result<Streamed, E> !Eff: Transfer {
    {
        run: fn(request, _exchange) {
            match f(request) {
                .ok(s) => Reply.stream(s),
                .err(e) => {
                    trace_event(#http/handler_error, { message: e.display() })
                    Reply.full(error_reply(e))
                },
            }
        },
    }
}

/// A streamed reply of `chunks` with the given status and content type.
pub fn stream(status: Int, content_type: String, chunks: Seq<Bytes>) -> Result<Streamed, Error> {
    ok({ status, headers: map { "content-type" => content_type }, chunks })
}

// ---------------------------------------------------------------- websockets

/// Whether the request asks to upgrade to a WebSocket.
pub fn is_websocket(request: Request) -> Bool {
    match request.headers.get("upgrade") {
        .some(v) => texts.contains(texts.to_lower(v), "websocket"),
        .none => false,
    }
}

/// Package a WebSocket session callback: each upgrade request runs it in
/// its own task (see `RequestScope.websocket`); other requests are
/// answered 426 (Upgrade Required).
pub fn websocket_handler<E, Eff>(session: fn(Request, websocket.WebSocket) -> Result<Unit, E> !Eff) -> Handler where E: Display, fn(Request, websocket.WebSocket) -> Result<Unit, E> !Eff: Transfer {
    {
        run: fn(request, exchange) {
            let _ = run_websocket(exchange, request, fn(ws: websocket.WebSocket) -> Result<Unit, E> { session(request, ws) })
            Reply.sent
        },
    }
}

fn run_websocket<E>(ex: Exchange, request: Request, session: fn(websocket.WebSocket) -> Result<Unit, E>) -> Sent where E: Display {
    let conn = match ex.conn {
        .some(c) => c,
        .none => {
            send_full(ex, error_response(501, "websockets need a live connection"))
            return { status: 501 }
        },
    }
    if !is_websocket(request) {
        send_full(ex, error_response(426, "websocket upgrade required"))
        return { status: 426 }
    }
    match http_ws_accept(conn, "") {
        .ok(ws) => {
            let guard = cleanup_push(fn() { let _ = ws.close() })
            match session(ws) {
                .ok(_) => (),
                .err(e) => trace_event(#http/websocket_error, { message: e.display() }),
            }
            cleanup_remove(guard)
            let _ = ws.close()
        },
        .err(e) => trace_event(#http/websocket_error, { message: e.message }),
    }
    { status: 101 }
}

// ---------------------------------------------------------------- server-sent events

/// One server-sent event. `data` may span lines; an event with only a
/// `comment` is a comment line (a keep-alive).
pub struct Event {
    pub data: String,
    pub event: Option<String>,
    pub id: Option<String>,
    /// the client's reconnection delay, in milliseconds
    pub retry: Option<Int>,
    pub comment: Option<String>,
}

impl Event {
    /// The event with this type (`event:`), for `addEventListener(name)`.
    pub fn named(self: &Self, name: String) -> Event { { ..self, event: Option.some(name) } }
    /// The event with this id (`id:`), sent back as `Last-Event-ID` on
    /// reconnection.
    pub fn with_id(self: &Self, id: String) -> Event { { ..self, id: Option.some(id) } }
    /// The event asking the client to wait `millis` before reconnecting.
    pub fn with_retry(self: &Self, millis: Int) -> Event { { ..self, retry: Option.some(millis) } }
}

/// An unnamed event carrying `data`.
pub fn event(data: String) -> Event {
    { data, event: Option.none, id: Option.none, retry: Option.none, comment: Option.none }
}

/// A comment line (ignored by clients; keeps idle connections open).
pub fn comment(note: String) -> Event { { ..event(""), comment: Option.some(note) } }

/// A streamed `text/event-stream` reply of `events`. Each event is sent
/// as it is produced; if the client goes away the request task is
/// cancelled, so a sequence waiting for its next event (a subscription)
/// stops too and its cleanups run.
pub fn events(events: Seq<Event>) -> Result<Streamed, Error> {
    ok({ status: 200, headers: event_headers(), chunks: events.map(fn(e: Event) -> Bytes { text_to_bytes(encode_event(e)) }) })
}

fn event_headers() -> Map<String, String> {
    map { "content-type" => "text/event-stream", "cache-control" => "no-cache" }
}

/// One line of a field: line breaks would end it early.
fn one_line(value: String) -> String { texts.replace(texts.replace(value, "\r", ""), "\n", "") }

/// An event in the wire format (ends with the blank line that dispatches
/// it).
pub fn encode_event(e: Event) -> String {
    var out = ""
    match e.comment {
        .some(c) => { for line in texts.split(normalize_breaks(c), "\n") { out = $"{out}: {line}\n" } },
        .none => (),
    }
    match e.event {
        .some(name) => { out = $"{out}event: {one_line(name)}\n" },
        .none => (),
    }
    match e.id {
        .some(id) => { out = $"{out}id: {one_line(id)}\n" },
        .none => (),
    }
    match e.retry {
        .some(ms) => { out = $"{out}retry: {ms}\n" },
        .none => (),
    }
    if !(e.data == "" && e.comment.is_some()) {
        for line in texts.split(normalize_breaks(e.data), "\n") {
            out = $"{out}data: {line}\n"
        }
    }
    $"{out}\n"
}

fn normalize_breaks(s: String) -> String { texts.replace(texts.replace(s, "\r\n", "\n"), "\r", "\n") }

/// The events in an `text/event-stream` body (as a client sees them:
/// comments are skipped, and a block without data dispatches nothing).
pub fn parse_events(body: String) -> List<Event> {
    var out = list.builder<Event>()
    var current = event("")
    var data: List<String> = list.empty()
    for line in texts.split(normalize_breaks(body), "\n") {
        if line == "" {
            if !data.is_empty() {
                out.append({ ..current, data: texts.join(data, "\n") })
            }
            current = event("")
            data = list.empty()
        } else if !texts.starts_with(line, ":") {
            let parts = texts.split(line, ":")
            let field = parts.first().unwrap_or("")
            var value = texts.join(parts.slice(1, parts.len()), ":")
            if texts.starts_with(value, " ") {
                value = texts.slice(value, 1, texts.len(value)).unwrap_or("")
            }
            if field == "data" {
                data = data.append(value)
            } else if field == "event" {
                current = current.named(value)
            } else if field == "id" {
                current = current.with_id(value)
            } else if field == "retry" {
                match texts.parse_int(value) {
                    .some(ms) => { current = current.with_retry(ms) },
                    .none => (),
                }
            }
        }
    }
    out.finish()
}

/// The `Last-Event-ID` a reconnecting client sent, if any.
pub fn last_event_id(request: Request) -> Option<String> { request.headers.get("last-event-id") }

/// Send a stream on a live exchange. A watcher in the server's scope
/// cancels the request task if the client goes away first, so a producer
/// parked waiting for its next item stops too.
fn pump(conn: native.Handle, service: Int, status: Int, headers: Map<String, String>, chunks: Seq<Bytes>) -> Unit {
    http_stream_begin(conn, status, headers)
    let me = task_id()
    service_spawn(service, fn() {
        if http_stream_watch(conn) {
            task_cancel(me)
        }
    })
    for chunk in chunks {
        if !http_stream_chunk(conn, chunk) {
            break
        }
    }
    http_stream_end(conn)
}

extern "intrinsic" fn bytes_concat(a: Bytes, b: Bytes) -> Bytes

/// Run a handler in-process on `request` (tests and adapters): a streamed
/// reply is collected into the body.
pub fn call(h: Handler, request: Request) -> Response {
    let sink: Cell<Response> = Cell.new(error_response(500, "no reply"))
    match h.run(request, { conn: Option.none, sink: Option.some(sink), service: 0 }) {
        .full(r) => r,
        .sent => sink.get(),
        .stream(s) => {
            var body = text_to_bytes("")
            for chunk in s.chunks {
                body = bytes_concat(body, chunk)
            }
            { status: s.status, headers: s.headers, body }
        },
    }
}

/// Run a handler in-process (tests): the status and body text of its reply
/// to `method path` with `body` (`""` for none).
pub fn call_text(h: Handler, method: Symbol, path: String, body: String) -> (Int, String) {
    let response = call(h, request(method, path, body))
    (response.status, response.body.to_text().unwrap_or(""))
}

/// A request value for `call`.
pub fn request(method: Symbol, path: String, body: String) -> Request {
    { method, path, headers: map {}, body: text_to_bytes(body) }
}

/// The runtime-configured default limits.
pub fn limits() -> Limits { http_default_limits() }

fn error_response(status: Int, message: String) -> Response {
    { status, headers: map { "content-type" => "application/json" }, body: codec.encode({ error: message }) }
}

/// A JSON reply with the given status.
pub fn json<T>(status: Int, value: T) -> Result<Response, Error> where T: Codec {
    ok({ status, headers: map { "content-type" => "application/json" }, body: codec.encode(value) })
}

/// The response with another status: a handler that built its body by
/// hand (with `http.text`, `http.json`, or its own bytes) attaches the
/// status it means with this.
pub fn with_status(response: Response, status: Int) -> Response {
    { status, headers: response.headers, body: response.body }
}

/// The reason phrase of a status code ("not found" for 404).
pub fn status_text(code: Int) -> String {
    match code {
        200 => "ok",
        201 => "created",
        202 => "accepted",
        204 => "no content",
        301 => "moved permanently",
        302 => "found",
        304 => "not modified",
        400 => "bad request",
        401 => "unauthorized",
        403 => "forbidden",
        404 => "not found",
        405 => "method not allowed",
        406 => "not acceptable",
        409 => "conflict",
        410 => "gone",
        413 => "payload too large",
        415 => "unsupported media type",
        418 => "i'm a teapot",
        422 => "unprocessable entity",
        426 => "upgrade required",
        429 => "too many requests",
        431 => "request header fields too large",
        500 => "internal server error",
        501 => "not implemented",
        502 => "bad gateway",
        503 => "service unavailable",
        504 => "gateway timeout",
        _ => "error",
    }
}

/// The reply for an error: the status it carries and, for a client
/// error, its code (`http_code`, the variant name unless the error says
/// otherwise) and message, as `{"error": "not_found", "message": "..."}`. A
/// server error keeps both to itself (they are internal details, not the
/// client's business): its reply names the status only.
pub fn error_reply<E>(error: E) -> Response where E: Display, E: HttpStatus {
    let code = error.http_status()
    if code >= 500 {
        { status: code, headers: map { "content-type" => "application/json" }, body: codec.encode({ error: status_text(code) }) }
    } else {
        { status: code, headers: map { "content-type" => "application/json" }, body: codec.encode({ error: $"{error.http_code()}", message: error.display() }) }
    }
}

/// The reply for an application error: the status it carries and, for a
/// client error, its message. The route system does this by itself; use
/// it where a reply is built by hand (a pipeline stage, for instance).
pub fn reply_for_error<E>(error: E) -> Result<Response, Error> where E: Display, E: HttpStatus {
    ok(error_reply(error))
}

pub fn text(status: Int, body: String) -> Result<Response, Error> {
    ok({ status, headers: map { "content-type" => "text/plain" }, body: text_bytes(body) })
}

extern "intrinsic" fn text_to_bytes(text: String) -> Bytes

fn text_bytes(s: String) -> Bytes { text_to_bytes(s) }

pub fn body_text(request: Request) -> String { http_body_text(request.body) }

/// Start serving with the default limits; requests run as isolated sibling
/// tasks of the server.
pub fn listen(address: String, port: U16, h: Handler) -> Result<Server, Error> {
    listen_with(address, port, h, limits())
}

/// Start serving with explicit limits.
pub fn listen_with(address: String, port: U16, h: Handler, limits: Limits) -> Result<Server, Error> {
    let all: ListenLimits = {
        max_body_bytes: limits.max_body_bytes,
        max_header_bytes: limits.max_header_bytes,
        max_in_flight: limits.max_in_flight,
        max_stream_buffer_bytes: http_stream_buffer_default(),
    }
    let handle = http_listen(address, port, all)?
    let scope = service_scope()
    service_spawn(scope, fn() { accept_requests(handle, scope, h) })
    ok({ handle, scope })
}

/// Take admitted requests until the server stops, each in its own task.
fn accept_requests(server: native.Handle, scope: Int, h: Handler) -> Unit {
    loop {
        match http_accept(server) {
            .ok(incoming) => service_spawn(scope, fn() { serve(h, scope, incoming) }),
            .err(_) => break,
        }
    }
}

/// One request's task: a defect or cancellation before the reply is sent
/// answers 500 (or cuts a started stream short).
fn serve(h: Handler, service: Int, incoming: Incoming) -> Unit {
    let conn = incoming.exchange
    let guard = cleanup_push(fn() { http_abort(conn) })
    let request: Request = { method: incoming.method, path: incoming.path, headers: incoming.headers, body: incoming.body }
    match h.run(request, { conn: Option.some(conn), sink: Option.none, service }) {
        .sent => (),
        .full(response) => http_respond(conn, response.status, response.headers, response.body),
        .stream(s) => pump(conn, service, s.status, s.headers, s.chunks),
    }
    cleanup_remove(guard)
}

/// Effective limits of a running server and its rejection count.
pub fn stats(s: Server) -> LimitStats { http_stats(s.handle) }

/// Stop admission and settle in-flight requests.
pub fn stop(s: Server) -> Unit {
    http_stop(s.handle)
    service_close(s.scope)
}

pub fn port(s: Server) -> Int { http_port(s.handle) }

fn server_init(scope: system.InitScope, config: { address: String, port: U16, handler: Handler }) -> Result<Server, Error> {
    let s = listen(config.address, config.port, config.handler)?
    scope.on_halt(fn() -> Result<Unit, Error> {
        stop(s)
        ok(())
    })
    ok(s)
}

/// Provider of a managed server for `{address, port, handler}` (default
/// limits from the runtime configuration).
pub let server = system.provider({ name: #http/server, init: server_init })

fn limited_server_init(scope: system.InitScope, config: { address: String, port: U16, handler: Handler, limits: Limits }) -> Result<Server, Error> {
    let s = listen_with(config.address, config.port, config.handler, config.limits)?
    scope.on_halt(fn() -> Result<Unit, Error> {
        stop(s)
        ok(())
    })
    ok(s)
}

/// Provider of a managed server with explicit `limits`.
pub let limited_server = system.provider({ name: #http/limited_server, init: limited_server_init })
