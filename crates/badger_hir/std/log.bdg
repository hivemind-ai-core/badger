// Structured logs. Each record has a level, a message, and fields (any
// `Codec` record, encoded by its schema) merged with the context of
// enclosing `with` calls; spawned tasks inherit their parent's context.
// Records go to standard error as text (`2026-10-16T08:04:05.123Z INFO
// order placed id=7`) or JSON lines, by `[runtime] log_level` (`trace`,
// `debug`, `info`, `warn`, `error`, `off`; default `info`) and `log_format`
// (`text`, `json`, `none`), or `BADGER_LOG_LEVEL` / `BADGER_LOG_FORMAT`. A
// level below the threshold costs one check; logging never fails.

extern "intrinsic" fn log_enabled(level: Int) -> Bool
extern "intrinsic" fn log_emit<T>(level: Int, message: String, fields: T) -> Unit
extern "intrinsic" fn log_push<T>(fields: T) -> Unit
extern "intrinsic" fn log_pop() -> Unit

/// Whether records of `level` (0 trace .. 4 error) are written.
pub fn enabled(level: Int) -> Bool { log_enabled(level) }

pub fn trace<T>(message: String, fields: T) -> Unit where T: Codec { log_emit(0, message, fields) }

pub fn debug<T>(message: String, fields: T) -> Unit where T: Codec { log_emit(1, message, fields) }

pub fn info<T>(message: String, fields: T) -> Unit where T: Codec { log_emit(2, message, fields) }

pub fn warn<T>(message: String, fields: T) -> Unit where T: Codec { log_emit(3, message, fields) }

pub fn error<T>(message: String, fields: T) -> Unit where T: Codec { log_emit(4, message, fields) }

/// Run `body` with `fields` added to every record it (and tasks it
/// spawns) writes.
pub fn with<T, R>(fields: T, body: fn() -> R) -> R where T: Codec {
    log_push(fields)
    let r = body()
    log_pop()
    r
}
