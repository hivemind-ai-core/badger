// Immutable byte storage.

extern "intrinsic" fn bytes_len(b: Bytes) -> Int
extern "intrinsic" fn bytes_slice(b: Bytes, start: Int, end: Int) -> Option<Bytes>
extern "intrinsic" fn bytes_concat(a: Bytes, b: Bytes) -> Bytes
extern "intrinsic" fn bytes_to_list(b: Bytes) -> List<Byte>
extern "intrinsic" fn bytes_join(parts: List<Bytes>, sep: Bytes) -> Bytes
extern "intrinsic" fn bytes_hex(b: Bytes) -> String
extern "intrinsic" fn text_to_bytes(text: String) -> Bytes
extern "intrinsic" fn text_from_bytes(bytes: Bytes) -> Result<String, String>
extern "intrinsic" fn bytes_from_buffer(buffer: Buffer<Byte>) -> Bytes
extern "intrinsic" fn bytes_from_list(list: List<Byte>) -> Bytes
extern "intrinsic" fn bytes_find(b: Bytes, needle: Bytes, from: Int) -> Option<Int>
extern "intrinsic" fn bytes_at(b: Bytes, index: Int) -> Option<Byte>

import std.list

/// The byte at `index`.
pub fn get(b: Bytes, index: Int) -> Option<Byte> { bytes_at(b, index) }

/// The index of the first `needle` at or after `from`.
pub fn index_of(b: Bytes, needle: Bytes, from: Int) -> Option<Int> { bytes_find(b, needle, from) }

pub fn starts_with(b: Bytes, prefix: Bytes) -> Bool {
    match bytes_slice(b, 0, bytes_len(prefix)) {
        .some(head) => head == prefix,
        .none => false,
    }
}

pub fn ends_with(b: Bytes, suffix: Bytes) -> Bool {
    let n = bytes_len(b)
    let k = bytes_len(suffix)
    if k > n {
        return false
    }
    match bytes_slice(b, n - k, n) {
        .some(tail) => tail == suffix,
        .none => false,
    }
}

/// The pieces between occurrences of `sep` (a non-empty separator).
pub fn split(b: Bytes, sep: Bytes) -> List<Bytes> {
    let out = list.builder<Bytes>()
    let n = bytes_len(b)
    let k = bytes_len(sep)
    if k == 0 {
        out.append(b)
        return out.finish()
    }
    var start = 0
    loop {
        match bytes_find(b, sep, start) {
            .some(i) => {
                out.append(bytes_slice(b, start, i).unwrap_or(b))
                start = i + k
            },
            .none => {
                out.append(bytes_slice(b, start, n).unwrap_or(b))
                break
            },
        }
    }
    out.finish()
}

/// The parts with `sep` between them (one copy of each).
pub fn join(parts: List<Bytes>, sep: Bytes) -> Bytes { bytes_join(parts, sep) }

pub fn len(b: Bytes) -> Int { bytes_len(b) }
/// Checked byte slice.
pub fn slice(b: Bytes, start: Int, end: Int) -> Option<Bytes> { bytes_slice(b, start, end) }
pub fn concat(a: Bytes, b: Bytes) -> Bytes { bytes_concat(a, b) }
pub fn to_list(b: Bytes) -> List<Byte> { bytes_to_list(b) }
pub fn hex(b: Bytes) -> String { bytes_hex(b) }
/// UTF-8 encoding of a string.
pub fn from_text(s: String) -> Bytes { text_to_bytes(s) }
/// Validate UTF-8.
pub fn to_text(b: Bytes) -> Result<String, String> { text_from_bytes(b) }

/// The text, or `default` when the bytes are not valid text.
pub fn to_text_or(b: Bytes, default: String) -> String {
    match text_from_bytes(b) {
        .ok(s) => s,
        .err(_) => default,
    }
}
/// Consume a byte buffer into immutable bytes.
pub fn freeze(buffer: Buffer<Byte>) -> Bytes { bytes_from_buffer(buffer) }
pub fn from_list(list: List<Byte>) -> Bytes { bytes_from_list(list) }

impl Bytes {
    pub fn len(self: &Self) -> Int { bytes_len(self) }
    pub fn is_empty(self: &Self) -> Bool { bytes_len(self) == 0 }
    pub fn get(self: &Self, index: Int) -> Option<Byte> { bytes_at(self, index) }
    pub fn slice(self: &Self, start: Int, end: Int) -> Option<Bytes> { bytes_slice(self, start, end) }
    pub fn index_of(self: &Self, needle: Bytes) -> Option<Int> { bytes_find(self, needle, 0) }
    pub fn starts_with(self: &Self, prefix: Bytes) -> Bool { starts_with(self, prefix) }
    pub fn ends_with(self: &Self, suffix: Bytes) -> Bool { ends_with(self, suffix) }
    pub fn split(self: &Self, sep: Bytes) -> List<Bytes> { split(self, sep) }
    pub fn concat(self: &Self, other: Bytes) -> Bytes { bytes_concat(self, other) }
    pub fn hex(self: &Self) -> String { bytes_hex(self) }
    pub fn to_text(self: &Self) -> Result<String, String> { text_from_bytes(self) }
    /// The text, or `default` when the bytes are not valid text.
    pub fn to_text_or(self: &Self, default: String) -> String { to_text_or(self, default) }
}
