// Filesystem access. Operations run on the blocking pool and park the
// calling task instead of blocking the worker.

import std.io
import std.native

extern "intrinsic" fn fs_read_text(path: String) -> Result<String, io.Error>
extern "intrinsic" fn fs_write_text(path: String, text: String) -> Result<Unit, io.Error>
extern "intrinsic" fn fs_exists(path: String) -> Bool
extern "intrinsic" fn fs_root(path: String) -> Result<String, io.Error>
extern "intrinsic" fn fs_within(root: String, path: String) -> Result<String, io.Error>
extern "intrinsic" fn fs_list(path: String) -> Result<List<String>, io.Error>

// the `badger_fs` native module (crates/badger_fs)
extern "native badger_fs.read_bytes" fn fs_read_bytes(path: String) -> Result<Bytes, io.Error> !{Io, Wait}
extern "native badger_fs.write_bytes" fn fs_write_bytes(path: String, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.append" fn fs_append_text(path: String, text: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.append" fn fs_append_bytes(path: String, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.remove_file" fn fs_remove_file(path: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.remove_dir" fn fs_remove_dir(path: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.remove_all" fn fs_remove_all(path: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.rename" fn fs_rename(from: String, to: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.copy" fn fs_copy(from: String, to: String) -> Result<Int, io.Error> !{Io, Wait}
extern "native badger_fs.create_dir" fn fs_create_dir(path: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.create_dir_all" fn fs_create_dir_all(path: String) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.metadata" fn fs_metadata(path: String) -> Result<Metadata, io.Error> !{Io, Wait}
extern "native badger_fs.walk" fn fs_walk(path: String) -> Result<List<String>, io.Error> !{Io, Wait}
extern "native badger_fs.temp_dir" fn fs_temp_dir() -> String !{Io}
extern "native badger_fs.make_temp_dir" fn fs_make_temp_dir(prefix: String) -> Result<String, io.Error> !{Io, Wait}
extern "intrinsic" fn identity<A, B>(value: A) -> B

extern "native badger_fs.open" fn fs_open(path: String, mode: String) -> Result<native.Handle, io.Error> !{Io, Wait}
extern "native badger_fs.read" fn fs_file_read(file: native.Handle, max: Int) -> Result<Option<Bytes>, io.Error> !{Io, Wait}
extern "native badger_fs.write" fn fs_file_write(file: native.Handle, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.flush" fn fs_file_flush(file: native.Handle) -> Result<Unit, io.Error> !{Io, Wait}
extern "native badger_fs.close" fn fs_file_close(file: native.Handle) -> Result<Unit, io.Error> !{Io, Wait}

/// An open file: an `io.Reader` and `io.Writer` (as its mode allows).
/// Closed by `close`, or once nothing can reach it.
pub struct File {
    handle: native.Handle,
}

impl io.Reader for File {
    fn read(self: &Self, max: Int) -> Result<Option<Bytes>, io.Error> !{Io, Wait, State} { fs_file_read(self.handle, max) }
}

impl io.Writer for File {
    fn write(self: &Self, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait, State} { fs_file_write(self.handle, data) }
    fn flush(self: &Self) -> Result<Unit, io.Error> !{Io, Wait, State} { fs_file_flush(self.handle) }
}

impl File {
    /// Flush and close; later reads and writes fail with `:io/closed`.
    pub fn close(self: &Self) -> Result<Unit, io.Error> !{Io, Wait} { fs_file_close(self.handle) }
    pub fn write_text(self: &Self, text: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_file_write(self.handle, text_to_bytes(text)) }
}

extern "intrinsic" fn text_to_bytes(text: String) -> Bytes

fn opened(path: String, mode: String) -> Result<File, io.Error> !{Io, Wait} {
    let handle = fs_open(path, mode)?
    ok({ handle })
}

/// Open a file for reading.
pub fn open(path: String) -> Result<File, io.Error> !{Io, Wait} { opened(path, "read") }
/// Open a file for writing, creating it or emptying it.
pub fn create(path: String) -> Result<File, io.Error> !{Io, Wait} { opened(path, "write") }
/// Create a new file for writing (`:io/already_exists` if there is one).
pub fn create_new(path: String) -> Result<File, io.Error> !{Io, Wait} { opened(path, "create") }
/// Open a file for adding to its end, creating it if absent.
pub fn append_to(path: String) -> Result<File, io.Error> !{Io, Wait} { opened(path, "append") }

/// What is at a path: `:file`, `:dir`, `:symlink` (not followed), or
/// `:other`, with its size in bytes and when it last changed.
pub type Metadata = { kind: Symbol, size: Int, modified_nanos: Int, readonly: Bool }

/// When it last changed.
pub fn modified(m: Metadata) -> Timestamp { identity(m.modified_nanos) }

pub fn read_text(path: String) -> Result<String, io.Error> !{Io, Wait} { fs_read_text(path) }
pub fn read_bytes(path: String) -> Result<Bytes, io.Error> !{Io, Wait} { fs_read_bytes(path) }
pub fn write_bytes(path: String, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait} { fs_write_bytes(path, data) }
/// Append to a file, creating it if absent.
pub fn append_text(path: String, text: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_append_text(path, text) }
pub fn append_bytes(path: String, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait} { fs_append_bytes(path, data) }
pub fn remove_file(path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_remove_file(path) }
/// Remove an empty directory.
pub fn remove_dir(path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_remove_dir(path) }
/// Remove a file, or a directory and everything in it (symlinks are
/// removed, not followed).
pub fn remove_all(path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_remove_all(path) }
/// Move or rename (replacing a file at `to`).
pub fn rename(from: String, to: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_rename(from, to) }
/// Copy a file; the number of bytes copied.
pub fn copy(from: String, to: String) -> Result<Int, io.Error> !{Io, Wait} { fs_copy(from, to) }
pub fn create_dir(path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_create_dir(path) }
/// Create a directory and any missing parents (fine if it exists).
pub fn create_dir_all(path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_create_dir_all(path) }
pub fn metadata(path: String) -> Result<Metadata, io.Error> !{Io, Wait} { fs_metadata(path) }
pub fn is_dir(path: String) -> Bool !{Io, Wait} {
    match fs_metadata(path) {
        .ok(m) => m.kind == :dir,
        .err(_) => false,
    }
}
pub fn is_file(path: String) -> Bool !{Io, Wait} {
    match fs_metadata(path) {
        .ok(m) => m.kind == :file,
        .err(_) => false,
    }
}
/// Every file under a directory, as paths relative to it, sorted
/// (symlinks are listed, not followed).
pub fn walk(path: String) -> Result<List<String>, io.Error> !{Io, Wait} { fs_walk(path) }
/// The system's directory for temporary files.
pub fn temp_dir() -> String !{Io} { fs_temp_dir() }
/// A new, empty directory only this user can read, under `temp_dir()`.
pub fn make_temp_dir(prefix: String) -> Result<String, io.Error> !{Io, Wait} { fs_make_temp_dir(prefix) }
pub fn write_text(path: String, text: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_write_text(path, text) }
pub fn exists(path: String) -> Bool !{Io} { fs_exists(path) }
/// The names in a directory, sorted.
pub fn list(path: String) -> Result<List<String>, io.Error> !{Io, Wait} { fs_list(path) }

/// Authority over one directory tree: paths are relative to it, and none
/// (absolute, `..`, or through a symlink) reaches outside it. Only `root`
/// and `Dir.sub` make one, so a function given a `Dir` can touch that tree
/// and nothing else through it; `reader` narrows it to reading.
pub struct Dir {
    root: String,
}

/// Read-only authority over one directory tree (see `Dir`).
pub struct ReadDir {
    root: String,
}

/// The directory tree at `path`, which must exist.
pub fn root(path: String) -> Result<Dir, io.Error> !{Io} {
    let d: Dir = { root: fs_root(path)? }
    ok(d)
}

impl Dir {
    /// The tree's absolute path.
    pub fn path(self: &Self) -> String { self.root }
    pub fn read_text(self: &Self, path: String) -> Result<String, io.Error> !{Io, Wait} {
        fs_read_text(fs_within(self.root, path)?)
    }
    pub fn write_text(self: &Self, path: String, text: String) -> Result<Unit, io.Error> !{Io, Wait} {
        fs_write_text(fs_within(self.root, path)?, text)
    }
    pub fn exists(self: &Self, path: String) -> Bool !{Io} {
        match fs_within(self.root, path) {
            .ok(p) => fs_exists(p),
            .err(_) => false,
        }
    }
    /// The names in a directory of the tree (`"."` for its top), sorted.
    pub fn list(self: &Self, path: String) -> Result<List<String>, io.Error> !{Io, Wait} {
        fs_list(fs_within(self.root, path)?)
    }
    pub fn read_bytes(self: &Self, path: String) -> Result<Bytes, io.Error> !{Io, Wait} { fs_read_bytes(fs_within(self.root, path)?) }
    pub fn write_bytes(self: &Self, path: String, data: Bytes) -> Result<Unit, io.Error> !{Io, Wait} {
        fs_write_bytes(fs_within(self.root, path)?, data)
    }
    pub fn append_text(self: &Self, path: String, text: String) -> Result<Unit, io.Error> !{Io, Wait} {
        fs_append_text(fs_within(self.root, path)?, text)
    }
    pub fn remove_file(self: &Self, path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_remove_file(fs_within(self.root, path)?) }
    /// Remove a file or a subtree (never the tree's top).
    pub fn remove_all(self: &Self, path: String) -> Result<Unit, io.Error> !{Io, Wait} {
        let p = fs_within(self.root, path)?
        if p == self.root {
            return err({ kind: :io/permission_denied, message: "cannot remove the top of a tree through it" })
        }
        fs_remove_all(p)
    }
    pub fn rename(self: &Self, from: String, to: String) -> Result<Unit, io.Error> !{Io, Wait} {
        fs_rename(fs_within(self.root, from)?, fs_within(self.root, to)?)
    }
    pub fn copy(self: &Self, from: String, to: String) -> Result<Int, io.Error> !{Io, Wait} {
        fs_copy(fs_within(self.root, from)?, fs_within(self.root, to)?)
    }
    pub fn create_dir_all(self: &Self, path: String) -> Result<Unit, io.Error> !{Io, Wait} { fs_create_dir_all(fs_within(self.root, path)?) }
    pub fn metadata(self: &Self, path: String) -> Result<Metadata, io.Error> !{Io, Wait} { fs_metadata(fs_within(self.root, path)?) }
    /// Every file under a directory of the tree, relative to it, sorted.
    pub fn walk(self: &Self, path: String) -> Result<List<String>, io.Error> !{Io, Wait} { fs_walk(fs_within(self.root, path)?) }
    pub fn open(self: &Self, path: String) -> Result<File, io.Error> !{Io, Wait} { opened(fs_within(self.root, path)?, "read") }
    pub fn create(self: &Self, path: String) -> Result<File, io.Error> !{Io, Wait} { opened(fs_within(self.root, path)?, "write") }
    pub fn append_to(self: &Self, path: String) -> Result<File, io.Error> !{Io, Wait} { opened(fs_within(self.root, path)?, "append") }
    /// A narrower tree inside this one.
    pub fn sub(self: &Self, path: String) -> Result<Dir, io.Error> !{Io} {
        let d: Dir = { root: fs_root(fs_within(self.root, path)?)? }
        ok(d)
    }
    /// The same tree, for reading only.
    pub fn reader(self: &Self) -> ReadDir {
        let r: ReadDir = { root: self.root }
        r
    }
}

impl ReadDir {
    pub fn path(self: &Self) -> String { self.root }
    pub fn read_text(self: &Self, path: String) -> Result<String, io.Error> !{Io, Wait} {
        fs_read_text(fs_within(self.root, path)?)
    }
    pub fn exists(self: &Self, path: String) -> Bool !{Io} {
        match fs_within(self.root, path) {
            .ok(p) => fs_exists(p),
            .err(_) => false,
        }
    }
    pub fn list(self: &Self, path: String) -> Result<List<String>, io.Error> !{Io, Wait} {
        fs_list(fs_within(self.root, path)?)
    }
    pub fn read_bytes(self: &Self, path: String) -> Result<Bytes, io.Error> !{Io, Wait} { fs_read_bytes(fs_within(self.root, path)?) }
    pub fn metadata(self: &Self, path: String) -> Result<Metadata, io.Error> !{Io, Wait} { fs_metadata(fs_within(self.root, path)?) }
    pub fn walk(self: &Self, path: String) -> Result<List<String>, io.Error> !{Io, Wait} { fs_walk(fs_within(self.root, path)?) }
    pub fn open(self: &Self, path: String) -> Result<File, io.Error> !{Io, Wait} { opened(fs_within(self.root, path)?, "read") }
    pub fn sub(self: &Self, path: String) -> Result<ReadDir, io.Error> !{Io} {
        let d: ReadDir = { root: fs_root(fs_within(self.root, path)?)? }
        ok(d)
    }
}
