// Process environment.

extern "intrinsic" fn env_args() -> List<String>
extern "intrinsic" fn env_get(name: String) -> Option<String>

/// Program arguments, excluding the executable.
pub fn args() -> List<String> !{Io} { env_args() }

pub fn get(name: String) -> Option<String> !{Io} { env_get(name) }

/// Read access to the named environment variables, and no others: a
/// capability the entry module of a restricted project can hand out.
pub struct Vars {
    names: List<String>,
}

/// A capability reading only `names`.
pub fn vars(names: List<String>) -> Vars !{Io} {
    let v: Vars = { names: names }
    v
}

impl Vars {
    /// The variable's value; `none` for a name this capability does not
    /// cover, as for one that is not set.
    pub fn get(self: &Self, name: String) -> Option<String> !{Io} {
        if self.names.contains(name) { env_get(name) } else { Option.none }
    }
}
