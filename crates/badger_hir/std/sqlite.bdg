// Embedded SQLite storage with scoped transactions.

import std.prelude

import std.system
import std.codec
import std.native
import std.list

pub struct Error {
    pub code: Symbol,
    pub message: String,
    /// The callback error a failed rollback happened after, if any.
    pub cause: Option<dyn prelude.Error>,
}

impl Display for Error {
    fn display(self: &Self) -> String { $"{self.code}: {self.message}" }
}

impl prelude.Error for Error {
    fn code(self: &Self) -> Symbol { self.code }
    fn cause(self: &Self) -> Option<dyn prelude.Error> { self.cause }
}

/// A shareable connection pool, scoped to region `S` (the system or
/// callback that opened it). The region may be elided in annotations:
/// `sqlite.Pool` means `sqlite.Pool<_>`.
pub struct Pool<S: Scope> {
    handle: native.Handle,
}

/// A task-confined transaction, branded with its callback's region.
pub struct Tx<S> {
    handle: native.Handle,
}

/// Things SQL can run against: pools and transactions.
pub protocol Connection {
    fn connection(self: &Self) -> native.Handle
}

// the `badger_sqlite` native module (crates/badger_sqlite): every statement
// runs on a connection's own thread while the calling task waits
extern "native badger_sqlite.open" fn sql_open(path: String) -> Result<native.Handle, native.Error> !{Io, Wait}
extern "native badger_sqlite.close" fn sql_close(pool: native.Handle) -> Unit
extern "native badger_sqlite.is_closed" fn sql_is_closed(pool: native.Handle) -> Bool
extern "native badger_sqlite.execute" fn sql_execute(conn: native.Handle, sql: String, params: List<Data>) -> Result<Int, native.Error> !{Io, Wait}
extern "native badger_sqlite.query" fn sql_query(conn: native.Handle, sql: String, params: List<Data>) -> Result<List<Data>, native.Error> !{Io, Wait}
extern "native badger_sqlite.query_one" fn sql_query_one(conn: native.Handle, sql: String, params: List<Data>) -> Result<Data, native.Error> !{Io, Wait}
extern "native badger_sqlite.begin" fn sql_begin(pool: native.Handle) -> Result<native.Handle, native.Error> !{Io, Wait}
extern "native badger_sqlite.finish" fn sql_finish(tx: native.Handle, commit: Bool) -> Result<Unit, native.Error> !{Io, Wait}
// `codec.from_data`, with `Bool` also read from the integers 0 and 1
extern "intrinsic" fn codec_from_sql_row<T>(data: Data) -> Result<T, codec.DecodeError>
extern "intrinsic" fn cleanup_push(f: fn() -> Unit) -> Int
extern "intrinsic" fn cleanup_remove(handle: Int) -> Unit

/// A native module's error as an `Error`.
fn lift<T>(r: Result<T, native.Error>) -> Result<T, Error> {
    match r {
        .ok(v) => ok(v),
        .err(e) => err({ code: e.kind, message: e.message, cause: Option.none }),
    }
}

impl<S> Connection for Pool<S> {
    fn connection(self: &Self) -> native.Handle { self.handle }
}

impl<S> Connection for Tx<S> {
    fn connection(self: &Self) -> native.Handle { self.handle }
}

pub fn open<S: Scope>(path: String) -> Result<Pool<S>, Error> !{Io, Wait} {
    let h = lift(sql_open(path))?
    let p: Pool<S> = { handle: h }
    ok(p)
}

pub fn close<S: Scope>(pool: Pool<S>) -> Unit { sql_close(pool.handle) }
pub fn is_closed<S: Scope>(pool: Pool<S>) -> Bool { sql_is_closed(pool.handle) }

/// Execute a statement with bound parameters; returns the changed row count.
pub fn execute<C>(conn: C, sql: String, params: List<Data>) -> Result<Int, Error> !{Io, Wait} where C: Connection {
    lift(sql_execute(conn.connection(), sql, params))
}

pub fn query<C>(conn: C, sql: String, params: List<Data>) -> Result<List<Data>, Error> !{Io, Wait} where C: Connection {
    lift(sql_query(conn.connection(), sql, params))
}

/// Exactly one row as `Data`; zero or several rows are an error.
pub fn query_one<C>(conn: C, sql: String, params: List<Data>) -> Result<Data, Error> !{Io, Wait} where C: Connection {
    lift(sql_query_one(conn.connection(), sql, params))
}

fn decode_row<T>(row: Data) -> Result<T, Error> where T: Codec {
    match codec_from_sql_row<T>(row) {
        .ok(v) => ok(v),
        .err(e) => err({ code: #sqlite/decode, message: $"a row does not decode: {e}", cause: Option.none }),
    }
}

/// Rows as `T`, a record whose fields are named like the result's columns
/// (an `Option` field for a column that can be NULL). In a project with
/// `[database] schema`, `badger check` checks a literal statement's columns
/// against `T`.
pub fn query_as<T, C>(conn: C, sql: String, params: List<Data>) -> Result<List<T>, Error> !{Io, Wait} where T: Codec, C: Connection {
    list.try_map(lift(sql_query(conn.connection(), sql, params))?, decode_row)
}

/// Exactly one row, as `T` (see `query_as`).
pub fn query_one_as<T, C>(conn: C, sql: String, params: List<Data>) -> Result<T, Error> !{Io, Wait} where T: Codec, C: Connection {
    decode_row(lift(sql_query_one(conn.connection(), sql, params))?)
}

/// Run `body` in a transaction: commit after `ok`, roll back after `err`,
/// defect, or cancellation. A failed begin or commit is returned even when
/// the body succeeded. A failed rollback after a body error is returned as a
/// `#sqlite/rollback_failed` error whose `cause` is the body's error, so
/// neither failure is discarded.
pub fn transaction<P: Scope, R, E>(pool: Pool<P>, body: for<S: Scope> fn(Tx<S>) -> Result<R, E>) -> Result<R, E> !{Io, Wait} where E: From<Error>, E: prelude.Error {
    match lift(sql_begin(pool.handle)) {
        .err(e) => err(E.from(e)),
        .ok(h) => {
            // a defect or cancellation in the body rolls back
            let guard = cleanup_push(fn() { let _ = sql_finish(h, false) })
            let r = body({ handle: h })
            cleanup_remove(guard)
            match r {
                .ok(v) => match lift(sql_finish(h, true)) {
                    .ok(_) => ok(v),
                    .err(e) => err(E.from(e)),
                },
                .err(e) => match lift(sql_finish(h, false)) {
                    .ok(_) => err(e),
                    .err(re) => {
                        let cause: dyn prelude.Error = e
                        let failure: Error = { code: #sqlite/rollback_failed, message: $"rollback failed: {re.message}", cause: Option.some(cause) }
                        err(E.from(failure))
                    },
                },
            }
        },
    }
}

fn pool_init<S: Scope>(scope: system.InitScope, config: { path: String }) -> Result<Pool<S>, Error> {
    let p = open(config.path)?
    scope.on_halt(fn() -> Result<Unit, Error> {
        close(p)
        ok(())
    })
    ok(p)
}

/// Provider of a pool for `{path: String}`.
pub let pool = system.provider({ name: #sqlite/pool, init: pool_init })
