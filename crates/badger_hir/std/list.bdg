// Paged lists and builders.

import std.array
import std.buffer

extern "intrinsic" fn list_len<T>(list: List<T>) -> Int
extern "intrinsic" fn list_get<T>(list: List<T>, index: Int) -> Option<T>
extern "intrinsic" fn list_builder<T>() -> ListBuilder<T>
extern "intrinsic" fn list_builder_capacity<T>(n: Int) -> ListBuilder<T>
extern "intrinsic" fn list_builder_append<T>(builder: ListBuilder<T>, value: T) -> Unit
extern "intrinsic" fn list_builder_extend<T>(builder: ListBuilder<T>, values: List<T>) -> Unit
extern "intrinsic" fn list_range(start: Int, end: Int) -> List<Int>
extern "intrinsic" fn list_builder_len<T>(builder: ListBuilder<T>) -> Int
extern "intrinsic" fn list_finish<T>(builder: ListBuilder<T>) -> List<T>
extern "intrinsic" fn list_append<T>(list: List<T>, value: T) -> List<T>
extern "intrinsic" fn list_concat<T>(a: List<T>, b: List<T>) -> List<T>
extern "intrinsic" fn list_reverse<T>(list: List<T>) -> List<T>
extern "intrinsic" fn list_slice<T>(list: List<T>, start: Int, end: Int) -> List<T>
extern "intrinsic" fn list_sort<T>(list: List<T>) -> List<T>
extern "intrinsic" fn list_contains<T>(list: List<T>, value: T) -> Bool
extern "intrinsic" fn page_count<T>(list: List<T>) -> Int
extern "intrinsic" fn list_chunks<T>(list: List<T>) -> List<Array<T>>
extern "intrinsic" fn convert_lossy<A, B>(value: A) -> B
extern "intrinsic" fn element_address<T>(list: List<T>, index: Int) -> Int
extern "intrinsic" fn list_page<T>(list: List<T>, index: Int) -> Page
extern "intrinsic" fn list_slot<T>(list: List<T>, index: Int) -> Int
extern "intrinsic" fn page_read<T>(page: Page, slot: Int) -> T
extern "intrinsic" fn list_to_array<T>(list: List<T>) -> Array<T>

/// One fixed-capacity page of list storage.
extern type Page

/// A managed stable reference to one list element. It retains the element's
/// page, so the builder may keep appending (initialized slots never change)
/// and the reference stays valid after the list is finished or dropped.
pub struct ElementRef<T> {
    page: Page,
    slot: Int,
}

impl<T> ElementRef<T> {
    pub fn get(self: &Self) -> T { page_read(self.page, self.slot) }
}

impl<T> List<T> {
    pub fn try_map<U, E>(self: &Self, f: fn(T) -> Result<U, E>) -> Result<List<U>, E> { try_map(self, f) }
    pub fn filter_map<U>(self: &Self, f: fn(T) -> Option<U>) -> List<U> { filter_map(self, f) }
    pub fn flat_map<U>(self: &Self, f: fn(T) -> List<U>) -> List<U> { flat_map(self, f) }
    pub fn find(self: &Self, matches: fn(T) -> Bool) -> Option<T> { find(self, matches) }
    pub fn position(self: &Self, matches: fn(T) -> Bool) -> Option<Int> { position(self, matches) }
    pub fn find_map<U>(self: &Self, f: fn(T) -> Option<U>) -> Option<U> { find_map(self, f) }
    pub fn any(self: &Self, test: fn(T) -> Bool) -> Bool { any(self, test) }
    pub fn all(self: &Self, test: fn(T) -> Bool) -> Bool { all(self, test) }
    pub fn count(self: &Self, test: fn(T) -> Bool) -> Int { count(self, test) }
    pub fn enumerate(self: &Self) -> List<(Int, T)> { enumerate(self) }
    pub fn take(self: &Self, n: Int) -> List<T> { take(self, n) }
    pub fn skip(self: &Self, n: Int) -> List<T> { skip(self, n) }
    pub fn take_while(self: &Self, keep: fn(T) -> Bool) -> List<T> { take_while(self, keep) }
    pub fn skip_while(self: &Self, skip: fn(T) -> Bool) -> List<T> { skip_while(self, skip) }
    pub fn scan<A>(self: &Self, initial: A, f: fn(A, T) -> A) -> List<A> { scan(self, initial, f) }
    pub fn zip<U>(self: &Self, other: List<U>) -> List<(T, U)> { zip(self, other) }
    pub fn min_by<K>(self: &Self, key: fn(T) -> K) -> Option<T> where K: PartialOrd { min_by(self, key) }
    pub fn max_by<K>(self: &Self, key: fn(T) -> K) -> Option<T> where K: PartialOrd { max_by(self, key) }
    pub fn partition(self: &Self, keep: fn(T) -> Bool) -> (List<T>, List<T>) { partition(self, keep) }
    pub fn sort_by<K>(self: &Self, key: fn(T) -> K) -> List<T> where K: PartialOrd { sort_by(self, key) }
    pub fn sort_with(self: &Self, compare: fn(T, T) -> Int) -> List<T> { sort_with(self, compare) }
    pub fn dedup(self: &Self) -> List<T> where T: PartialEq { dedup(self) }
    pub fn unique(self: &Self) -> List<T> where T: Hash { unique(self) }
    pub fn chunks_of(self: &Self, size: Int) -> List<List<T>> { chunks_of(self, size) }
    pub fn group_by<K>(self: &Self, key: fn(T) -> K) -> Map<K, List<T>> where K: Hash { group_by(self, key) }
    pub fn group_by_key<K>(self: &Self, key: fn(T) -> K) -> Map<K, List<T>> where K: Hash { group_by(self, key) }
    pub fn sort_by_key<K>(self: &Self, key: fn(T) -> K) -> List<T> where K: PartialOrd { sort_by(self, key) }
    pub fn count_by<K>(self: &Self, key: fn(T) -> K) -> Map<K, Int> where K: Hash { count_by(self, key) }
    pub fn try_fold<A, E>(self: &Self, initial: A, f: fn(A, T) -> Result<A, E>) -> Result<A, E> { try_fold(self, initial, f) }
    pub fn try_each<E>(self: &Self, f: fn(T) -> Result<Unit, E>) -> Result<Unit, E> { try_each(self, f) }
    pub fn validate<U, E>(self: &Self, f: fn(T) -> Result<U, E>) -> Result<List<U>, List<E>> { validate(self, f) }
    pub fn len(self: &Self) -> Int { list_len(self) }
    pub fn is_empty(self: &Self) -> Bool { list_len(self) == 0 }
    /// Checked lookup: `none` when out of range (any integer index type).
    pub fn get<I>(self: &Self, index: I) -> Option<T> where I: Integer { list_get(self, convert_lossy<I, Int>(index)) }
    /// Read-only contiguous views of the list's pages.
    pub fn chunks(self: &Self) -> List<Array<T>> { list_chunks(self) }
    pub fn first(self: &Self) -> Option<T> { list_get(self, 0) }
    pub fn last(self: &Self) -> Option<T> { list_get(self, list_len(self) - 1) }
    pub fn contains(self: &Self, value: T) -> Bool where T: PartialEq { list_contains(self, value) }
    /// Lazy view over the elements.
    @fusion(role = source, template = list)
    pub fn seq(self: &Self) -> Seq<T> { of(self) }
    /// Read-only contiguous page views (page directory size).
    pub fn page_count(self: &Self) -> Int { page_count(self) }
    /// A new list with `value` appended (pages are shared, not copied).
    pub fn append(self: &Self, value: T) -> List<T> { list_append(self, value) }
    pub fn concat(self: &Self, other: List<T>) -> List<T> { list_concat(self, other) }
    pub fn reverse(self: &Self) -> List<T> { list_reverse(self) }
    pub fn slice(self: &Self, start: Int, end: Int) -> List<T> { list_slice(self, start, end) }
    pub fn sort(self: &Self) -> List<T> where T: PartialOrd { list_sort(self) }
    pub fn map<U>(self: &Self, f: fn(T) -> U) -> List<U> { map(self, f) }
    pub fn filter(self: &Self, keep: fn(T) -> Bool) -> List<T> { filter(self, keep) }
    pub fn fold<A>(self: &Self, initial: A, f: fn(A, T) -> A) -> A { fold(self, initial, f) }
    /// Stable reference to an element (shareable elements only).
    pub fn element_ref(self: &Self, index: Int) -> ElementRef<T> where T: Share { element_ref(self, index) }
    /// Explicit contiguous collection: copies the elements into an array.
    pub fn to_array(self: &Self) -> Array<T> { list_to_array(self) }
    /// Run `f` on each item, in order.
    pub fn each(self: &Self, f: fn(T) -> Unit) -> Unit { each(self, f) }
    /// The smallest item (the first, on ties).
    pub fn min(self: &Self) -> Option<T> where T: PartialOrd { min(self) }
    /// The largest item (the first, on ties).
    pub fn max(self: &Self) -> Option<T> where T: PartialOrd { max(self) }
    /// The sum of `f` over the items.
    pub fn sum_by(self: &Self, f: fn(T) -> Int) -> Int { sum_by(self, f) }
    /// `sep` between consecutive items.
    pub fn interpose(self: &Self, sep: T) -> List<T> { interpose(self, sep) }
    /// The first `n` items and the rest, in one pass.
    pub fn split_at(self: &Self, n: Int) -> (List<T>, List<T>) { split_at(self, n) }
    /// The leading items `keep` accepts, and the rest, in one pass.
    pub fn split_while(self: &Self, keep: fn(T) -> Bool) -> (List<T>, List<T>) { split_while(self, keep) }
    /// Consecutive runs with equal keys, each a list.
    pub fn chunk_by<K>(self: &Self, key: fn(T) -> K) -> List<List<T>> where K: PartialEq { chunk_by(self, key) }
    /// Consecutive items with equal keys collapsed to the first.
    pub fn dedup_by<K>(self: &Self, key: fn(T) -> K) -> List<T> where K: PartialEq { dedup_by(self, key) }
    /// Overlapping consecutive windows of `size`.
    pub fn windows(self: &Self, size: Int) -> List<List<T>> { windows(self, size) }
    /// How often each distinct item occurs.
    pub fn frequencies(self: &Self) -> Map<T, Int> where T: Hash { frequencies(self) }
    /// One item per distinct key: the last item with that key.
    pub fn index_by<K>(self: &Self, key: fn(T) -> K) -> Map<K, T> where K: Hash { index_by(self, key) }
    /// Pairs combined by `f` (as long as the shorter list).
    pub fn zip_with<U, C>(self: &Self, other: List<U>, f: fn(T, U) -> C) -> List<C> { zip_with(self, other, f) }
    /// Fold while `f` gives `some`; `none` when it stopped early.
    pub fn fold_while<A>(self: &Self, initial: A, f: fn(A, T) -> Option<A>) -> Option<A> { fold_while(self, initial, f) }
    /// The last `n` items.
    pub fn take_last(self: &Self, n: Int) -> List<T> { take_last(self, n) }
    /// All but the last `n` items.
    pub fn drop_last(self: &Self, n: Int) -> List<T> { drop_last(self, n) }
}

fn element_ref<T>(list: List<T>, index: Int) -> ElementRef<T> {
    { page: list_page(list, index), slot: list_slot(list, index) }
}

impl<T> ListBuilder<T> {
    pub fn append(self: &mut Self, value: T) -> Unit { list_builder_append(self, value) }
    /// Append every element of `values` (whole pages are copied, not one
    /// element at a time).
    pub fn extend(self: &mut Self, values: List<T>) -> Unit { list_builder_extend(self, values) }
    pub fn len(self: &Self) -> Int { list_builder_len(self) }
    /// Freeze into a list, transferring the page directory.
    pub fn finish(self: Self) -> List<T> { list_finish(self) }
    /// Stable address of an appended element (pages never move).
    pub fn element_address(self: &Self, index: Int) -> Int { element_address(list_finish_peek(self), index) }
    /// Stable reference to an appended element (shareable elements only).
    pub fn element_ref(self: &Self, index: Int) -> ElementRef<T> where T: Share { element_ref(list_finish_peek(self), index) }
}

extern "intrinsic" fn identity<A, B>(value: A) -> B

fn list_finish_peek<T>(b: ListBuilder<T>) -> List<T> { identity(b) }

pub fn builder<T>() -> ListBuilder<T> {
    list_builder()
}

/// A list built by `fill`, which appends to a builder that is finished
/// when it returns (it cannot escape `fill`).
pub fn build<T>(fill: once fn(&mut ListBuilder<T>) -> Unit) -> List<T> {
    var b = list_builder()
    fill(&mut b)
    list_finish(b)
}

pub fn empty<T>() -> List<T> {
    list_finish(list_builder())
}

/// A lazy sequence over a list.
@fusion(role = source, template = list)
pub fn of<T>(list: List<T>) -> Seq<T> {
    {
        start: fn() {
            let i = Cell.new(0)
            fn() {
                let k = i.get()
                if k < list_len(list) {
                    i.set(k + 1)
                    list_get(list, k)
                } else {
                    Option.none
                }
            }
        },
    }
}

/// Collect a sequence into a list.
@fusion(role = terminal, template = collect)
pub fn collect<T>(items: Seq<T>) -> List<T> {
    let b = list_builder()
    for x in items {
        list_builder_append(b, x)
    }
    list_finish(b)
}

pub fn len<T>(list: List<T>) -> Int { list_len(list) }
pub fn append<T>(list: List<T>, value: T) -> List<T> { list_append(list, value) }
pub fn concat<T>(a: List<T>, b: List<T>) -> List<T> { list_concat(a, b) }
pub fn reverse<T>(list: List<T>) -> List<T> { list_reverse(list) }
pub fn slice<T>(list: List<T>, start: Int, end: Int) -> List<T> { list_slice(list, start, end) }
pub fn sort<T>(list: List<T>) -> List<T> where T: PartialOrd { list_sort(list) }

@fusion(role = stage, template = call)
pub fn map<T, U>(list: List<T>, f: fn(T) -> U) -> List<U> {
    let b = list_builder_capacity<U>(list_len(list))
    for x in list {
        list_builder_append(b, f(x))
    }
    list_finish(b)
}

@fusion(role = stage, template = call)
pub fn filter<T>(list: List<T>, keep: fn(T) -> Bool) -> List<T> {
    let b = list_builder()
    for x in list {
        if keep(x) {
            list_builder_append(b, x)
        }
    }
    list_finish(b)
}

/// One pass for `filter(..).map(..)`: the compiler uses it when the filter
/// callback is side-effect free and cannot fail, so the eager and fused
/// callback orders are indistinguishable. `list` is walked once and no
/// intermediate list is built.
pub fn filter_then_map<T, U>(list: List<T>, keep: fn(T) -> Bool, f: fn(T) -> U) -> List<U> {
    let b = list_builder()
    for x in list {
        if keep(x) {
            list_builder_append(b, f(x))
        }
    }
    list_finish(b)
}

/// One pass for `map(..).filter(..)`: the compiler uses it when the map
/// callback is side-effect free and cannot fail.
pub fn map_then_filter<T, U>(list: List<T>, f: fn(T) -> U, keep: fn(U) -> Bool) -> List<U> {
    let b = list_builder()
    for x in list {
        let y = f(x)
        if keep(y) {
            list_builder_append(b, y)
        }
    }
    list_finish(b)
}

@fusion(role = terminal, template = fold)
pub fn fold<T, A>(list: List<T>, initial: A, f: fn(A, T) -> A) -> A {
    var acc = initial
    for x in list {
        acc = f(acc, x)
    }
    acc
}

// ---------------------------------------------------------------- fallible processing

/// `f` over each item in order, stopping at the first error.
pub fn try_map<T, U, E>(list: List<T>, f: fn(T) -> Result<U, E>) -> Result<List<U>, E> {
    let b = list_builder()
    for x in list {
        list_builder_append(b, f(x)?)
    }
    ok(list_finish(b))
}

/// Fold in order, stopping at the first error.
pub fn try_fold<T, A, E>(list: List<T>, initial: A, f: fn(A, T) -> Result<A, E>) -> Result<A, E> {
    var acc = initial
    for x in list {
        acc = f(acc, x)?
    }
    ok(acc)
}

/// Run `f` on each item in order, stopping at the first error.
pub fn try_each<T, E>(list: List<T>, f: fn(T) -> Result<Unit, E>) -> Result<Unit, E> {
    for x in list {
        f(x)?
    }
    ok(())
}

/// The values of all-successful results, or the first error.
pub fn all_ok<T, E>(results: List<Result<T, E>>) -> Result<List<T>, E> { try_map(results, fn(r) => r) }

/// Validation: `f` over every item, collecting every error (in order)
/// rather than stopping at the first.
pub fn validate<T, U, E>(list: List<T>, f: fn(T) -> Result<U, E>) -> Result<List<U>, List<E>> {
    let good = list_builder()
    let bad = list_builder()
    for x in list {
        match f(x) {
            .ok(v) => list_builder_append(good, v),
            .err(e) => list_builder_append(bad, e),
        }
    }
    let errors = list_finish(bad)
    if list_len(errors) == 0 { ok(list_finish(good)) } else { err(errors) }
}

/// The successes and the failures, each in order.
pub fn partition_results<T, E>(results: List<Result<T, E>>) -> (List<T>, List<E>) {
    let good = list_builder()
    let bad = list_builder()
    for r in results {
        match r {
            .ok(v) => list_builder_append(good, v),
            .err(e) => list_builder_append(bad, e),
        }
    }
    (list_finish(good), list_finish(bad))
}

// ---------------------------------------------------------------- everyday operations

fn at<T>(l: List<T>, i: Int) -> T {
    match list_get(l, i) {
        .some(x) => x,
        .none => panic("list index out of range"),
    }
}

/// `f`'s values, skipping the items it maps to `none`.
pub fn filter_map<T, U>(list: List<T>, f: fn(T) -> Option<U>) -> List<U> {
    let b = list_builder()
    for x in list {
        match f(x) {
            .some(y) => list_builder_append(b, y),
            .none => (),
        }
    }
    list_finish(b)
}

/// Each item's results, flattened in order.
pub fn flat_map<T, U>(list: List<T>, f: fn(T) -> List<U>) -> List<U> {
    let b = list_builder()
    for x in list {
        // each inner list is a whole-page copy, not one append per item
        b.extend(f(x))
    }
    list_finish(b)
}

/// The first item `matches` accepts.
pub fn find<T>(list: List<T>, matches: fn(T) -> Bool) -> Option<T> {
    for x in list {
        if matches(x) {
            return Option.some(x)
        }
    }
    Option.none
}

/// The position of the first item `matches` accepts.
pub fn position<T>(list: List<T>, matches: fn(T) -> Bool) -> Option<Int> {
    var i = 0
    for x in list {
        if matches(x) {
            return Option.some(i)
        }
        i = i + 1
    }
    Option.none
}

/// The first `some` that `f` gives.
pub fn find_map<T, U>(list: List<T>, f: fn(T) -> Option<U>) -> Option<U> {
    for x in list {
        match f(x) {
            .some(y) => { return Option.some(y) },
            .none => (),
        }
    }
    Option.none
}

pub fn any<T>(list: List<T>, test: fn(T) -> Bool) -> Bool {
    for x in list {
        if test(x) {
            return true
        }
    }
    false
}

pub fn all<T>(list: List<T>, test: fn(T) -> Bool) -> Bool {
    for x in list {
        if !test(x) {
            return false
        }
    }
    true
}

/// How many items satisfy `test`.
pub fn count<T>(list: List<T>, test: fn(T) -> Bool) -> Int {
    var n = 0
    for x in list {
        if test(x) {
            n = n + 1
        }
    }
    n
}

/// Each item with its position, from 0.
pub fn enumerate<T>(list: List<T>) -> List<(Int, T)> {
    let b = list_builder()
    var i = 0
    for x in list {
        list_builder_append(b, (i, x))
        i = i + 1
    }
    list_finish(b)
}

/// The first `n` items (all of them if there are fewer).
pub fn take<T>(list: List<T>, n: Int) -> List<T> { list_slice(list, 0, if n < 0 { 0 } else { n }) }

/// All but the first `n` items.
pub fn skip<T>(list: List<T>, n: Int) -> List<T> { list_slice(list, if n < 0 { 0 } else { n }, list_len(list)) }

/// The leading items `keep` accepts.
pub fn take_while<T>(list: List<T>, keep: fn(T) -> Bool) -> List<T> {
    var n = 0
    for x in list {
        if !keep(x) {
            break
        }
        n = n + 1
    }
    list_slice(list, 0, n)
}

/// The items after the leading ones `skip` accepts.
pub fn skip_while<T>(list: List<T>, skip: fn(T) -> Bool) -> List<T> {
    var n = 0
    for x in list {
        if !skip(x) {
            break
        }
        n = n + 1
    }
    list_slice(list, n, list_len(list))
}

/// Running states: `f(state, item)` for each item, from `initial`.
pub fn scan<T, A>(list: List<T>, initial: A, f: fn(A, T) -> A) -> List<A> {
    let b = list_builder_capacity<A>(list_len(list))
    var state = initial
    for x in list {
        state = f(state, x)
        list_builder_append(b, state)
    }
    list_finish(b)
}

/// Pairs of items at the same positions (as long as the shorter list).
pub fn zip<A, B>(a: List<A>, b: List<B>) -> List<(A, B)> {
    let la = list_len(a)
    let lb = list_len(b)
    let n = if la < lb { la } else { lb }
    let out = list_builder()
    var i = 0
    while i < n {
        list_builder_append(out, (at(a, i), at(b, i)))
        i = i + 1
    }
    list_finish(out)
}

/// The item with the smallest key (the first, on ties).
pub fn min_by<T, K>(list: List<T>, key: fn(T) -> K) -> Option<T> where K: PartialOrd {
    // best key and item stay separate locals: a `(K, T)` record would be
    // allocated once per item when `T` or `K` holds a pointer.
    var best_k: Option<K> = Option.none
    var best_x: Option<T> = Option.none
    for x in list {
        let k = key(x)
        let better = match best_k {
            .some(bk) => k < bk,
            .none => true,
        }
        if better {
            best_k = Option.some(k)
            best_x = Option.some(x)
        }
    }
    best_x
}

/// The item with the largest key (the first, on ties).
pub fn max_by<T, K>(list: List<T>, key: fn(T) -> K) -> Option<T> where K: PartialOrd {
    var best_k: Option<K> = Option.none
    var best_x: Option<T> = Option.none
    for x in list {
        let k = key(x)
        let better = match best_k {
            .some(bk) => k > bk,
            .none => true,
        }
        if better {
            best_k = Option.some(k)
            best_x = Option.some(x)
        }
    }
    best_x
}

/// The items `keep` accepts and those it refuses, each in order.
pub fn partition<T>(list: List<T>, keep: fn(T) -> Bool) -> (List<T>, List<T>) {
    let yes = list_builder()
    let no = list_builder()
    for x in list {
        if keep(x) { list_builder_append(yes, x) } else { list_builder_append(no, x) }
    }
    (list_finish(yes), list_finish(no))
}

/// Sorted by `key`, stably (equal keys keep their order). O(n log n);
/// each key is computed once.
pub fn sort_by<T, K>(list: List<T>, key: fn(T) -> K) -> List<T> where K: PartialOrd {
    let keyed = list_builder()
    var i = 0
    for x in list {
        // the position breaks ties, so items themselves are never compared
        list_builder_append(keyed, (key(x), i, x))
        i = i + 1
    }
    map(list_sort(list_finish(keyed)), fn(t) => t.2)
}

/// Sorted by `compare` (negative: the first argument goes first; 0:
/// equal), stably. A bottom-up merge sort: O(n log n) comparisons.
///
/// Each pass merges into one contiguous buffer (`push` per element) and
/// freezes it into an array for the next pass, instead of rebuilding a paged
/// list every pass. Reads are direct array indexing.
pub fn sort_with<T>(list: List<T>, compare: fn(T, T) -> Int) -> List<T> {
    let n = list_len(list)
    if n < 2 {
        return list
    }
    var src = list.to_array()
    var width = 1
    while width < n {
        var dst = buffer.with_capacity<T>(n)
        var lo = 0
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n }
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n }
            var i = lo
            var j = mid
            while i < mid && j < hi {
                let (x, y) = (src[i], src[j])
                // on a tie the left run's item goes first: stable
                if compare(y, x) < 0 {
                    dst.push(y)
                    j = j + 1
                } else {
                    dst.push(x)
                    i = i + 1
                }
            }
            while i < mid {
                dst.push(src[i])
                i = i + 1
            }
            while j < hi {
                dst.push(src[j])
                j = j + 1
            }
            lo = hi
        }
        src = buffer.freeze(dst)
        width = width * 2
    }
    src.to_list()
}

/// Consecutive equal items collapsed to one.
pub fn dedup<T>(list: List<T>) -> List<T> where T: PartialEq {
    let b = list_builder()
    var prev: Option<T> = Option.none
    for x in list {
        let same = match prev {
            .some(p) => p == x,
            .none => false,
        }
        if !same {
            list_builder_append(b, x)
        }
        prev = Option.some(x)
    }
    list_finish(b)
}

extern "intrinsic" fn map_empty<K, V>() -> Map<K, V>
extern "intrinsic" fn map_contains<K, V>(m: Map<K, V>, key: K) -> Bool
extern "intrinsic" fn map_insert_mut<K, V>(m: Map<K, V>, key: K, value: V) -> Unit
extern "intrinsic" fn map_get<K, V>(m: Map<K, V>, key: K) -> Option<V>

/// The first of each set of equal items, in order.
pub fn unique<T>(list: List<T>) -> List<T> where T: Hash {
    let seen: Map<T, Unit> = map_empty()
    let b = list_builder()
    for x in list {
        if !map_contains(seen, x) {
            map_insert_mut(seen, x, ())
            list_builder_append(b, x)
        }
    }
    list_finish(b)
}

/// Consecutive groups of `size` items (the last may be shorter).
pub fn chunks_of<T>(list: List<T>, size: Int) -> List<List<T>> {
    let out = list_builder()
    let n = list_len(list)
    let step = if size < 1 { 1 } else { size }
    var i = 0
    while i < n {
        list_builder_append(out, list_slice(list, i, i + step))
        i = i + step
    }
    list_finish(out)
}

/// The items grouped by `key`, each group in order.
pub fn group_by<T, K>(list: List<T>, key: fn(T) -> K) -> Map<K, List<T>> where K: Hash {
    // Append to each group's list as items arrive: their order is kept, and
    // no per-item records are built or sorted (as an index-then-sort build
    // needs). Only the groups themselves are allocated, once each.
    let out: Map<K, List<T>> = map_empty()
    for x in list {
        let k = key(x)
        let group = match map_get(out, k) {
            .some(g) => g,
            .none => empty(),
        }
        map_insert_mut(out, k, list_append(group, x))
    }
    out
}

/// The items grouped by `key` (the name Python's `sorted(key=...)` uses).
pub fn group_by_key<T, K>(list: List<T>, key: fn(T) -> K) -> Map<K, List<T>> where K: Hash { group_by(list, key) }

/// The items sorted by `key` (the name Python's `sorted(key=...)` uses).
pub fn sort_by_key<T, K>(list: List<T>, key: fn(T) -> K) -> List<T> where K: PartialOrd { sort_by(list, key) }

/// How many items share each key.
pub fn count_by<T, K>(list: List<T>, key: fn(T) -> K) -> Map<K, Int> where K: Hash {
    let out: Map<K, Int> = map_empty()
    for x in list {
        let k = key(x)
        let n = match map_get(out, k) {
            .some(c) => c,
            .none => 0,
        }
        map_insert_mut(out, k, n + 1)
    }
    out
}

pub fn sum(list: List<Int>) -> Int {
    var total = 0
    for x in list {
        total = total + x
    }
    total
}

pub fn range(start: Int, end: Int) -> List<Int> { list_range(start, end) }

// ---------------------------------------------------------------- reshaping

/// Run `f` on each item, in order.
pub fn each<T>(list: List<T>, f: fn(T) -> Unit) -> Unit {
    for x in list {
        f(x)
    }
}

/// The smallest item (the first, on ties).
pub fn min<T>(list: List<T>) -> Option<T> where T: PartialOrd { min_by(list, fn(x) => x) }

/// The largest item (the first, on ties).
pub fn max<T>(list: List<T>) -> Option<T> where T: PartialOrd { max_by(list, fn(x) => x) }

/// The sum of `f` over the items.
pub fn sum_by<T>(list: List<T>, f: fn(T) -> Int) -> Int {
    var total = 0
    for x in list {
        total = total + f(x)
    }
    total
}

/// The product of the items (`1` when empty).
pub fn product(list: List<Int>) -> Int {
    var acc = 1
    for x in list {
        acc = acc * x
    }
    acc
}

/// `sep` between consecutive items (empty and single-item lists unchanged).
pub fn interpose<T>(list: List<T>, sep: T) -> List<T> {
    let b = list_builder()
    var first = true
    for x in list {
        if first {
            first = false
        } else {
            list_builder_append(b, sep)
        }
        list_builder_append(b, x)
    }
    list_finish(b)
}

/// One level of nesting removed, in order.
pub fn flatten<T>(list: List<List<T>>) -> List<T> {
    let b = list_builder()
    for inner in list {
        list_builder_extend(b, inner)
    }
    list_finish(b)
}

/// The first `n` items and the rest, in one pass (`n` below 0 puts
/// everything in the second list, above the length nothing).
pub fn split_at<T>(list: List<T>, n: Int) -> (List<T>, List<T>) {
    let head = list_builder()
    let tail = list_builder()
    var i = 0
    for x in list {
        if i < n { list_builder_append(head, x) } else { list_builder_append(tail, x) }
        i = i + 1
    }
    (list_finish(head), list_finish(tail))
}

/// The leading items `keep` accepts, and the rest, in one pass.
pub fn split_while<T>(list: List<T>, keep: fn(T) -> Bool) -> (List<T>, List<T>) {
    let head = list_builder()
    let tail = list_builder()
    var leading = true
    for x in list {
        if leading && keep(x) {
            list_builder_append(head, x)
        } else {
            leading = false
            list_builder_append(tail, x)
        }
    }
    (list_finish(head), list_finish(tail))
}

/// Consecutive runs with equal keys, each a list (an empty list yields no
/// runs; unlike `group_by`, runs are not merged across the list).
pub fn chunk_by<T, K>(list: List<T>, key: fn(T) -> K) -> List<List<T>> where K: PartialEq {
    let out = list_builder<List<T>>()
    var group = list_builder<T>()
    var started = false
    var prev: Option<K> = Option.none
    for x in list {
        let k = key(x)
        let same = match prev {
            .some(p) => p == k,
            .none => false,
        }
        if started && !same {
            list_builder_append(out, list_finish(group))
            group = list_builder()
        }
        list_builder_append(group, x)
        started = true
        prev = Option.some(k)
    }
    if started {
        list_builder_append(out, list_finish(group))
    }
    list_finish(out)
}

/// Consecutive items with equal keys collapsed to the first.
pub fn dedup_by<T, K>(list: List<T>, key: fn(T) -> K) -> List<T> where K: PartialEq {
    let b = list_builder()
    var prev: Option<K> = Option.none
    for x in list {
        let k = key(x)
        let same = match prev {
            .some(p) => p == k,
            .none => false,
        }
        if !same {
            list_builder_append(b, x)
        }
        prev = Option.some(k)
    }
    list_finish(b)
}

/// Overlapping consecutive windows of `size` (`size` below 1, or a list
/// shorter than `size`, yields no windows).
pub fn windows<T>(list: List<T>, size: Int) -> List<List<T>> {
    let out = list_builder<List<T>>()
    let n = list_len(list)
    if size < 1 || n < size {
        return list_finish(out)
    }
    var i = 0
    while i + size <= n {
        list_builder_append(out, list_slice(list, i, i + size))
        i = i + 1
    }
    list_finish(out)
}

/// How often each distinct item occurs.
pub fn frequencies<T>(list: List<T>) -> Map<T, Int> where T: Hash {
    var counts: Map<T, Int> = map_empty()
    for x in list {
        let n = match map_get(counts, x) {
            .some(v) => v,
            .none => 0,
        }
        map_insert_mut(counts, x, n + 1)
    }
    counts
}

/// One item per distinct key: the last item with that key (input order).
pub fn index_by<T, K>(list: List<T>, key: fn(T) -> K) -> Map<K, T> where K: Hash {
    let out: Map<K, T> = map_empty()
    for x in list {
        let k = key(x)
        map_insert_mut(out, k, x)
    }
    out
}

/// Pairs of items at the same positions combined by `f` (as long as the
/// shorter list).
pub fn zip_with<A, B, C>(a: List<A>, b: List<B>, f: fn(A, B) -> C) -> List<C> {
    let out = list_builder()
    let n = if list_len(a) < list_len(b) { list_len(a) } else { list_len(b) }
    var i = 0
    while i < n {
        list_builder_append(out, f(at(a, i), at(b, i)))
        i = i + 1
    }
    list_finish(out)
}

/// The first components and the second components, each in order.
pub fn unzip<A, B>(list: List<(A, B)>) -> (List<A>, List<B>) {
    let first = list_builder()
    let second = list_builder()
    for (a, b) in list {
        list_builder_append(first, a)
        list_builder_append(second, b)
    }
    (list_finish(first), list_finish(second))
}

/// Fold while `f` gives `some`; the result is the final state, or `none`
/// when `f` stopped the fold early (its `none` is not a value).
pub fn fold_while<T, A>(list: List<T>, initial: A, f: fn(A, T) -> Option<A>) -> Option<A> {
    var acc: Option<A> = Option.some(initial)
    for x in list {
        match acc {
            .some(a) => { acc = f(a, x) },
            .none => { break },
        }
    }
    acc
}

/// The last `n` items (all of them if there are fewer).
pub fn take_last<T>(list: List<T>, n: Int) -> List<T> {
    let len = list_len(list)
    let start = if n < 0 || n > len { 0 } else { len - n }
    list_slice(list, start, len)
}

/// All but the last `n` items.
pub fn drop_last<T>(list: List<T>, n: Int) -> List<T> {
    let len = list_len(list)
    let end = if n < 0 || n > len { 0 } else { len - n }
    list_slice(list, 0, end)
}
