// Worker restart policies, and running work under one (let it crash: a
// failure restarts the work, within a budget).

import std.list
import std.prelude
import std.task
import std.time
import std.trace

/// Restart policy of a managed worker.
pub enum Policy {
    /// Never restart: a failure escalates to the owning scope.
    never,
    /// Restart after failures, at most `max_restarts` times per `window`,
    /// waiting `backoff` between attempts; exceeding the budget escalates.
    on_failure(max_restarts: Int, window: Duration, backoff: Duration),
}

pub type Options = { max_restarts: Int, window: Duration, backoff: Duration }

pub let defaults = { max_restarts: 3, window: 1s, backoff: 10ms }

pub fn never() -> Policy { Policy.never }

pub fn on_failure(options: Options) -> Policy {
    Policy.on_failure(options.max_restarts, options.window, options.backoff)
}

/// What halting the owning node does with a managed worker.
pub enum Shutdown {
    /// Request cancellation at once (the default).
    cancel,
    /// Let the worker finish on its own for up to `timeout`, then cancel.
    drain(timeout: Duration),
}

pub fn cancel() -> Shutdown { Shutdown.cancel }

pub fn drain(timeout: Duration) -> Shutdown { Shutdown.drain(timeout) }

/// Run `factory` as a worker under `policy`, in a fresh task each time: it
/// ends when the work returns `ok` or is cancelled; a failure (an error or
/// a defect) restarts it within the policy's budget (after its backoff),
/// and past the budget, or under `never`, fails the caller. Usable in any
/// task (systems run their workers this way).
pub fn supervise<E>(name: Symbol, factory: fn() -> Result<Unit, E>, policy: Policy) -> Unit where E: prelude.Error {
    var failures: List<Instant> = []
    loop {
        let outcome = task.scope(fn(s) -> Result<task.Exit<Result<Unit, E>>, String> {
            let t = s.capture(factory)
            ok(t.join())
        })
        let reason = match outcome {
            .ok(.returned(.ok(_))) => { return () },
            .ok(.returned(.err(e))) => e.display(),
            .ok(.failed(info)) => info.display(),
            .ok(.cancelled(_)) => { return () },
            .err(m) => m,
        }
        match policy {
            .never => panic($"worker {name} failed: {reason}"),
            .on_failure(max, window, backoff) => {
                let now = time.now()
                failures = list.append(list.filter(failures, fn(t) { now - t < window }), now)
                if list.len(failures) > max {
                    panic($"worker {name} exceeded its restart budget: {reason}")
                }
                trace.event(#worker/restart, { worker: name, reason })
                task.sleep(backoff)
            },
        }
    }
}
