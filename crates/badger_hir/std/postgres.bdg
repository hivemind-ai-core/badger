// PostgreSQL with pooled connections and scoped transactions; the same
// shape as `std.sqlite`. Statements use `$1`, `$2`, ... parameters, given
// as `Data` and parsed by the server as the parameter's type. Rows are
// `Data` objects by column name, or records (`query_as`). Versioned schema
// migrations are `migrate`, `schema`, and `require_current`, as in
// `std.sqlite`.

import std.prelude

import std.system
import std.codec
import std.crypto
import std.encoding
import std.native
import std.list
import std.text

pub struct Error {
    pub code: Symbol,
    pub message: String,
    /// The callback error a failed rollback happened after, if any.
    pub cause: Option<dyn prelude.Error>,
}

impl Display for Error {
    fn display(self: &Self) -> String { $"{self.code}: {self.message}" }
}

impl HttpStatus for Error {}

impl prelude.Error for Error {
    fn code(self: &Self) -> Symbol { self.code }
    fn cause(self: &Self) -> Option<dyn prelude.Error> { self.cause }
}

/// A shareable connection pool, scoped to region `S` (the system or
/// callback that opened it). Each statement takes a connection of its own.
pub struct Pool<S: Scope> {
    handle: native.Handle,
}

/// A task-confined transaction, branded with its callback's region; it
/// holds one connection until it ends.
pub struct Tx<S> {
    handle: native.Handle,
}

/// Things SQL can run against: pools and transactions.
pub protocol Connection {
    fn connection(self: &Self) -> native.Handle
}

impl<S> Connection for Pool<S> {
    fn connection(self: &Self) -> native.Handle { self.handle }
}

impl<S> Connection for Tx<S> {
    fn connection(self: &Self) -> native.Handle { self.handle }
}

/// Pool options.
pub type Options = { max_connections: Int }

/// The default options (16 connections).
pub let defaults: Options = { max_connections: 16 }

/// A statement's parameter types and result columns, as the server
/// describes them. `nullable` is known for a column read straight from a
/// table (`some(false)` for a `NOT NULL` one), unknown for an expression.
pub type Description = {
    params: List<String>,
    columns: List<{ name: String, sql_type: String, nullable: Option<Bool> }>,
}

// the `badger_postgres` native module (crates/badger_postgres)
extern "native badger_postgres.connect" fn pg_connect(url: String, max_connections: Int) -> Result<native.Handle, native.Error> !{Io, Wait}
extern "native badger_postgres.close" fn pg_close(pool: native.Handle) -> Unit
extern "native badger_postgres.is_closed" fn pg_is_closed(pool: native.Handle) -> Bool
extern "native badger_postgres.execute" fn pg_execute(conn: native.Handle, sql: String, params: List<Data>) -> Result<Int, native.Error> !{Io, Wait}
extern "native badger_postgres.query" fn pg_query(conn: native.Handle, sql: String, params: List<Data>) -> Result<List<Data>, native.Error> !{Io, Wait}
extern "native badger_postgres.query_one" fn pg_query_one(conn: native.Handle, sql: String, params: List<Data>) -> Result<Data, native.Error> !{Io, Wait}
extern "native badger_postgres.begin" fn pg_begin(pool: native.Handle) -> Result<native.Handle, native.Error> !{Io, Wait}
extern "native badger_postgres.finish" fn pg_finish(tx: native.Handle, commit: Bool) -> Result<Unit, native.Error> !{Io, Wait}
extern "native badger_postgres.describe" fn pg_describe(pool: native.Handle, sql: String) -> Result<Description, native.Error> !{Io, Wait}
extern "intrinsic" fn cleanup_push(f: fn() -> Unit) -> Int
extern "intrinsic" fn cleanup_remove(handle: Int) -> Unit

fn lift<T>(r: Result<T, native.Error>) -> Result<T, Error> {
    match r {
        .ok(v) => ok(v),
        .err(e) => err({ code: e.kind, message: e.message, cause: Option.none }),
    }
}

/// A pool for `url` (`postgres://user:password@host:port/db`, or
/// key=value settings; `sslmode=disable` for a server without TLS). One
/// connection opens now, so a bad address or credentials fail here.
pub fn connect<S: Scope>(url: String) -> Result<Pool<S>, Error> !{Io, Wait} { connect_with(url, defaults) }

pub fn connect_with<S: Scope>(url: String, options: Options) -> Result<Pool<S>, Error> !{Io, Wait} {
    let h = lift(pg_connect(url, options.max_connections))?
    let p: Pool<S> = { handle: h }
    ok(p)
}

pub fn close<S: Scope>(pool: Pool<S>) -> Unit { pg_close(pool.handle) }
pub fn is_closed<S: Scope>(pool: Pool<S>) -> Bool { pg_is_closed(pool.handle) }

/// Execute a statement with bound parameters; returns the changed row
/// count. Without parameters, several `;`-separated statements may run
/// together (a schema script); the count is the last one's.
pub fn execute<C>(conn: C, sql: String, params: List<Data>) -> Result<Int, Error> !{Io, Wait} where C: Connection {
    lift(pg_execute(conn.connection(), sql, params))
}

pub fn query<C>(conn: C, sql: String, params: List<Data>) -> Result<List<Data>, Error> !{Io, Wait} where C: Connection {
    lift(pg_query(conn.connection(), sql, params))
}

/// Exactly one row as `Data`; zero or several rows are an error.
pub fn query_one<C>(conn: C, sql: String, params: List<Data>) -> Result<Data, Error> !{Io, Wait} where C: Connection {
    lift(pg_query_one(conn.connection(), sql, params))
}

fn decode_row<T>(row: Data) -> Result<T, Error> where T: Codec {
    match codec.from_data<T>(row) {
        .ok(v) => ok(v),
        .err(e) => err({ code: #postgres/decode, message: $"a row does not decode: {e}", cause: Option.none }),
    }
}

/// Rows as `T`, a record whose fields are named like the result's columns
/// (an `Option` field for a column that can be NULL).
pub fn query_as<T, C>(conn: C, sql: String, params: List<Data>) -> Result<List<T>, Error> !{Io, Wait} where T: Codec, C: Connection {
    list.try_map(lift(pg_query(conn.connection(), sql, params))?, decode_row)
}

/// Exactly one row, as `T` (see `query_as`).
pub fn query_one_as<T, C>(conn: C, sql: String, params: List<Data>) -> Result<T, Error> !{Io, Wait} where T: Codec, C: Connection {
    decode_row(lift(pg_query_one(conn.connection(), sql, params))?)
}

/// What the server says `sql` takes and returns (without running it).
pub fn describe<S: Scope>(pool: Pool<S>, sql: String) -> Result<Description, Error> !{Io, Wait} {
    lift(pg_describe(pool.handle, sql))
}

/// Run `body` in a transaction: commit after `ok`, roll back after `err`,
/// defect, or cancellation. A failed begin or commit is returned even when
/// the body succeeded; so is a commit after a statement in the body failed
/// (the server aborted the transaction: `#postgres/tx_aborted`). A failed
/// rollback after a body error is returned as a
/// `#postgres/rollback_failed` error whose `cause` is the body's error.
pub fn transaction<P: Scope, R, E>(pool: Pool<P>, body: for<S: Scope> fn(Tx<S>) -> Result<R, E>) -> Result<R, E> !{Io, Wait} where E: From<Error>, E: prelude.Error {
    match lift(pg_begin(pool.handle)) {
        .err(e) => err(E.from(e)),
        .ok(h) => {
            // a defect or cancellation in the body rolls back
            let guard = cleanup_push(fn() { let _ = pg_finish(h, false) })
            let r = body({ handle: h })
            cleanup_remove(guard)
            match r {
                .ok(v) => match lift(pg_finish(h, true)) {
                    .ok(_) => ok(v),
                    .err(e) => err(E.from(e)),
                },
                .err(e) => match lift(pg_finish(h, false)) {
                    .ok(_) => err(e),
                    .err(re) => {
                        let cause: dyn prelude.Error = e
                        let failure: Error = { code: #postgres/rollback_failed, message: $"rollback failed: {re.message}", cause: Option.some(cause) }
                        err(E.from(failure))
                    },
                },
            }
        },
    }
}

fn pool_init<S: Scope>(scope: system.InitScope, config: { url: String }) -> Result<Pool<S>, Error> {
    let p = connect(config.url)?
    scope.on_halt(fn() -> Result<Unit, Error> {
        close(p)
        ok(())
    })
    ok(p)
}

/// Provider of a pool for `{url: String}`, closed when the system halts.
pub let pool = system.provider({ name: #postgres/pool, init: pool_init })

/// A schema migration: a positive version (applied in increasing order),
/// a name, and the SQL that moves the schema to this version.
pub type Migration = { version: Int, name: String, sql: String }

/// A database's schema relative to a program's migrations: the latest
/// version applied, the latest the program knows, and the versions still
/// to apply.
pub type Schema = { current: Int, latest: Int, pending: List<Int> }

fn checksum(m: Migration) -> String {
    encoding.hex(crypto.sha256(m.sql.to_bytes()))
}

fn migration_error(code: Symbol, message: String) -> Error {
    { code, message, cause: Option.none }
}

fn checked(migrations: List<Migration>) -> Result<Unit, Error> {
    var last = 0
    for m in migrations {
        if m.version <= last {
            return err(migration_error(#postgres/migrations_invalid, $"migration {m.version} ({m.name}) is out of order: versions increase from 1"))
        }
        last = m.version
    }
    ok(())
}

type Applied = { version: Int, name: String, checksum: String }

fn ensure_table<S: Scope>(pool: Pool<S>) -> Result<Unit, Error> !{Io, Wait} {
    let _ = execute(pool, "CREATE TABLE IF NOT EXISTS badger_migrations (version BIGINT PRIMARY KEY, name TEXT NOT NULL, checksum TEXT NOT NULL, applied_at TIMESTAMPTZ NOT NULL DEFAULT now())", [])?
    ok(())
}

/// Compare the database with `migrations`: an applied migration whose SQL
/// changed since, or an applied version the program does not know (the
/// database is newer than the program), is an error.
pub fn schema<S: Scope>(pool: Pool<S>, migrations: List<Migration>) -> Result<Schema, Error> !{Io, Wait} {
    checked(migrations)?
    ensure_table(pool)?
    let applied = query_as<Applied, Pool<S>>(pool, "SELECT version, name, checksum FROM badger_migrations ORDER BY version", [])?
    for a in applied {
        match list.find(migrations, fn(m) { m.version == a.version }) {
            .none => return err(migration_error(#postgres/schema_ahead, $"the database has migration {a.version} ({a.name}), which this program does not know")),
            .some(m) => if checksum(m) != a.checksum {
                return err(migration_error(#postgres/migration_changed, $"migration {a.version} ({a.name}) changed after it was applied"))
            },
        }
    }
    let current = list.fold(applied, 0, fn(v, a) { if a.version > v { a.version } else { v } })
    let latest = list.fold(migrations, 0, fn(v, m) { if m.version > v { m.version } else { v } })
    let pending = list.map(list.filter(migrations, fn(m) { !list.any(applied, fn(a) { a.version == m.version }) }), fn(m) { m.version })
    ok({ current, latest, pending })
}

/// Apply the pending migrations in order, each in its own transaction with
/// its record (a failing one rolls back and stops, leaving the earlier
/// ones applied; Postgres DDL is transactional). Concurrent migrators
/// take turns on an advisory lock. Returns the versions applied.
pub fn migrate<S: Scope>(pool: Pool<S>, migrations: List<Migration>) -> Result<List<Int>, Error> !{Io, Wait} {
    let s = schema(pool, migrations)?
    var done: List<Int> = []
    for m in migrations {
        if s.pending.contains(m.version) {
            let applied = transaction(pool, fn(tx) -> Result<Bool, Error> {
                // one migrator at a time; another may have applied it meanwhile
                let _ = query(tx, "SELECT pg_advisory_xact_lock(7262016)::text AS locked", [])?
                if !query(tx, "SELECT version FROM badger_migrations WHERE version = $1", [Data.int(m.version)])?.is_empty() {
                    return ok(false)
                }
                let _ = execute(tx, m.sql, [])?
                let _ = execute(tx, "INSERT INTO badger_migrations (version, name, checksum) VALUES ($1, $2, $3)", [Data.int(m.version), Data.string(m.name), Data.string(checksum(m))])?
                ok(true)
            })?
            if applied {
                done = done.append(m.version)
            }
        }
    }
    ok(done)
}

/// Refuse to serve with a schema other than the program's: pending
/// migrations, a newer database, or a changed migration are errors (run
/// the migration command first).
pub fn require_current<S: Scope>(pool: Pool<S>, migrations: List<Migration>) -> Result<Unit, Error> !{Io, Wait} {
    let s = schema(pool, migrations)?
    if !s.pending.is_empty() {
        return err(migration_error(#postgres/schema_behind, $"the database is at version {s.current}; migrations {text.join(s.pending.map(fn(v) { $"{v}" }), ", ")} are pending"))
    }
    ok(())
}
