// Persistent sets.

extern "intrinsic" fn set_insert<T>(s: Set<T>, value: T) -> Set<T>
extern "intrinsic" fn set_remove<T>(s: Set<T>, value: T) -> Set<T>
extern "intrinsic" fn set_items<T>(s: Set<T>) -> List<T>
extern "intrinsic" fn set_insert_mut<T>(s: Set<T>, value: T) -> Unit

/// Affine builder for bulk construction; `finish` freezes the set in place.
pub struct SetBuilder<T> {
    set: Set<T>,
}

impl<T> SetBuilder<T> {
    pub fn insert(self: &mut Self, value: T) -> Unit { set_insert_mut(self.set, value) }
    pub fn len(self: &Self) -> Int { len(self.set) }
    pub fn finish(self: Self) -> Set<T> { self.set }
}

pub fn builder<T>() -> SetBuilder<T> where T: Hash { { set: empty() } }

/// A set built by `fill`, which inserts into a builder that is finished
/// when it returns.
pub fn build<T>(fill: once fn(&mut SetBuilder<T>) -> Unit) -> Set<T> where T: Hash {
    var b: SetBuilder<T> = { set: empty() }
    fill(&mut b)
    b.finish()
}

pub fn from_list<T>(items: List<T>) -> Set<T> where T: Hash {
    let s = empty()
    for x in items {
        set_insert_mut(s, x)
    }
    s
}

pub fn collect<T>(items: Seq<T>) -> Set<T> where T: Hash {
    let s = empty()
    for x in items {
        set_insert_mut(s, x)
    }
    s
}
extern "intrinsic" fn map_contains<K, V>(m: Map<K, V>, key: K) -> Bool
extern "intrinsic" fn map_len<K, V>(m: Map<K, V>) -> Int
extern "intrinsic" fn map_empty<K, V>() -> Map<K, V>
extern "intrinsic" fn identity<A, B>(value: A) -> B

pub fn empty<T>() -> Set<T> where T: Hash { identity(map_empty<T, Unit>()) }
pub fn insert<T>(s: Set<T>, value: T) -> Set<T> { set_insert(s, value) }
pub fn remove<T>(s: Set<T>, value: T) -> Set<T> { set_remove(s, value) }
pub fn contains<T>(s: Set<T>, value: T) -> Bool { map_contains(identity<Set<T>, Map<T, Unit>>(s), value) }
pub fn len<T>(s: Set<T>) -> Int { map_len(identity<Set<T>, Map<T, Unit>>(s)) }
/// Members in unspecified order.
pub fn to_list<T>(s: Set<T>) -> List<T> { set_items(s) }

/// The items in either set.
pub fn union<T>(a: Set<T>, b: Set<T>) -> Set<T> where T: Hash {
    let s = empty()
    for x in set_items(a) {
        set_insert_mut(s, x)
    }
    for x in set_items(b) {
        set_insert_mut(s, x)
    }
    s
}

/// The items in both sets.
pub fn intersection<T>(a: Set<T>, b: Set<T>) -> Set<T> where T: Hash {
    let s = empty()
    for x in set_items(a) {
        if contains(b, x) {
            set_insert_mut(s, x)
        }
    }
    s
}

/// The items of `a` not in `b`.
pub fn difference<T>(a: Set<T>, b: Set<T>) -> Set<T> where T: Hash {
    let s = empty()
    for x in set_items(a) {
        if !contains(b, x) {
            set_insert_mut(s, x)
        }
    }
    s
}

/// Whether every item of `a` is in `b`.
pub fn is_subset<T>(a: Set<T>, b: Set<T>) -> Bool {
    for x in set_items(a) {
        if !contains(b, x) {
            return false
        }
    }
    true
}

/// The items `keep` accepts.
pub fn filter<T>(s: Set<T>, keep: fn(T) -> Bool) -> Set<T> where T: Hash {
    let out = empty()
    for x in set_items(s) {
        if keep(x) {
            set_insert_mut(out, x)
        }
    }
    out
}

pub fn is_empty<T>(s: Set<T>) -> Bool { len(s) == 0 }

/// Whether every item of `b` is in `a`.
pub fn is_superset<T>(a: Set<T>, b: Set<T>) -> Bool { is_subset(b, a) }

/// Whether the sets share no item.
pub fn is_disjoint<T>(a: Set<T>, b: Set<T>) -> Bool {
    for x in set_items(a) {
        if contains(b, x) {
            return false
        }
    }
    true
}

/// The items in exactly one of the sets.
pub fn symmetric_difference<T>(a: Set<T>, b: Set<T>) -> Set<T> where T: Hash {
    let s = empty()
    for x in set_items(a) {
        if !contains(b, x) {
            set_insert_mut(s, x)
        }
    }
    for x in set_items(b) {
        if !contains(a, x) {
            set_insert_mut(s, x)
        }
    }
    s
}

/// The set of `f` over the items.
pub fn map<T, U>(s: Set<T>, f: fn(T) -> U) -> Set<U> where U: Hash {
    let out = empty()
    for x in set_items(s) {
        set_insert_mut(out, f(x))
    }
    out
}

pub fn each<T>(s: Set<T>, f: fn(T) -> Unit) -> Unit {
    for x in set_items(s) {
        f(x)
    }
}

pub fn fold<T, A>(s: Set<T>, initial: A, f: fn(A, T) -> A) -> A {
    var acc = initial
    for x in set_items(s) {
        acc = f(acc, x)
    }
    acc
}

pub fn any<T>(s: Set<T>, test: fn(T) -> Bool) -> Bool {
    for x in set_items(s) {
        if test(x) {
            return true
        }
    }
    false
}

pub fn all<T>(s: Set<T>, test: fn(T) -> Bool) -> Bool {
    for x in set_items(s) {
        if !test(x) {
            return false
        }
    }
    true
}

impl<T> Set<T> {
    pub fn is_superset(self: &Self, other: Set<T>) -> Bool { is_superset(self, other) }
    pub fn is_disjoint(self: &Self, other: Set<T>) -> Bool { is_disjoint(self, other) }
    pub fn symmetric_difference(self: &Self, other: Set<T>) -> Set<T> where T: Hash { symmetric_difference(self, other) }
    pub fn map<U>(self: &Self, f: fn(T) -> U) -> Set<U> where U: Hash { map(self, f) }
    pub fn each(self: &Self, f: fn(T) -> Unit) -> Unit { each(self, f) }
    pub fn fold<A>(self: &Self, initial: A, f: fn(A, T) -> A) -> A { fold(self, initial, f) }
    pub fn any(self: &Self, test: fn(T) -> Bool) -> Bool { any(self, test) }
    pub fn all(self: &Self, test: fn(T) -> Bool) -> Bool { all(self, test) }
    pub fn insert(self: &Self, value: T) -> Set<T> { insert(self, value) }
    pub fn remove(self: &Self, value: T) -> Set<T> { remove(self, value) }
    pub fn to_list(self: &Self) -> List<T> { set_items(self) }
    pub fn union(self: &Self, other: Set<T>) -> Set<T> where T: Hash { union(self, other) }
    pub fn intersection(self: &Self, other: Set<T>) -> Set<T> where T: Hash { intersection(self, other) }
    pub fn difference(self: &Self, other: Set<T>) -> Set<T> where T: Hash { difference(self, other) }
    pub fn is_subset(self: &Self, other: Set<T>) -> Bool { is_subset(self, other) }
    pub fn filter(self: &Self, keep: fn(T) -> Bool) -> Set<T> where T: Hash { filter(self, keep) }
    pub fn is_empty(self: &Self) -> Bool { len(self) == 0 }
    pub fn contains(self: &Self, value: T) -> Bool { contains(self, value) }
    pub fn len(self: &Self) -> Int { len(self) }
}
