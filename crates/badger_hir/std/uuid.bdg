// UUIDs as their hyphenated lower-case text: random (version 4) and
// time-ordered (version 7, sortable by creation). Reproduction bundles
// record the new ones, so a replay repeats them.

extern "native badger_crypto.uuid_v4" fn u_v4() -> String !{Io}
extern "native badger_crypto.uuid_v7" fn u_v7() -> String !{Io}
extern "native badger_crypto.uuid_parse" fn u_parse(text: String) -> Result<String, Error>

/// Text that is not a UUID.
pub struct Error {
    pub message: String,
}

impl Display for Error {
    fn display(self: &Self) -> String { self.message }
}

/// A new random UUID (version 4).
pub fn v4() -> String !{Io} { u_v4() }

/// A new time-ordered UUID (version 7): later ones sort after earlier ones.
pub fn v7() -> String !{Io} { u_v7() }

/// `text` as a UUID, normalized (accepts braces, URNs, and no hyphens).
pub fn parse(text: String) -> Result<String, Error> { u_parse(text) }
