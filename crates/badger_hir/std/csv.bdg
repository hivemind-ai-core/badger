// CSV: rows of text fields, or records keyed by the header row, and back.
// Quoted fields, embedded delimiters, quotes, and newlines follow RFC 4180;
// the delimiter is one ASCII character (`","` for `rows` and `records`).
// The `badger_formats` native module does the parsing.

import std.codec
import std.list

/// Input that does not parse (an unclosed quote, a ragged record with a
/// header).
pub struct Error {
    pub message: String,
}

impl Display for Error {
    fn display(self: &Self) -> String { self.message }
}

extern "native badger_formats.csv_rows" fn csv_rows(text: String, delimiter: String) -> Result<List<List<String>>, Error>
extern "native badger_formats.csv_records" fn csv_records(text: String, delimiter: String) -> Result<List<Map<String, String>>, Error>
extern "native badger_formats.csv_encode" fn csv_encode(rows: List<List<String>>, delimiter: String) -> Result<String, Error>

/// Every row, the header row included.
pub fn rows(text: String) -> Result<List<List<String>>, Error> { csv_rows(text, ",") }

/// Rows with another delimiter (`";"`, `"\t"`).
pub fn rows_with(text: String, delimiter: String) -> Result<List<List<String>>, Error> { csv_rows(text, delimiter) }

/// The rows after the header, each keyed by the header's names.
pub fn records(text: String) -> Result<List<Map<String, String>>, Error> { csv_records(text, ",") }

/// The rows after the header as `T`, a record whose fields are named like
/// the columns (text fields; decode numbers from them, or use `Data`
/// fields through `codec`).
pub fn decode<T>(text: String) -> Result<List<T>, Error> where T: Codec {
    let out = list.builder<T>()
    for r in csv_records(text, ",")? {
        match codec.from_data<T>(codec.to_data(r)) {
            .ok(v) => out.append(v),
            .err(e) => return err({ message: $"row {out.len() + 1}: {e}" }),
        }
    }
    ok(out.finish())
}

/// Text of `rows` (fields quoted where needed).
pub fn encode(rows: List<List<String>>) -> Result<String, Error> { csv_encode(rows, ",") }
