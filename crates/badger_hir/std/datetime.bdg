// Calendar dates, wall-clock times, and time zones (the `badger_datetime`
// native module, over jiff and the system's time zone database).
//
// `Date`, `Time`, and `DateTime` are civil values: no zone, no instant.
// `Zoned` is an instant seen in a zone (`Europe/Berlin`, `UTC`, or a
// fixed offset). Arithmetic follows the calendar: adding a month to
// January 31st gives the last day of February, and adding a day in a zone
// keeps the wall-clock time across a DST change.

import std.prelude

import std.native
import std.text as texts
import std.time as clock

pub struct Error {
    pub code: Symbol,
    pub message: String,
}

impl Display for Error {
    fn display(self: &Self) -> String { $"{self.code}: {self.message}" }
}

impl HttpStatus for Error {}

impl prelude.Error for Error {
    fn code(self: &Self) -> Symbol { self.code }
}

/// A calendar date (proleptic Gregorian).
pub struct Date {
    pub year: Int,
    pub month: Int,
    pub day: Int,
}

/// A time of day.
pub struct Time {
    pub hour: Int,
    pub minute: Int,
    pub second: Int,
    pub nanosecond: Int,
}

/// A date and a time of day, without a zone.
pub struct DateTime {
    pub date: Date,
    pub time: Time,
}

/// An instant in a zone.
pub struct Zoned {
    pub datetime: DateTime,
    /// The zone's offset from UTC at this instant.
    pub offset_seconds: Int,
    /// An IANA name (`Europe/Berlin`), `UTC`, or a fixed offset (`+02:00`).
    pub zone: String,
    timestamp_nanos: Int,
}

/// Calendar and clock units, each signed. Build one with `days(3)`,
/// `months(1)`, ... and combine with `plus`.
pub type Span = { years: Int, months: Int, weeks: Int, days: Int, hours: Int, minutes: Int, seconds: Int, nanoseconds: Int }

/// A date's place in the calendar.
pub type DateInfo = { weekday: Int, day_of_year: Int, days_in_month: Int, leap_year: Bool }

// the `badger_datetime` native module (crates/badger_datetime)
extern "native badger_datetime.date" fn dt_date(year: Int, month: Int, day: Int) -> Result<Date, native.Error>
extern "native badger_datetime.time" fn dt_time(hour: Int, minute: Int, second: Int, nanosecond: Int) -> Result<Time, native.Error>
extern "native badger_datetime.date_add" fn dt_date_add(date: Date, span: Span) -> Result<Date, native.Error>
extern "native badger_datetime.date_info" fn dt_date_info(date: Date) -> Result<DateInfo, native.Error>
extern "native badger_datetime.days_between" fn dt_days_between(a: Date, b: Date) -> Result<Int, native.Error>
extern "native badger_datetime.datetime_add" fn dt_datetime_add(dt: DateTime, span: Span) -> Result<DateTime, native.Error>
extern "native badger_datetime.zoned_add" fn dt_zoned_add(z: Zoned, span: Span) -> Result<Zoned, native.Error>
extern "native badger_datetime.in_zone" fn dt_in_zone(nanos: Int, zone: String) -> Result<Zoned, native.Error>
extern "native badger_datetime.at_zone" fn dt_at_zone(dt: DateTime, zone: String) -> Result<Zoned, native.Error>
extern "native badger_datetime.parse_date" fn dt_parse_date(text: String) -> Result<Date, native.Error>
extern "native badger_datetime.parse_time" fn dt_parse_time(text: String) -> Result<Time, native.Error>
extern "native badger_datetime.parse_datetime" fn dt_parse_datetime(text: String) -> Result<DateTime, native.Error>
extern "native badger_datetime.parse_zoned" fn dt_parse_zoned(text: String) -> Result<Zoned, native.Error>
extern "native badger_datetime.parse_timestamp" fn dt_parse_timestamp(text: String) -> Result<Int, native.Error>
extern "native badger_datetime.format_date" fn dt_format_date(format: String, date: Date) -> Result<String, native.Error>
extern "native badger_datetime.format_datetime" fn dt_format_datetime(format: String, dt: DateTime) -> Result<String, native.Error>
extern "native badger_datetime.format_zoned" fn dt_format_zoned(format: String, z: Zoned) -> Result<String, native.Error>
extern "native badger_datetime.parse_datetime_with" fn dt_parse_datetime_with(format: String, text: String) -> Result<DateTime, native.Error>
extern "native badger_datetime.parse_zoned_with" fn dt_parse_zoned_with(format: String, text: String) -> Result<Zoned, native.Error>
extern "native badger_datetime.zoned_text" fn dt_zoned_text(z: Zoned) -> Result<String, native.Error>
extern "native badger_datetime.timestamp_text" fn dt_timestamp_text(nanos: Int) -> Result<String, native.Error>
extern "native badger_datetime.check_zone" fn dt_check_zone(zone: String) -> Result<String, native.Error>
extern "native badger_datetime.system_zone" fn dt_system_zone() -> String !{Io}
extern "intrinsic" fn identity<A, B>(value: A) -> B

fn lift<T>(r: Result<T, native.Error>) -> Result<T, Error> {
    match r {
        .ok(v) => ok(v),
        .err(e) => err({ code: e.kind, message: e.message }),
    }
}

/// A result the module computed from valid inputs (a failure is a bug).
fn sure<T>(r: Result<T, native.Error>) -> T {
    match r {
        .ok(v) => v,
        .err(e) => panic($"datetime: {e.message}"),
    }
}

// ---------------------------------------------------------------- spans

pub let zero: Span = { years: 0, months: 0, weeks: 0, days: 0, hours: 0, minutes: 0, seconds: 0, nanoseconds: 0 }

pub fn years(n: Int) -> Span { { ..zero, years: n } }
pub fn months(n: Int) -> Span { { ..zero, months: n } }
pub fn weeks(n: Int) -> Span { { ..zero, weeks: n } }
pub fn days(n: Int) -> Span { { ..zero, days: n } }
pub fn hours(n: Int) -> Span { { ..zero, hours: n } }
pub fn minutes(n: Int) -> Span { { ..zero, minutes: n } }
pub fn seconds(n: Int) -> Span { { ..zero, seconds: n } }

/// The two spans' units added together.
pub fn plus(a: Span, b: Span) -> Span {
    {
        years: a.years + b.years,
        months: a.months + b.months,
        weeks: a.weeks + b.weeks,
        days: a.days + b.days,
        hours: a.hours + b.hours,
        minutes: a.minutes + b.minutes,
        seconds: a.seconds + b.seconds,
        nanoseconds: a.nanoseconds + b.nanoseconds,
    }
}

/// The span with every unit negated.
pub fn negate(s: Span) -> Span {
    {
        years: 0 - s.years,
        months: 0 - s.months,
        weeks: 0 - s.weeks,
        days: 0 - s.days,
        hours: 0 - s.hours,
        minutes: 0 - s.minutes,
        seconds: 0 - s.seconds,
        nanoseconds: 0 - s.nanoseconds,
    }
}

// ---------------------------------------------------------------- dates

/// The date, if it exists (`2026-02-30` does not).
pub fn date(year: Int, month: Int, day: Int) -> Result<Date, Error> { lift(dt_date(year, month, day)) }

/// A date written `2026-10-16`.
pub fn parse_date(text: String) -> Result<Date, Error> { lift(dt_parse_date(text)) }

fn pad(n: Int, width: Int) -> String {
    var s = $"{if n < 0 { 0 - n } else { n }}"
    while s.len() < width {
        s = $"0{s}"
    }
    if n < 0 { $"-{s}" } else { s }
}

fn order(a: List<Int>, b: List<Int>) -> Int {
    var i = 0
    while i < a.len() {
        let (x, y) = (a.get(i).unwrap_or(0), b.get(i).unwrap_or(0))
        if x != y {
            return if x < y { -1 } else { 1 }
        }
        i = i + 1
    }
    0
}

impl Display for Date {
    fn display(self: &Self) -> String { $"{pad(self.year, 4)}-{pad(self.month, 2)}-{pad(self.day, 2)}" }
}

impl Date {
    /// The date `span` later (calendar units; a month from January 31st is
    /// the end of February).
    pub fn add(self: &Self, span: Span) -> Result<Date, Error> { lift(dt_date_add(self, span)) }
    pub fn add_days(self: &Self, n: Int) -> Result<Date, Error> { self.add(days(n)) }
    pub fn add_months(self: &Self, n: Int) -> Result<Date, Error> { self.add(months(n)) }
    /// Days from this date to `other` (negative if `other` is earlier).
    pub fn days_until(self: &Self, other: Date) -> Int { sure(dt_days_between(self, other)) }
    /// 1 (Monday) to 7 (Sunday).
    pub fn weekday(self: &Self) -> Int { sure(dt_date_info(self)).weekday }
    pub fn day_of_year(self: &Self) -> Int { sure(dt_date_info(self)).day_of_year }
    pub fn days_in_month(self: &Self) -> Int { sure(dt_date_info(self)).days_in_month }
    pub fn in_leap_year(self: &Self) -> Bool { sure(dt_date_info(self)).leap_year }
    /// -1, 0, or 1 as this date is before, the same as, or after `other`.
    pub fn compare(self: &Self, other: Date) -> Int { order([self.year, self.month, self.day], [other.year, other.month, other.day]) }
    /// The start of this day.
    pub fn at(self: &Self, time: Time) -> DateTime { { date: self, time } }
    /// `strftime` formatting (`%A, %B %-d`).
    pub fn format(self: &Self, format: String) -> Result<String, Error> { lift(dt_format_date(format, self)) }
}

// ---------------------------------------------------------------- times

pub fn time(hour: Int, minute: Int, second: Int) -> Result<Time, Error> { lift(dt_time(hour, minute, second, 0)) }

pub let midnight: Time = { hour: 0, minute: 0, second: 0, nanosecond: 0 }

/// A time written `12:30`, `12:30:05`, or `12:30:05.25`.
pub fn parse_time(text: String) -> Result<Time, Error> { lift(dt_parse_time(text)) }

impl Display for Time {
    fn display(self: &Self) -> String {
        let base = $"{pad(self.hour, 2)}:{pad(self.minute, 2)}:{pad(self.second, 2)}"
        if self.nanosecond == 0 {
            return base
        }
        var frac = pad(self.nanosecond, 9)
        while texts.ends_with(frac, "0") {
            frac = texts.slice(frac, 0, texts.len(frac) - 1).unwrap_or(frac)
        }
        $"{base}.{frac}"
    }
}

impl Time {
    pub fn compare(self: &Self, other: Time) -> Int {
        order([self.hour, self.minute, self.second, self.nanosecond], [other.hour, other.minute, other.second, other.nanosecond])
    }
}

// ---------------------------------------------------------------- date-times

/// A date-time written `2026-10-16T12:30:00` (or with a space).
pub fn parse_datetime(text: String) -> Result<DateTime, Error> { lift(dt_parse_datetime(text)) }

/// `strptime`: a date-time read by a format (`%d/%m/%Y %H:%M`).
pub fn parse_datetime_with(format: String, text: String) -> Result<DateTime, Error> { lift(dt_parse_datetime_with(format, text)) }

impl Display for DateTime {
    fn display(self: &Self) -> String { $"{self.date}T{self.time}" }
}

impl DateTime {
    pub fn add(self: &Self, span: Span) -> Result<DateTime, Error> { lift(dt_datetime_add(self, span)) }
    pub fn compare(self: &Self, other: DateTime) -> Int {
        let d = self.date.compare(other.date)
        if d != 0 { d } else { self.time.compare(other.time) }
    }
    /// This wall-clock time in `zone`: a time skipped by a DST change moves
    /// forward, and a repeated one takes the earlier instant.
    pub fn in_zone(self: &Self, zone: String) -> Result<Zoned, Error> { lift(dt_at_zone(self, zone)) }
    pub fn format(self: &Self, format: String) -> Result<String, Error> { lift(dt_format_datetime(format, self)) }
}

// ---------------------------------------------------------------- zoned

/// The instant `ts` in `zone`.
pub fn in_zone(ts: Timestamp, zone: String) -> Result<Zoned, Error> { lift(dt_in_zone(identity(ts), zone)) }

/// The current time in `zone`.
pub fn now_in(zone: String) -> Result<Zoned, Error> !{Io} { in_zone(clock.timestamp(), zone) }

/// The current time in the system's zone.
pub fn now() -> Zoned !{Io} {
    match in_zone(clock.timestamp(), system_zone()) {
        .ok(z) => z,
        .err(_) => sure(dt_in_zone(identity(clock.timestamp()), "UTC")),
    }
}

/// The system's time zone (`TZ`, else `/etc/localtime`), or `UTC`.
pub fn system_zone() -> String !{Io} { dt_system_zone() }

/// The zone's canonical name, if it exists.
pub fn zone(name: String) -> Result<String, Error> { lift(dt_check_zone(name)) }

/// A zoned time written `2026-10-16T12:30:00+02:00[Europe/Berlin]`, or
/// with an offset only (RFC 3339).
pub fn parse_zoned(text: String) -> Result<Zoned, Error> { lift(dt_parse_zoned(text)) }

/// `strptime` with an offset (`%z`) or zone name (`%Q`) in the format.
pub fn parse_zoned_with(format: String, text: String) -> Result<Zoned, Error> { lift(dt_parse_zoned_with(format, text)) }

/// An instant written with an offset (RFC 3339: `2026-10-16T10:30:00Z`).
pub fn parse_timestamp(text: String) -> Result<Timestamp, Error> {
    let n = lift(dt_parse_timestamp(text))?
    ok(identity(n))
}

/// An instant in RFC 3339 (UTC: `2026-10-16T10:30:00Z`).
pub fn rfc3339(ts: Timestamp) -> String { sure(dt_timestamp_text(identity(ts))) }

impl Display for Zoned {
    fn display(self: &Self) -> String { sure(dt_zoned_text(self)) }
}

impl Zoned {
    /// The instant.
    pub fn timestamp(self: &Self) -> Timestamp { identity(self.timestamp_nanos) }
    pub fn date(self: &Self) -> Date { self.datetime.date }
    pub fn time(self: &Self) -> Time { self.datetime.time }
    /// Calendar units by the wall clock (a day across a DST change is 23 or
    /// 25 hours); clock units as elapsed time.
    pub fn add(self: &Self, span: Span) -> Result<Zoned, Error> { lift(dt_zoned_add(self, span)) }
    /// The same instant in another zone.
    pub fn in_zone(self: &Self, zone: String) -> Result<Zoned, Error> { lift(dt_in_zone(self.timestamp_nanos, zone)) }
    /// Nanoseconds from this instant to `other`'s.
    pub fn nanos_until(self: &Self, other: Zoned) -> Int { other.timestamp_nanos - self.timestamp_nanos }
    pub fn compare(self: &Self, other: Zoned) -> Int { order([self.timestamp_nanos], [other.timestamp_nanos]) }
    /// `strftime` formatting (`%Y-%m-%d %H:%M %Z`).
    pub fn format(self: &Self, format: String) -> Result<String, Error> { lift(dt_format_zoned(format, self)) }
}
