// Validation rules: one place to state what a valid value is.
//
// A type's fields can carry their rules, which `check` reads:
//
// ```badger
// pub type NewBook = { @validate.not_blank @validate.max_len(200) title: String }
// validate.check(book)   // ok(book), or err of every broken rule
// ```
//
// Rules written as code pair a condition with the error it reports:
// `validate` returns the first violation; `validate_all` collects every
// violation, so a caller can report all the problems at once.
//
// ```badger
// validate(book, [
//     validate.rule(!text.is_empty(book.title), "title is required"),
//     validate.rule(book.title.len() <= 200, "title is too long"),
// ])
// ```

import std.list
import std.schema
import std.text

/// A rule: a condition and the error it reports when it fails.
pub type Rule<E> = (Bool, E)

/// A rule that holds when `condition` holds.
pub fn rule<E>(condition: Bool, error: E) -> Rule<E> { (condition, error) }

/// The value when every rule holds; the first failing rule's error
/// otherwise.
pub fn validate<T, E>(value: T, rules: List<Rule<E>>) -> Result<T, E> {
    for (holds, error) in rules {
        if !holds {
            return err(error)
        }
    }
    ok(value)
}

/// The value when every rule holds; every failing rule's error otherwise,
/// in rule order.
pub fn validate_all<T, E>(value: T, rules: List<Rule<E>>) -> Result<T, List<E>> {
    var errors: List<E> = list.empty()
    for (holds, error) in rules {
        if !holds {
            errors = errors.append(error)
        }
    }
    if errors.is_empty() {
        ok(value)
    } else {
        err(errors)
    }
}

// ---------------------------------------------------------------- common conditions

/// The text is not empty (nor only blanks).
pub fn not_blank(value: String) -> Bool { !text.is_blank(value) }

/// The text is at most `n` characters long.
pub fn at_most(value: String, n: Int) -> Bool { text.len(value) <= n }

/// The text is at least `n` characters long.
pub fn at_least(value: String, n: Int) -> Bool { text.len(value) >= n }

/// The number is in `low..=high`.
pub fn in_range(value: Int, low: Int, high: Int) -> Bool { value >= low && value <= high }

/// The number is greater than `low`.
pub fn greater_than(value: Int, low: Int) -> Bool { value > low }

/// The number is less than `high`.
pub fn less_than(value: Int, high: Int) -> Bool { value < high }

// ---------------------------------------------------------------- field rules

/// A field rule, read by `check`: the text is not empty (nor only blanks).
/// `pub type NewBook = { @validate.not_blank title: String }`
pub attribute not_blank on field: Codec {}

/// A field rule: the text has at least `length` characters.
pub attribute min_len on field: Codec { length: Int }

/// A field rule: the text has at most `length` characters.
pub attribute max_len on field: Codec { length: Int }

/// A field rule: the integer is at least `value`.
pub attribute min on field: Codec { value: Int }

/// A field rule: the integer is at most `value`.
pub attribute max on field: Codec { value: Int }

/// A field rule: the text is one of `values`.
pub attribute one_of on field: Codec { values: List<String> }

/// A rule a field breaks: the field's name and what is wrong.
pub type Violation = { field: String, message: String }

/// `value` when each of its fields keeps its rules (`@validate.not_blank`,
/// `@validate.max_len(200)`, ...); every broken rule otherwise, by field
/// name. The rules are those on the fields of `T` itself (a struct, or a
/// `type`'s record); an `Option` field left `none` keeps them all, and a
/// rule on a field of another kind (`max_len` on an `Int`) is broken.
pub fn check<T>(value: T) -> Result<T, List<Violation>> where T: Codec {
    let s = schema.of<T>().describe()
    let problems: ListBuilder<Violation> = list.builder()
    for (name, data) in schema.fields(value) {
        let broken = fn(message: String) { problems.append({ field: name, message: $"{name} {message}" }) }
        let txt = match data {
            .string(t) => Option.some(t),
            _ => Option.none,
        }
        let int = match data {
            .int(n) => Option.some(n),
            _ => Option.none,
        }
        let absent = match data {
            .null => true,
            _ => false,
        }
        if absent {
            continue
        }
        for u in not_blank.uses.filter(fn(u) => u.schema == s && u.target.name == name) {
            match txt {
                .some(t) => if text.is_blank(t) { broken("must not be blank") },
                .none => broken("is not text (`not_blank`)"),
            }
        }
        for u in min_len.uses.filter(fn(u) => u.schema == s && u.target.name == name) {
            match txt {
                .some(t) => if text.len(t) < u.value.length { broken($"has fewer than {u.value.length} characters") },
                .none => broken("is not text (`min_len`)"),
            }
        }
        for u in max_len.uses.filter(fn(u) => u.schema == s && u.target.name == name) {
            match txt {
                .some(t) => if text.len(t) > u.value.length { broken($"has more than {u.value.length} characters") },
                .none => broken("is not text (`max_len`)"),
            }
        }
        for u in min.uses.filter(fn(u) => u.schema == s && u.target.name == name) {
            match int {
                .some(n) => if n < u.value.value { broken($"is less than {u.value.value}") },
                .none => broken("is not an integer (`min`)"),
            }
        }
        for u in max.uses.filter(fn(u) => u.schema == s && u.target.name == name) {
            match int {
                .some(n) => if n > u.value.value { broken($"is more than {u.value.value}") },
                .none => broken("is not an integer (`max`)"),
            }
        }
        for u in one_of.uses.filter(fn(u) => u.schema == s && u.target.name == name) {
            match txt {
                .some(t) => if !u.value.values.contains(t) { broken($"is not one of {text.join(u.value.values, ", ")}") },
                .none => broken("is not text (`one_of`)"),
            }
        }
    }
    let all = problems.finish()
    if all.is_empty() { ok(value) } else { err(all) }
}

/// The violations as one line: each message, `; `-joined.
pub fn summary(violations: List<Violation>) -> String {
    text.join(violations.map(fn(v) => v.message), "; ")
}
