import std.endpoint
import std.route
import books

pub fn routes() -> List<route.Route> {
    [
        endpoint.bind({ method: #get, path: "/books", operation: books.list(), input: fn(_p: {}, _b: {}) { {} }, status: 200 }),
        endpoint.bind({ method: #get, path: "/books/:id", operation: books.find(), input: fn(p: { id: Int }, _b: {}) { p.id }, status: 200 }),
    ]
}
