pub type Note = { id: Int, text: String }

@derive(Error)
pub enum NoteError {
    missing(id: Int),
}

pub fn add(notes: List<Note>, text: String) -> List<Note> {
    notes.append({ id: notes.len() + 1, text })
}

pub fn find(notes: List<Note>, id: Int) -> Result<Note, NoteError> {
    for n in notes {
        if n.id == id {
            return ok(n)
        }
    }
    err(NoteError.missing(id))
}

fn test_add_and_find() -> Result<Unit, NoteError> {
    let ns = add(add([], "a"), "b")
    assert(find(ns, 2)?.text == "b")
    ok(())
}
