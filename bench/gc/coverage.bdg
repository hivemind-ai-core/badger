// Allocation, survival and pipeline shapes omitted by read-only microbenchmarks.
import std.array
import std.buffer
import std.channel
import std.codec
import std.env
import std.inspect
import std.io
import std.list
import std.map
import std.seq
import std.set
import std.task
import std.text
import std.time

type Config = { mode: String, n: Int, rounds: Int, payload: Int, retain: Int }

fn builders(c: Config) -> Int {
    var total = 0
    for _ in 0..c.rounds {
        if c.mode == "set-builder" {
            var b = set.builder<Int>()
            for i in 0..c.n { b.insert(i % c.retain) }
            let done = b.finish()
            total = total + done.len()
            for k in done {
                assert(k >= 0 && k < c.n.min(c.retain))
                total = total + k
            }
        } else if c.mode == "map-strings" {
            var b = map.builder<Int, String>()
            for i in 0..c.n { b.insert(i % c.retain, text.repeat("x", c.payload + i % 3)) }
            let done = b.finish()
            total = total + done.len()
            for (k, v) in done {
                assert(k >= 0 && k < c.n.min(c.retain))
                let last = c.n - 1 - (c.n - 1 - k) % c.retain
                assert(v.len() == c.payload + last % 3)
                total = total + k + v.len()
            }
        } else {
            var b = map.builder<Int, Int>()
            for i in 0..c.n { b.insert(i % c.retain, i) }
            let done = b.finish()
            total = total + done.len()
            for (k, v) in done {
                assert(k >= 0 && k < c.n.min(c.retain))
                assert(v == c.n - 1 - (c.n - 1 - k) % c.retain)
                total = total + k + v
            }
        }
    }
    total
}

fn must<T, E>(r: Result<T, E>) -> T {
    match r {
        .ok(v) => v,
        .err(_) => panic("message benchmark failed"),
    }
}

fn consume(c: Config, rx: channel.Receiver<Array<U64>>) -> Int {
    let retained = array.build(c.retain, fn(_: Int) { Cell.new(array.from_list([0U64])) })
    var count = 0
    var total = 0
    loop {
        match rx.recv() {
            .none => { break },
            .some(words) => {
                // Processing can suspend while the payload remains live.
                if c.mode == "messages-slow" { task.yield_now() }
                var index = 0
                for word in words {
                    assert(word == U64.try_from(count * 31 + index).unwrap_or(0U64))
                    total = total + Int.try_from(word).unwrap_or(0)
                    index = index + 1
                }
                assert(index == c.payload)
                if c.mode == "messages-retained" { retained[count % c.retain].set(words) }
                count = count + 1
            },
        }
    }
    assert(count == c.n)
    if c.mode == "messages-retained" {
        for slot in retained {
            for word in slot.get() { total = total + Int.try_from(word).unwrap_or(0) }
        }
    }
    total
}

fn messages(c: Config) -> Int {
    let a = must(channel.create<Array<U64>>({ ..channel.defaults, capacity: c.retain }))
    let b = must(channel.create<Array<U64>>({ ..channel.defaults, capacity: c.retain }))
    must(task.scope(fn(s) -> Result<Int, String> {
        let producer = s.spawn(fn() {
            for i in 0..c.n {
                let words = array.build(c.payload, fn(j: Int) { U64.try_from(i * 31 + j).unwrap_or(0U64) })
                let _ = must(a.sender.send(words))
                if c.mode == "messages-fanout" { let _ = must(b.sender.send(words)) }
            }
            a.sender.close()
            b.sender.close()
        })
        let consumer = s.spawn(fn() { consume(c, a.receiver) })
        let extra = if c.mode == "messages-fanout" { consume(c, b.receiver) } else { 0 }
        let total = consumer.join()
        producer.join()
        ok(total + extra)
    }))
}

// Same-width payload/control without a checked numeric conversion per word.
// Keep the U64 version above: it measures an important language-level cost too.
fn consume_int(c: Config, rx: channel.Receiver<Array<Int>>) -> Int {
    let retained = array.build(c.retain, fn(_: Int) { Cell.new(array.from_list([0])) })
    var count = 0
    var total = 0
    loop {
        match rx.recv() {
            .none => { break },
            .some(words) => {
                if c.mode == "messages-int-slow" { task.yield_now() }
                var index = 0
                for word in words {
                    assert(word == count * 31 + index)
                    total = total + word
                    index = index + 1
                }
                assert(index == c.payload)
                if c.mode == "messages-int-retained" { retained[count % c.retain].set(words) }
                count = count + 1
            },
        }
    }
    assert(count == c.n)
    if c.mode == "messages-int-retained" {
        for slot in retained { for word in slot.get() { total = total + word } }
    }
    total
}

fn messages_int(c: Config) -> Int {
    let a = must(channel.create<Array<Int>>({ ..channel.defaults, capacity: c.retain }))
    let b = must(channel.create<Array<Int>>({ ..channel.defaults, capacity: c.retain }))
    must(task.scope(fn(s) -> Result<Int, String> {
        let producer = s.spawn(fn() {
            for i in 0..c.n {
                let words = array.build(c.payload, fn(j: Int) { i * 31 + j })
                let _ = must(a.sender.send(words))
                if c.mode == "messages-int-fanout" { let _ = must(b.sender.send(words)) }
            }
            a.sender.close()
            b.sender.close()
        })
        let consumer = s.spawn(fn() { consume_int(c, a.receiver) })
        let extra = if c.mode == "messages-int-fanout" { consume_int(c, b.receiver) } else { 0 }
        let total = consumer.join()
        producer.join()
        ok(total + extra)
    }))
}

fn buffers(c: Config, narrow: Bool) -> Int {
    var total = 0
    if narrow {
        let retained = array.build(c.retain, fn(_: Int) { Cell.new(array.from_list([0U8])) })
        for i in 0..c.n {
            let value = U8.try_from(i % 251).unwrap_or(0U8)
            let a = array.build(c.payload, fn(_: Int) { value })
            total = total + Int.try_from(a.get(c.payload - 1).unwrap_or(0U8)).unwrap_or(0)
            retained[i % c.retain].set(a)
        }
        for a in retained { total = total + a.get().len() }
    } else {
        let retained = array.build(c.retain, fn(_: Int) { Cell.new(array.from_list([0U64])) })
        for i in 0..c.n {
            let value = U64.try_from(i % 251).unwrap_or(0U64)
            let a = array.build(c.payload, fn(_: Int) { value })
            total = total + Int.try_from(a.get(c.payload - 1).unwrap_or(0U64)).unwrap_or(0)
            retained[i % c.retain].set(a)
        }
        for a in retained { total = total + a.get().len() }
    }
    total
}

fn buffer_growth(c: Config) -> Int {
    let retained = array.build(c.retain, fn(_: Int) { Cell.new(array.empty<Int>()) })
    var total = 0
    for i in 0..c.n {
        let capacity = if c.mode == "buffers-capacity" { c.payload }
            else if c.mode == "buffers-capacity-grow" { c.payload / 2 } else { 0 }
        var b = buffer.with_capacity<Int>(capacity)
        for j in 0..c.payload { b.push(i * 31 + j) }
        let done = b.freeze()
        for word in done { total = total + word }
        retained[i % c.retain].set(done)
    }
    for slot in 0..c.n.min(c.retain) {
        let last = c.n - 1 - (c.n - 1 - slot) % c.retain
        let a = retained[slot].get()
        assert(a.len() == c.payload)
        for j in 0..c.payload {
            assert(a[j] == last * 31 + j)
            total = total + a[j]
        }
    }
    total
}

fn buffer_pointers(c: Config) -> Int {
    let retained = array.build(c.retain, fn(_: Int) { Cell.new(array.empty<String>()) })
    var total = 0
    for i in 0..c.n {
        let capacity = if c.mode == "buffers-capacity-pointers" { c.payload } else { 0 }
        var b = buffer.with_capacity<String>(capacity)
        for j in 0..c.payload {
            b.push(text.repeat(if i % 2 == 0 { "x" } else { "y" }, 32 + i % 3 + j))
        }
        let done = b.freeze()
        for value in done { total = total + value.len() }
        retained[i % c.retain].set(done)
    }
    for slot in 0..c.n.min(c.retain) {
        let last = c.n - 1 - (c.n - 1 - slot) % c.retain
        let a = retained[slot].get()
        assert(a.len() == c.payload)
        for j in 0..c.payload {
            assert(a[j] == text.repeat(if last % 2 == 0 { "x" } else { "y" }, 32 + last % 3 + j))
            total = total + a[j].len()
        }
    }
    total
}

fn empty_buffers(c: Config) -> Int {
    var total = 0
    for _ in 0..c.n {
        let a = array.empty<Int>()
        total = total + 1 + a.len()
    }
    total
}

fn snapshots(c: Config) -> Int {
    var current: Map<Int, String> = map.empty()
    let history = array.build(c.retain, fn(_: Int) { Cell.new(map.empty<Int, String>()) })
    let history_step = array.build(c.retain, fn(_: Int) { Cell.new(-1) })
    var total = 0
    for i in 0..c.n {
        current = current.insert(i % 1024, text.repeat("x", c.payload + i % 3))
        total = total + current.get(i % 1024).unwrap_or("").len()
        if i % 64 == 0 {
            history[(i / 64) % c.retain].set(current)
            history_step[(i / 64) % c.retain].set(i)
        }
    }
    for slot in 0..c.retain {
        let old = history[slot].get()
        total = total + old.len()
        if c.mode == "parallel-snapshots" {
            // Root lengths alone cannot catch prematurely freed descendants.
            // Read every retained string after the full churn phase.
            let at = history_step[slot].get()
            for (k, v) in old {
                assert(at >= 0 && k >= 0 && k <= at && k < 1024)
                let last = at - (at - k) % 1024
                assert(v == text.repeat("x", c.payload + last % 3))
            }
        }
    }
    total + current.len()
}

// Ordinary persistent updates, without string or numeric-conversion churn.
// Unlike the builder cases, each insert copies its path through the trie.
fn persistent_int(c: Config) -> Int {
    var current: Map<Int, Int> = map.empty()
    for i in 0..c.n { current = current.insert(i % c.retain, i) }
    assert(current.len() == c.n.min(c.retain))
    var total = current.len()
    for (k, v) in current {
        assert(k >= 0 && k < c.n.min(c.retain))
        assert(v == c.n - 1 - (c.n - 1 - k) % c.retain)
        total = total + k + v
    }
    total
}

// Eight fixed independent tasks keep allocation topology constant across worker
// sweeps. The ordinary map/snapshot cases above execute on one language task.
fn parallel_maps(c: Config) -> Int {
    must(task.scope(fn(s) -> Result<Int, String> {
        let jobs = array.build(c.rounds, fn(_: Int) {
            s.spawn(fn() {
                if c.mode == "parallel-persistent-int" { persistent_int(c) }
                else { snapshots(c) }
            })
        })
        var total = 0
        for job in jobs { total = total + job.join() }
        ok(total)
    }))
}

// Hold the whole burst first, then leave a sparse set of immutable survivors.
// Keeping just a rolling tail would miss chunks pinned by scattered objects.
fn pool_fill(c: Config) -> (Array<String>, Data, Int) {
    let values = array.build(c.n, fn(i: Int) {
        text.repeat(if i % 2 == 0 { "x" } else { "y" }, c.payload + i % 3)
    })
    var checksum = 0
    for value in values { checksum = checksum + value.len() }
    let survivors = array.build(c.retain, fn(slot: Int) { values[slot * c.n / c.retain] })
    (survivors, inspect.heap(), checksum)
}

fn pool_burst(c: Config) -> (Int, List<Data>) {
    let (survivors, burst, allocated) = pool_fill(c)
    // Force repeated ordinary collections, including majors, after the helper
    // frame holding the full burst has returned. No forced-GC benchmark API.
    let drained = persistent_int({ ..c, mode: "persistent-int", n: c.rounds, retain: 64 })
    let after_churn = inspect.heap()
    for _ in 0..32 { task.yield_now() }
    let idle = inspect.heap()
    var checksum = allocated + drained
    for slot in 0..c.retain {
        let at = slot * c.n / c.retain
        let expected = text.repeat(if at % 2 == 0 { "x" } else { "y" }, c.payload + at % 3)
        assert(survivors[slot] == expected)
        checksum = checksum + survivors[slot].len()
    }
    (checksum, [burst, after_churn, idle])
}

// Keep the scope and completed task records open during later allocation.
// Returned aliases are a positive retention control; consumed input graphs
// should stop rooting through the completed task once execution/cleanup ends.
fn task_payload_sum(values: Array<Int>) -> Int {
    var total = 0
    for value in values { total = total + value }
    total
}

fn task_retention(c: Config) -> (Int, List<Data>) {
    must(task.scope(fn(s) -> Result<(Int, List<Data>), String> {
        if c.mode == "tasks-result" {
            let jobs = array.build(c.n, fn(i: Int) {
                let values = array.build(c.payload, fn(j: Int) { i * 31 + j })
                s.spawn(fn() { values })
            })
            var total = 0
            for job in jobs { total = total + task_payload_sum(job.join()) }
            let done = inspect.heap()
            let drained = persistent_int({ ..c, mode: "persistent-int", n: c.rounds, retain: 64 })
            let churn = inspect.heap()
            for _ in 0..32 { task.yield_now() }
            let idle = inspect.heap()
            // The result can alias an input and must survive later collections.
            for job in jobs { total = total + task_payload_sum(job.join()) }
            ok((total + drained, [done, churn, idle]))
        } else {
            let jobs = array.build(c.n, fn(i: Int) {
                let values = array.build(c.payload, fn(j: Int) { i * 31 + j })
                s.spawn(fn() { task_payload_sum(values) })
            })
            var total = 0
            for job in jobs { total = total + job.join() }
            let done = inspect.heap()
            let drained = persistent_int({ ..c, mode: "persistent-int", n: c.rounds, retain: 64 })
            let churn = inspect.heap()
            for _ in 0..32 { task.yield_now() }
            ok((total + drained, [done, churn, inspect.heap()]))
        }
    }))
}

// Mixed hit/miss lookups include a negative index/key. Immediate results may
// split into tag/payload; stored Options must keep their ordinary boxed ABI.
fn lookup_int(c: Config) -> Int {
    var builder = map.builder<Int, Int>()
    for k in 0..c.retain { builder.insert(k, k * 31 + 7) }
    let values = builder.finish()
    var total = 0
    if c.mode == "lookup-map-stored" {
        let options = array.build(c.n, fn(i: Int) { values.get(i % (c.retain * 2) - 1) })
        var i = 0
        for value in options {
            let k = i % (c.retain * 2) - 1
            match value {
                .some(v) => {
                    assert(k >= 0 && k < c.retain && v == k * 31 + 7)
                    total = total + v
                },
                .none => { assert(k < 0 || k >= c.retain) },
            }
            i = i + 1
        }
        assert(i == c.n)
    } else {
        for i in 0..c.n {
            let k = i % (c.retain * 2) - 1
            let value = values.get(k)
            match value {
                .some(v) => {
                    assert(k >= 0 && k < c.retain && v == k * 31 + 7)
                    total = total + v
                },
                .none => { assert(k < 0 || k >= c.retain) },
            }
        }
    }
    total
}

fn lookup_array_int(c: Config) -> Int {
    let words = array.build(c.retain, fn(k: Int) { k * 31 + 7 })
    var total = 0
    for i in 0..c.n {
        let k = i % (c.retain * 2) - 1
        match words.get(k) {
            .some(v) => {
                assert(k >= 0 && k < c.retain && v == k * 31 + 7)
                total = total + v
            },
            .none => { assert(k < 0 || k >= c.retain) },
        }
    }
    total
}

fn lookup_map_pointers(c: Config) -> Int {
    let words = array.build(c.retain, fn(k: Int) { text.repeat("x", c.payload + k % 3) })
    var builder = map.builder<Int, String>()
    for k in 0..c.retain { builder.insert(k, words[k]) }
    let values = builder.finish()
    var total = 0
    for i in 0..c.n {
        let k = i % (c.retain * 2) - 1
        let value = values.get(k)
        match value {
            .some(v) => {
                assert(k >= 0 && k < c.retain)
                // Full byte comparison against prebuilt data, no new expected
                // String per lookup to hide Option allocation costs.
                assert(v == words[k])
                total = total + v.len()
            },
            .none => { assert(k < 0 || k >= c.retain) },
        }
    }
    total
}

fn lookup_list_pointers(c: Config) -> Int {
    let words = array.build(c.retain, fn(k: Int) { text.repeat("x", c.payload + k % 3) })
    let items = words.to_list()
    var total = 0
    for i in 0..c.n {
        let k = i % (c.retain * 2) - 1
        let value = items.get(k)
        match value {
            .some(v) => {
                assert(k >= 0 && k < c.retain)
                // Full byte comparison against prebuilt data, no new expected
                // String per lookup to hide Option allocation costs.
                assert(v == words[k])
                total = total + v.len()
            },
            .none => { assert(k < 0 || k >= c.retain) },
        }
    }
    total
}

// All misses: none is already shared, so this isolates split protocol overhead.
fn lookup_map_misses(c: Config) -> Int {
    var builder = map.builder<Int, Int>()
    for k in 0..c.retain { builder.insert(k, k * 31 + 7) }
    let values = builder.finish()
    var total = 0
    for i in 0..c.n {
        match values.get(c.retain + i % c.retain) {
            .some(v) => { assert(v < 0); total = total + v },
            .none => { total = total + 1 },
        }
    }
    total
}

// All misses: none is already shared, so this isolates split protocol overhead.
fn lookup_list_misses(c: Config) -> Int {
    let values = array.build(c.retain, fn(k: Int) { k * 31 + 7 }).to_list()
    var total = 0
    for i in 0..c.n {
        match values.get(c.retain + i % c.retain) {
            .some(v) => { assert(v < 0); total = total + v },
            .none => { total = total + 1 },
        }
    }
    total
}

fn pipeline(c: Config) -> Int {
    var total = 0
    for _ in 0..c.rounds {
        if c.mode == "visible" {
            total = total + seq.range(0, c.n).map(fn(x: Int) { x * 2 }).filter(fn(x: Int) { x % 3 == 0 }).fold(0, fn(a: Int, x: Int) { a + x })
        } else if c.mode == "stored" {
            let values = seq.range(0, c.n).map(fn(x: Int) { x * 2 }).filter(fn(x: Int) { x % 3 == 0 })
            total = total + values.fold(0, fn(a: Int, x: Int) { a + x })
        } else if c.mode == "collected" {
            let values = seq.range(0, c.n).map(fn(x: Int) { x * 2 }).filter(fn(x: Int) { x % 3 == 0 }).collect()
            total = total + values.fold(0, fn(a: Int, x: Int) { a + x })
        } else {
            let values = seq.range(0, c.n).collect().map(fn(x: Int) { x * 2 }).filter(fn(x: Int) { x % 3 == 0 })
            total = total + values.fold(0, fn(a: Int, x: Int) { a + x })
        }
    }
    total
}

pub fn main() -> Result<Unit, io.Error> {
    let c = match codec.decode_text<Config>(env.get("GC_BENCH_CONFIG").unwrap_or("")) {
        .ok(c) => c,
        .err(_) => panic("invalid GC_BENCH_CONFIG"),
    }
    assert(c.n > 0 && c.rounds > 0 && c.payload > 0 && c.retain > 0)
    let before = inspect.heap()
    let start = time.now()
    var checkpoints: List<Data> = []
    let checksum = if c.mode == "pool-burst" {
        let (total, shots) = pool_burst(c)
        checkpoints = shots
        total
    }
    else if c.mode.starts_with("tasks-") {
        let (total, shots) = task_retention(c)
        checkpoints = shots
        total
    }
    else if c.mode.starts_with("lookup-") {
        if c.mode == "lookup-map-misses" { lookup_map_misses(c) }
        else if c.mode == "lookup-list-misses" { lookup_list_misses(c) }
        else if c.mode == "lookup-map-pointers" { lookup_map_pointers(c) }
        else if c.mode == "lookup-list-pointers" { lookup_list_pointers(c) }
        else if c.mode == "lookup-array-int" { lookup_array_int(c) }
        else { lookup_int(c) }
    }
    else if c.mode == "buffers-empty" { empty_buffers(c) }
    else if c.mode == "buffers-grow" || c.mode == "buffers-capacity" || c.mode == "buffers-capacity-grow" { buffer_growth(c) }
    else if c.mode == "buffers-pointers" || c.mode == "buffers-capacity-pointers" { buffer_pointers(c) }
    else if c.mode == "bytes" { buffers(c, true) }
    else if c.mode == "words" { buffers(c, false) }
    else if c.mode == "snapshots" { snapshots(c) }
    else if c.mode == "persistent-int" { persistent_int(c) }
    else if c.mode.starts_with("parallel-") { parallel_maps(c) }
    else if c.mode.starts_with("map-") || c.mode == "set-builder" { builders(c) }
    else if c.mode.starts_with("messages-int") { messages_int(c) }
    else if c.mode.starts_with("messages") { messages(c) }
    else { pipeline(c) }
    let elapsed_ns = time.as_nanos(time.now() - start)
    let after = inspect.heap()
    io.println(codec.encode_text({ config: c, checksum, elapsed_ns, before, after, checkpoints }))?
    ok(())
}
