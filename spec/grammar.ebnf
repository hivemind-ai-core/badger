(* Draft-0 syntax skeleton. The compiler's implemented grammar is the parser in
   crates/badger_syntax/src/grammar.rs (a logos lexer and a chumsky parser).
   The prose syntax specification governs layout, precedence, lexical escapes,
   contextual construction, and static restrictions. NEWLINE is a statement
   boundary after applying the continuation rules in 01-syntax.md.
   { x } means repetition; [ x ] means optional; quoted strings are terminals. *)

program          = { separator | declaration } ;
declaration      = import_decl | type_decl | struct_decl | enum_decl
                 | protocol_decl | impl_decl | function_decl | provider_decl
                 | stage_decl | extern_decl
                 | global_binding ;
visibility       = [ "pub" ] ;
separator        = NEWLINE | ";" ;
value_name       = VALUE_IDENT | "system" | "pipeline" | "ref" | "map"
                 | "set" | "derive" | "repr" ;
type_name        = TYPE_IDENT ;
module_path      = value_name, { ".", value_name } ;
type_path        = [ module_path, "." ], type_name ;
value_path       = value_name, { ".", value_name } ;
generic_params   = "<", generic_param, { ",", generic_param }, [ "," ], ">" ;
generic_param    = type_name, [ ":", type_expr ] ;
type_args        = "<", type_expr, { ",", type_expr }, [ "," ], ">" ;
where_clause     = "where", constraint, { ",", constraint } ;
constraint       = type_expr, ":", type_expr, { "+", type_expr } ;

import_decl      = "import", module_path,
                   [ "as", value_name | ".", "{", import_item,
                     { ",", import_item }, [ "," ], "}" ], separator ;
import_item      = (value_name | type_name),
                   [ "as", (value_name | type_name) ] ;
type_decl        = visibility, "type", type_name, [ generic_params ],
                   "=", type_expr, separator ;
struct_decl      = visibility, [ "repr", "c" ], "struct", type_name,
                   [ generic_params ], "{", { struct_field }, "}", [ derives ] ;
struct_field     = visibility, value_name, ":", type_expr, [ "," ],
                   { NEWLINE } ;
enum_decl        = visibility, "enum", type_name, [ generic_params ],
                   "{", { enum_variant }, "}", [ derives ] ;
enum_variant     = value_name, [ "(", typed_params, ")" ], [ "," ],
                   { NEWLINE } ;
derives          = "derive", "(", type_path, { ",", type_path },
                   [ "," ], ")" ;
protocol_decl    = visibility, "protocol", type_name, [ generic_params ],
                   [ ":", type_expr, { "+", type_expr } ],
                   "{", { method_decl | type_decl | separator }, "}" ;
impl_decl        = "impl", [ generic_params ], type_expr, "for", type_expr,
                   [ where_clause ], "{", { method_decl | type_decl | separator }, "}" ;
method_decl      = { contract }, "fn", value_name, [ generic_params ], "(", typed_params,
                   ")", "->", type_expr, [ effect ], [ where_clause ],
                   ( block | separator ) ;
function_decl    = { contract }, visibility, "fn", value_name, [ generic_params ],
                   "(", params, ")", [ "->", type_expr ], [ effect ],
                   [ where_clause ], block ;
contract         = ( "requires" | "ensures" ), expr, [ ",", STRING ], separator ;
extern_decl      = visibility, "extern", STRING, "fn", value_name,
                   "(", typed_params, ")", "->", type_expr, separator ;
(* `provider`, `stage`, `enter`, `leave`, and `error` are keywords only here *)
provider_decl    = { contract }, visibility, "provider", value_name, [ "as", SYMBOL ],
                   "(", params, ")", [ "->", type_expr ], [ effect ], block ;
stage_decl       = { contract }, visibility, "stage", value_name, [ "as", SYMBOL ],
                   [ generic_params ], "(", params, ")", [ "->", type_expr ],
                   "{", { stage_callback | separator }, "}" ;
stage_callback   = ( "enter" | "leave" | "error" ), "(", params, ")",
                   [ "->", type_expr ], ( block | "=>", expr ) ;
global_binding   = [ "pub" ], ("let" | "const"), pattern,
                   [ ":", type_expr ], "=", expr, separator ;
params           = [ param, { ",", param }, [ "," ] ] ;
param            = pattern, [ ":", type_expr ] ;
typed_params     = [ typed_param, { ",", typed_param }, [ "," ] ] ;
typed_param      = pattern, ":", type_expr ;

type_expr        = "_" | type_path, [ type_args ] | record_type | tuple_type
                 | [ "once" ], "fn", "(", type_list, ")", "->", type_expr,
                   [ effect ]
                 | "for", generic_params, type_expr
                 | "&", [ "mut" ], type_expr
                 | "dyn", type_path, [ type_args ] ;
type_list        = [ type_expr, { ",", type_expr }, [ "," ] ] ;
record_type      = "{", [ type_fields, [ "," ], [ "..", type_name ]
                   | "..", type_name ], "}" ;
type_fields      = type_field, { ",", type_field } ;
type_field       = label, ":", type_expr ;
tuple_type       = "(", type_expr, ",", type_list, ")" ;
effect           = "!", (type_name | "{", type_list, "}") ;

block            = "{", { separator | statement, separator }, [ statement ], "}" ;
statement        = binding | assignment | use_stmt | return_stmt
                 | break_stmt | "continue" | expr ;
binding          = ("let" | "var" | "const"), pattern,
                   [ ":", type_expr ], "=", expr, [ "else", block ] ;
assignment       = place, "=", expr ;
place            = value_name, { ".", value_name | "[", expr, "]" } ;
use_stmt         = "use", pattern, { ",", pattern }, "<-", callable ;
callable         = value_path, [ type_args ], [ "(", arguments, ")" ] ;
return_stmt      = "return", [ expr ] ;
break_stmt       = "break", [ expr ] ;

(* expr is parsed with the precedence table; assignment is a statement only. *)
expr             = primary, { postfix | binary_op, primary } ;
primary          = literal | value_path | type_path
                 | "(", expr, ")" | tuple_literal | list_literal
                 | record_literal | map_literal | set_literal | lambda
                 | if_expr | match_expr | while_expr | for_expr | loop_expr
                 | system_expr | pipeline_expr | ref_expr | unsafe_expr | block
                 | unary_op, primary ;
postfix          = [ type_args ], "(", arguments, ")"
                 | ".", value_name | "[", expr, "]" | "?" ;
arguments        = [ expr, { ",", expr }, [ "," ] ] ;
tuple_literal    = "(", expr, ",", arguments, ")" ;
list_literal     = "[", arguments, "]" ;
record_literal   = "{", [ "..", expr, [ ",", record_entries ]
                   | record_entries ], [ "," ], "}" ;
record_entries   = record_entry, { ",", record_entry } ;
record_entry     = label_path, ":", expr | value_name ;
label            = value_name | "[", SYMBOL, "]" ;
label_path       = label, { ".", label } ;
map_literal      = "map", "{", [ map_entry, { ",", map_entry }, [ "," ] ], "}" ;
map_entry        = expr, "=>", expr ;
set_literal      = "set", "{", arguments, "}" ;
lambda           = [ "once" ], "fn", "(", params, ")",
                   [ "->", type_expr ], [ effect ], ( block | "=>", expr ) ;
condition        = expr | "let", pattern, "=", expr ;
if_expr          = "if", condition, block, [ "else", (block | if_expr) ] ;
match_expr       = "match", expr, "{", { match_arm }, "}" ;
match_arm        = pattern, [ "if", expr ], "=>", expr, [ "," ], { NEWLINE } ;
while_expr       = "while", condition, block ;
for_expr         = "for", pattern, "in", expr, block ;
loop_expr        = "loop", block ;
system_expr      = "system", "{", [ system_entry,
                   { ",", system_entry }, [ "," ] ], "}" ;
system_entry     = label, ":", expr ;   (* a provider application: provider(config), or component(provider, config) *)
pipeline_expr    = "pipeline", "{", [ expr, { ",", expr }, [ "," ] ], "}" ;
ref_expr         = "ref", "(", SYMBOL, ")" ;
unsafe_expr      = "unsafe", block ;

pattern          = "_" | value_name | literal | tuple_pattern | record_pattern
                 | variant_pattern ;
tuple_pattern    = "(", pattern, ",", pattern_list, ")" ;
pattern_list     = [ pattern, { ",", pattern }, [ "," ] ] ;
record_pattern   = "{", [ pattern_fields, [ "," ], [ ".." ] | ".." ], "}" ;
pattern_fields   = pattern_field, { ",", pattern_field } ;
pattern_field    = label, [ ":", pattern ] ;
variant_pattern  = [ type_path ], ".", value_name,
                   [ "(", pattern_list, ")" ] ;

literal          = NUMBER | DURATION | STRING | INTERPOLATED_STRING | CHAR
                 | SYMBOL | "true" | "false" | "(" , ")" ;
unary_op         = "-" | "!" | "&" | "&mut" ;
binary_op        = "*" | "/" | "%" | "+" | "-" | "<<" | ">>"
                 | "&" | "^" | "|" | ".." | "..=" | "==" | "!="
                 | "<" | "<=" | ">" | ">=" | "&&" | "||" | "|>" ;

(* Value-role declarations, pub signatures, ref placement, valid lvalues,
   irrefutable patterns, and system/pipeline forms have static constraints.
   A type_path in primary is legal only as the namespace of an associated
   constructor/function/constant; it is not itself a first-class value. *)
