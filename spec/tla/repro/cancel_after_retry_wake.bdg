// Finding F4 (spec/tla/README.md): a batch receiver woken to *retry* and
// then cancelled takes its wake with it, and the message it was woken for
// is stranded. One receiver is parked on a batch channel; a published
// message wakes it; it is cancelled before it runs, so the message it was
// woken for must be offered to another receiver.
//
// The program does not wait for a receiver to take the message (a receiver
// that takes it before the cancellation makes the message legitimately
// gone), so it reports what the channel holds afterwards: "taken" (the
// message reached a receiver) or "stranded" (it is still queued, with the
// only other receiver asleep).
import std.channel
import std.io
import std.task
import std.time

@derive(Error, From)
pub enum AppError {
    config(source: channel.ConfigError),
}

pub fn main() -> Result<Unit, AppError> {
    let b = channel.batch<Int>({ capacity: 4, max_batch: 2, byte_budget: 0 })?
    let r = task.scope(fn(s) -> Result<Unit, AppError> {
        let r1 = s.capture(fn() { b.receiver.recv().unwrap_or(0) })
        let r2 = s.capture(fn() { b.receiver.recv().unwrap_or(0) })
        task.sleep(time.millis(20))
        // one published message: it wakes the first parked receiver
        let _ = b.sender.append(1)
        let _ = b.sender.flush()
        // the woken receiver is cancelled before it runs
        r1.cancel()
        let _ = r1.join()
        // the second receiver must have been woken in its place
        task.sleep(time.millis(20))
        let left = match b.receiver.try_recv() {
            .value(v) => $"stranded {v}",
            .empty => "taken",
            .closed => "closed",
        }
        let _ = io.println(left)
        let _ = r2.cancel()
        let _ = r2.join()
        ok(())
    })
    let _ = r
    let _ = io.println("done")
    ok(())
}
